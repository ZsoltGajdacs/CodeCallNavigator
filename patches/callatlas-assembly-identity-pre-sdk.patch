diff --git a/src/CallAtlas.Core/AspNetAttributes.cs b/src/CallAtlas.Core/AspNetAttributes.cs
new file mode 100644
index 0000000..04b6183
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetAttributes.cs
@@ -0,0 +1,118 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal sealed record AspNetRouteSpec
+{
+    internal string? Template { get; init; }
+    internal bool UnknownPath { get; init; }
+    internal string[] Methods { get; init; } = [];
+    internal int? Order { get; init; }
+    internal bool OrderKnown { get; init; } = true;
+    internal bool IsHttp { get; init; }
+    internal bool Silent { get; init; }
+    internal string[] Restrictions { get; init; } = [];
+    internal AttributeData? Attribute { get; init; }
+}
+
+internal sealed class AspNetAttributes(AspNetContracts contracts)
+{
+    private static readonly string[] Verbs = ["Get", "Post", "Put", "Delete", "Patch", "Head", "Options"];
+
+    internal AspNetRouteSpec Parse(AttributeData attribute)
+    {
+        if (contracts.Is(attribute.AttributeClass, "Microsoft.AspNetCore.Mvc.RouteAttribute"))
+            return RequiredTemplate(attribute);
+        foreach (var verb in Verbs)
+        {
+            if (contracts.Is(attribute.AttributeClass, "Microsoft.AspNetCore.Mvc.Http" + verb + "Attribute"))
+                return HttpMethod(attribute, verb);
+        }
+        if (contracts.Is(attribute.AttributeClass, "Microsoft.AspNetCore.Mvc.AcceptVerbsAttribute"))
+            return AcceptVerbs(attribute);
+        return new AspNetRouteSpec { UnknownPath = true, OrderKnown = false, Attribute = attribute,
+            Restrictions = ["aspnet.custom-route-provider"] };
+    }
+
+    private static AspNetRouteSpec RequiredTemplate(AttributeData attribute)
+    {
+        var template = StringArgument(attribute);
+        return template is not null ? Known(attribute, template, []) : UnknownTemplate(attribute);
+    }
+
+    private static AspNetRouteSpec HttpMethod(AttributeData attribute, string verb)
+    {
+        var template = StringArgument(attribute);
+        if (template is null && attribute.ConstructorArguments.Length != 0) return UnknownTemplate(attribute);
+        return Known(attribute, template, [verb.ToUpperInvariant()], true);
+    }
+
+    private static AspNetRouteSpec UnknownTemplate(AttributeData attribute) => new()
+    {
+        UnknownPath = true, Attribute = attribute, Restrictions = ["aspnet.unknown-template"],
+    };
+
+    private static AspNetRouteSpec AcceptVerbs(AttributeData attribute)
+    {
+        var methods = AcceptedMethods(attribute);
+        var result = Known(attribute, NamedString(attribute, "Route"), methods, true);
+        return methods.Length != 0 && methods.All(ValidMethod) ? result
+            : result with { Methods = [], Restrictions = ["aspnet.unsupported-http-methods"] };
+    }
+
+    private static bool ValidMethod(string method) => method.Length != 0 && method.All(character => character is >= 'A' and <= 'Z');
+
+    private static AspNetRouteSpec Known(AttributeData attribute, string? template, string[] methods, bool isHttp = false)
+    {
+        var order = attribute.NamedArguments.FirstOrDefault(argument => argument.Key == "Order");
+        return new AspNetRouteSpec
+        {
+            Template = template, Methods = methods, IsHttp = isHttp, Attribute = attribute,
+            Order = order.Value.Value as int?,
+            OrderKnown = order.Key is null || order.Value.Value is int,
+            Silent = template is null && order.Key is null && NamedString(attribute, "Name") is null,
+        };
+    }
+
+    private static string? StringArgument(AttributeData attribute) => StringValue(attribute.ConstructorArguments.FirstOrDefault());
+
+    private static string? NamedString(AttributeData attribute, string name) =>
+        StringValue(attribute.NamedArguments.FirstOrDefault(argument => argument.Key == name).Value);
+
+    private static string? StringValue(TypedConstant value) => value.Kind == TypedConstantKind.Primitive ? value.Value as string : null;
+
+    private static string[] AcceptedMethods(AttributeData attribute)
+    {
+        var argument = attribute.ConstructorArguments.FirstOrDefault();
+        if (argument.IsNull) return [];
+        var values = argument.Kind == TypedConstantKind.Array ? argument.Values : [argument];
+        return values.Select(StringValue).OfType<string>()
+            .Select(value => value.ToUpperInvariant()).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
+    }
+
+    internal AspNetRouteSpec[] Effective(ISymbol symbol)
+    {
+        var chain = symbol is INamedTypeSymbol type ? AspNetContracts.Ancestors(type).Cast<ISymbol>()
+            : AspNetContracts.MethodChain((IMethodSymbol)symbol).Cast<ISymbol>();
+        foreach (var current in chain)
+        {
+            var routes = current.GetAttributes().Where(contracts.RouteProvider).Select(Parse).ToArray();
+            if (routes.Length != 0) return routes;
+        }
+        return [];
+    }
+
+    internal static AspNetRouteSpec[] Selectors(AspNetRouteSpec[] routes)
+    {
+        var silent = routes.Where(route => route.Silent).ToArray();
+        var selectors = routes.Where(route => !route.Silent).Select(route => route.IsHttp ? route
+            : route with { Methods = silent.SelectMany(item => item.Methods).Distinct().Order().ToArray() }).ToList();
+        if (NeedsSilentSelector(routes, silent))
+            selectors.Add(new AspNetRouteSpec { Methods = silent.SelectMany(route => route.Methods).Distinct().Order().ToArray(),
+                Attribute = silent.FirstOrDefault()?.Attribute });
+        return selectors.ToArray();
+    }
+
+    private static bool NeedsSilentSelector(AspNetRouteSpec[] routes, AspNetRouteSpec[] silent) =>
+        routes.Length == 0 || silent.Length != 0 && routes.Where(route => !route.Silent).All(route => route.IsHttp);
+}
diff --git a/src/CallAtlas.Core/AspNetAwaiterResults.cs b/src/CallAtlas.Core/AspNetAwaiterResults.cs
