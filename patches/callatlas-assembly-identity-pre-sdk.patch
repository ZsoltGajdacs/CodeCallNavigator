@@ -0,0 +1,28 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+/// <summary>Potential public awaiter results are inspected as symbols, never evaluated.</summary>
+internal static class AspNetAwaiterResults
+{
+    internal static IEnumerable<INamedTypeSymbol> Results(INamedTypeSymbol type) =>
+        Methods(type, "GetAwaiter").Select(method => method.ReturnType).OfType<INamedTypeSymbol>()
+            .Where(HasCompletion).SelectMany(awaiter => Methods(awaiter, "GetResult")
+                .Select(method => method.ReturnType)).OfType<INamedTypeSymbol>();
+
+    private static IEnumerable<IMethodSymbol> Methods(INamedTypeSymbol type, string name) =>
+        AspNetContracts.Ancestors(type).SelectMany(owner => owner.GetMembers(name))
+            .OfType<IMethodSymbol>().Where(ParameterlessInstance);
+
+    private static bool ParameterlessInstance(IMethodSymbol method) =>
+        method.DeclaredAccessibility == Accessibility.Public && !method.IsStatic
+        && !method.IsGenericMethod && method.Parameters.Length == 0;
+
+    private static bool HasCompletion(INamedTypeSymbol type) =>
+        AspNetContracts.Ancestors(type).SelectMany(owner => owner.GetMembers("IsCompleted"))
+            .OfType<IPropertySymbol>().Any(CompletionProperty);
+
+    private static bool CompletionProperty(IPropertySymbol property) =>
+        property.Type.SpecialType == SpecialType.System_Boolean && !property.IsStatic
+        && !property.IsIndexer && property.GetMethod?.DeclaredAccessibility == Accessibility.Public;
+}
