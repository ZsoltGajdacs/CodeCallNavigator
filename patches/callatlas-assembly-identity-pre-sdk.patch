+using System.Text.RegularExpressions;
+
+namespace CallAtlas.Core;
+
+internal static class AspNetTemplates
+{
+    private static readonly Regex Literal = new(@"^[A-Za-z0-9._~-]+$", RegexOptions.CultureInvariant);
+    private static readonly Regex Parameter = new(@"^\{[A-Za-z_][A-Za-z0-9_]*\}$", RegexOptions.CultureInvariant);
+
+    internal static bool Rooted(string? template) => template is not null
+        && (template.StartsWith('/') || template.StartsWith("~/", StringComparison.Ordinal));
+
+    internal static string? Combine(AspNetRouteSpec prefix, AspNetRouteSpec action)
+    {
+        if (action.UnknownPath) return null;
+        if (Rooted(action.Template)) return Normalize(action.Template!);
+        if (prefix.UnknownPath) return null;
+        if (prefix.Template is null && action.Template is null) return null;
+        return Normalize(string.Join("/", new[] { prefix.Template, action.Template }
+            .Where(template => !string.IsNullOrEmpty(template))));
+    }
+
+    private static string Normalize(string template)
+    {
+        var value = template.StartsWith("~/", StringComparison.Ordinal) ? template[2..] : template;
+        return "/" + value.Trim('/');
+    }
+
+    internal static bool Supported(string path) => path == "/" || path.Split('/').Skip(1).All(SupportedSegment);
+
+    private static bool SupportedSegment(string segment) =>
+        Parameter.IsMatch(segment) || SafeLiteral(segment);
+
+    private static bool SafeLiteral(string segment) => Literal.IsMatch(segment) && segment is not "." and not "..";
+}
