@@ -0,0 +1,70 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.CodeAnalysis.Operations;
+
+namespace CallAtlas.Core;
+
+internal static class MediatRContracts
+{
+    internal static string StableType(ITypeSymbol type) => MediatRTypes.Stable(type);
+    internal static string TypeKey(ITypeSymbol type) => MediatRTypes.Key(type);
+    internal static bool IsClosed(ITypeSymbol type) => MediatRTypes.IsClosed(type);
+
+    internal static INamedTypeSymbol? FrameworkType(Compilation compilation, string metadataName)
+    {
+        var symbol = compilation.GetTypeByMetadataName(metadataName);
+        return symbol is not null && symbol.ContainingAssembly.Identity.Name == "MediatR"
+            && symbol.Locations.All(location => !location.IsInSource) ? symbol : null;
+    }
+
+    internal static bool HasFrameworkContracts(Compilation compilation) =>
+        FrameworkType(compilation, "MediatR.ISender") is not null
+        || FrameworkType(compilation, "MediatR.IPublisher") is not null;
+
+    internal static string? DispatchKind(IInvocationOperation invocation, Compilation compilation)
+    {
+        var method = invocation.TargetMethod.OriginalDefinition;
+        var metadata = method.Name switch
+        {
+            "Send" => "MediatR.ISender",
+            "Publish" => "MediatR.IPublisher",
+            _ => null,
+        };
+        if (metadata is null) return null;
+        var contract = FrameworkType(compilation, metadata);
+        return contract is not null && contract.GetMembers(method.Name).OfType<IMethodSymbol>()
+            .Any(candidate => SymbolEqualityComparer.Default.Equals(candidate.OriginalDefinition, method))
+            ? method.Name.ToLowerInvariant() : null;
+    }
+
+    internal static INamedTypeSymbol? Payload(IInvocationOperation invocation)
+    {
+        IOperation? value = invocation.Arguments.FirstOrDefault(argument => argument.Parameter?.Ordinal == 0)?.Value;
+        while (value is IConversionOperation { IsImplicit: true, OperatorMethod: null } conversion)
+            value = conversion.Operand;
+        if (value?.Type is not INamedTypeSymbol type) return null;
+        if (!IsPayloadType(type)) return null;
+        return value is IObjectCreationOperation || type.IsSealed || type.IsValueType ? type : null;
+    }
+
+    private static bool IsPayloadType(INamedTypeSymbol type) => IsClosed(type)
+        && type.TypeKind is not (TypeKind.Interface or TypeKind.Delegate)
+        && type.SpecialType != SpecialType.System_Object;
+
+    internal static HashSet<string> VisibleAssemblies(Compilation compilation) =>
+        compilation.SourceModule.ReferencedAssemblySymbols.Select(assembly => assembly.Identity.ToString())
+            .Append(compilation.Assembly.Identity.ToString()).ToHashSet(StringComparer.Ordinal);
+
+    internal static string? HandlerKind(Compilation compilation, INamedTypeSymbol contract)
+    {
+        foreach (var (name, dispatch) in new[] {
+                     ("MediatR.IRequestHandler`1", "send"), ("MediatR.IRequestHandler`2", "send"),
+                     ("MediatR.INotificationHandler`1", "publish") })
+        {
+            var expected = FrameworkType(compilation, name);
+            if (expected is not null && SymbolEqualityComparer.Default.Equals(expected, contract.OriginalDefinition))
+                return dispatch;
+        }
+        return null;
+    }
+}
