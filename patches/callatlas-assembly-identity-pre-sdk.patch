--- /dev/null
+++ b/src/CallAtlas.Core/AspNetModelConventions.cs
@@ -0,0 +1,25 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+// Mirrors default MVC attribute convention scopes. Configured global conventions are not evaluated.
+internal sealed class AspNetModelConventions(AspNetContracts contracts)
+{
+    internal bool Applies(INamedTypeSymbol controller, IMethodSymbol action) =>
+        Has(controller, "IControllerModelConvention")
+        || Has(action, "IActionModelConvention")
+        || action.Parameters.Any(ParameterConvention)
+        || AspNetContracts.Ancestors(controller).SelectMany(type => type.GetMembers())
+            .OfType<IPropertySymbol>().Any(PropertyConvention);
+
+    private bool ParameterConvention(IParameterSymbol parameter) =>
+        Has(parameter, "IParameterModelConvention") || Has(parameter, "IParameterModelBaseConvention");
+
+    private bool PropertyConvention(IPropertySymbol property) =>
+        property.DeclaredAccessibility == Accessibility.Public && !property.IsStatic
+        && Has(property, "IParameterModelBaseConvention");
+
+    private bool Has(ISymbol owner, string convention) =>
+        AspNetContracts.Attributes(owner).Any(attribute => contracts.Implements(attribute.AttributeClass,
+            "Microsoft.AspNetCore.Mvc.ApplicationModels." + convention));
+}
diff --git a/src/CallAtlas.Core/AspNetRouteBuilder.cs b/src/CallAtlas.Core/AspNetRouteBuilder.cs
new file mode 100644
index 0000000..ace8502
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetRouteBuilder.cs
@@ -0,0 +1,62 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal sealed class AspNetRouteBuilder(AspNetContracts contracts, IReadOnlySet<string> nodes)
+{
+    private readonly AspNetConstraints constraints = new(contracts);
+
+    internal HttpRouteFact? Build(INamedTypeSymbol controller, IMethodSymbol method,
+        AspNetRouteSpec prefix, AspNetRouteSpec selector)
+    {
+        var selection = new AspNetRouteSelection(prefix, selector, constraints.DynamicEndpoint(controller, method));
+        if (!selection.Attributed) return null;
+        var action = new ControllerAction(controller, method);
+        var restrictions = selection.Restrictions();
+        restrictions.AddRange(ActionRestrictions(action));
+        var symbol = NativeSymbol(method, restrictions);
+        var methods = Methods(action, selection, restrictions);
+        return new HttpRouteFact
+        {
+            Symbol = symbol, Application = controller.ContainingAssembly.Identity.Name,
+            Path = selection.Path, Methods = methods, Order = selection.Order,
+            Restrictions = restrictions.Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray(),
+            Site = Site(selector.Attribute ?? prefix.Attribute, action),
+        };
+    }
+
+    private string? NativeSymbol(IMethodSymbol action, List<string> restrictions)
+    {
+        var symbol = SymbolId.Canonical(action);
+        if (nodes.Contains(symbol)) return symbol;
+        restrictions.Add("aspnet.missing-native-action");
+        return null;
+    }
+
+    private List<string> ActionRestrictions(ControllerAction action)
+    {
+        var result = constraints.Restrictions(action.Controller, action.Method).ToList();
+        if (!contracts.Derives(action.Controller, "Microsoft.AspNetCore.Mvc.ControllerBase")) result.Add("aspnet.non-controllerbase");
+        if (!SymbolEqualityComparer.Default.Equals(action.Method.ContainingType, action.Controller)) result.Add("aspnet.inherited-action");
+        return result;
+    }
+
+    private string[] Methods(ControllerAction action, AspNetRouteSelection selection, List<string> restrictions)
+    {
+        if (!constraints.UnknownMethods(action.Controller, action.Method)) return selection.Selector.Methods;
+        restrictions.Add("aspnet.custom-http-method-provider");
+        return [];
+    }
+
+    private static HttpRouteSite Site(AttributeData? attribute, ControllerAction action)
+    {
+        var syntax = attribute?.ApplicationSyntaxReference?.GetSyntax()
+            ?? action.Method.DeclaringSyntaxReferences.FirstOrDefault()?.GetSyntax()
+            ?? action.Controller.DeclaringSyntaxReferences.First().GetSyntax();
+        var position = syntax.SyntaxTree.GetLineSpan(syntax.Span).StartLinePosition;
+        return new HttpRouteSite(Path.GetFullPath(syntax.SyntaxTree.FilePath).Replace('\\', '/'),
+            position.Line + 1, position.Character + 1);
+    }
+
+    private sealed record ControllerAction(INamedTypeSymbol Controller, IMethodSymbol Method);
+}
diff --git a/src/CallAtlas.Core/AspNetRouteInference.cs b/src/CallAtlas.Core/AspNetRouteInference.cs
new file mode 100644
index 0000000..a94eef5
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetRouteInference.cs
@@ -0,0 +1,67 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed class AspNetRouteInference
+{
+    private readonly AspNetContracts contracts;
+    private readonly AspNetEligibility eligibility;
+    private readonly AspNetAttributes attributes;
+    private readonly AspNetRouteBuilder builder;
+    private readonly List<HttpRouteFact> routes = [];
+
+    private AspNetRouteInference(Compilation compilation, IReadOnlySet<string> nodes)
+    {
+        contracts = new AspNetContracts(compilation);
+        eligibility = new AspNetEligibility(contracts, compilation);
+        attributes = new AspNetAttributes(contracts);
+        builder = new AspNetRouteBuilder(contracts, nodes);
+    }
+
+    internal static IReadOnlyList<HttpRouteFact> Analyze(
+        IReadOnlyList<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units,
+        IReadOnlySet<string> nodes)
+    {
+        var routes = new List<HttpRouteFact>();
+        foreach (var group in units.GroupBy(unit => unit.Compilation))
+        {
+            var analysis = new AspNetRouteInference(group.Key, nodes);
+            if (analysis.contracts.Type("Microsoft.AspNetCore.Mvc.ControllerBase") is null) continue;
+            analysis.Collect(group);
+            routes.AddRange(analysis.routes);
+        }
+        return routes.OrderBy(route => route.Application, StringComparer.Ordinal)
+            .ThenBy(route => route.Path, StringComparer.Ordinal).ThenBy(route => route.Symbol, StringComparer.Ordinal)
+            .ThenBy(route => route.Site.File, StringComparer.Ordinal).ThenBy(route => route.Site.Line).ToArray();
+    }
+
+    private void Collect(IEnumerable<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units)
+    {
+        var seen = new HashSet<INamedTypeSymbol>(SymbolEqualityComparer.Default);
+        foreach (var (tree, model, _) in units)
+        foreach (var type in tree.GetRoot().DescendantNodes().OfType<BaseTypeDeclarationSyntax>()
+                     .Select(node => model.GetDeclaredSymbol(node)).OfType<INamedTypeSymbol>().Where(eligibility.Controller))
+        {
+            if (seen.Add(type)) Controller(type);
+        }
+    }
+
+    private void Controller(INamedTypeSymbol type)
+    {
+        var prefixes = attributes.Effective(type);
+        if (prefixes.Length == 0) prefixes = [new AspNetRouteSpec()];
+        foreach (var owner in AspNetContracts.Ancestors(type).TakeWhile(owner => owner.SpecialType != SpecialType.System_Object))
+        foreach (var action in owner.GetMembers().OfType<IMethodSymbol>().Where(eligibility.Action))
+            Action(type, action, prefixes);
+    }
+
+    private void Action(INamedTypeSymbol controller, IMethodSymbol action, AspNetRouteSpec[] prefixes)
+    {
+        foreach (var selector in AspNetAttributes.Selectors(attributes.Effective(action)))
+        {
+            var parents = AspNetTemplates.Rooted(selector.Template) ? [new AspNetRouteSpec()] : prefixes;
+            routes.AddRange(parents.Select(prefix => builder.Build(controller, action, prefix, selector)).OfType<HttpRouteFact>());
+        }
+    }
+}
diff --git a/src/CallAtlas.Core/AspNetRouteSelection.cs b/src/CallAtlas.Core/AspNetRouteSelection.cs
new file mode 100644
index 0000000..4ec78ec
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetRouteSelection.cs
@@ -0,0 +1,24 @@
+namespace CallAtlas.Core;
+
+internal sealed class AspNetRouteSelection(AspNetRouteSpec prefix, AspNetRouteSpec selector, bool dynamicMetadata = false)
+{
+    internal AspNetRouteSpec Prefix { get; } = prefix;
+    internal AspNetRouteSpec Selector { get; } = selector;
+    private string? DeclaredPath { get; } = AspNetTemplates.Combine(prefix, selector);
+    internal string? Path => dynamicMetadata ? null : DeclaredPath;
+    internal bool Attributed => DeclaredPath is not null || Prefix.UnknownPath || Selector.UnknownPath;
+    private bool KnownOrder => !dynamicMetadata && Prefix.OrderKnown && Selector.OrderKnown;
+    internal int? Order => KnownOrder ? Selector.Order ?? Prefix.Order ?? 0 : null;
+    private bool UnsupportedTemplate => UnsupportedPath || DoubleSeparator(Prefix.Template) || DoubleSeparator(Selector.Template);
+    private bool UnsupportedPath => DeclaredPath is not null && !AspNetTemplates.Supported(DeclaredPath);
+    private static bool DoubleSeparator(string? template) => template?.Contains("//", StringComparison.Ordinal) == true;
+
+    internal List<string> Restrictions()
+    {
+        var result = Prefix.Restrictions.Concat(Selector.Restrictions).ToList();
+        if (UnsupportedTemplate) result.Add("aspnet.unsupported-template");
+        if (!KnownOrder) result.Add("aspnet.unknown-order");
+        if (Order.GetValueOrDefault() != 0) result.Add("aspnet.nondefault-order");
+        return result;
+    }
+}
