+/// <summary>Compiler declaration facts for file classification; independent of graph inclusion.</summary>
+public sealed record ArchitectureFileFacts
+{
+    public string Assembly { get; init; } = "";
+    public string File { get; init; } = "";
+    public string Content { get; init; } = "";
+    public IReadOnlyList<string> Namespaces { get; init; } = [];
+    public IReadOnlyList<string> Names { get; init; } = [];
+    public IReadOnlyList<string> Kinds { get; init; } = [];
+    public IReadOnlyList<string> Annotations { get; init; } = [];
+    public IReadOnlyList<string> MethodAnnotations { get; init; } = [];
+    public IReadOnlyList<string> BaseTypes { get; init; } = [];
+    public IReadOnlyList<string> AnnotatedInterfaces { get; init; } = [];
+    public bool IsInterface { get; init; }
+
+    public static ArchitectureFileFacts From(SyntaxTree tree, SemanticModel model)
+    {
+        var declarations = tree.GetRoot().DescendantNodes().ToArray();
+        var types = declarations.Where(node => node is BaseTypeDeclarationSyntax or DelegateDeclarationSyntax)
+            .Select(node => model.GetDeclaredSymbol(node)).OfType<INamedTypeSymbol>().ToArray();
+        var methods = declarations.Where(node => node is BaseMethodDeclarationSyntax
+                or LocalFunctionStatementSyntax or AccessorDeclarationSyntax)
+            .Select(node => model.GetDeclaredSymbol(node)).OfType<IMethodSymbol>().ToArray();
+        return new ArchitectureFileFacts
+        {
+            Assembly = model.Compilation.AssemblyName ?? "",
+            File = tree.FilePath.Replace('\\', '/'),
+            Content = tree.GetText().ToString(),
+            Namespaces = Sorted(types.Select(type => type.ContainingNamespace.ToDisplayString())),
+            Names = Sorted(types.SelectMany(NamesOf)),
+            Kinds = Sorted(types.Select(type => type.IsRecord ? "record" : type.TypeKind.ToString().ToLowerInvariant())),
+            Annotations = Sorted(types.SelectMany(Attributes)),
+            MethodAnnotations = Sorted(methods.SelectMany(Attributes)),
+            BaseTypes = Sorted(types.SelectMany(Ancestors).SelectMany(NamesOf)),
+            AnnotatedInterfaces = Sorted(types.SelectMany(type => type.AllInterfaces).SelectMany(Attributes)),
+            IsInterface = types.Any(type => type.TypeKind == TypeKind.Interface),
+        };
+    }
+
+    private static IEnumerable<string> NamesOf(INamedTypeSymbol type) =>
+        new[] { type.Name, type.ToDisplayString(SymbolDisplayFormat.CSharpErrorMessageFormat) };
+
+    private static IEnumerable<string> Attributes(ISymbol symbol) => symbol.GetAttributes()
+        .Select(attribute => attribute.AttributeClass).OfType<INamedTypeSymbol>().SelectMany(NamesOf);
+
+    private static IEnumerable<INamedTypeSymbol> Ancestors(INamedTypeSymbol type)
+    {
+        for (var parent = type.BaseType; parent is not null; parent = parent.BaseType)
+            yield return parent;
+        foreach (var parent in type.AllInterfaces) yield return parent;
+    }
+
+    private static string[] Sorted(IEnumerable<string> values) => values.Where(value => value.Length > 0)
+        .Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
+}
