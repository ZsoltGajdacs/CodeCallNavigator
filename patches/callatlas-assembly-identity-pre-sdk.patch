+using CallAtlas.Core;
+using Xunit;
+
+namespace CallAtlas.Tests;
+
+public class HttpRouteFactsTests
+{
+    [Fact]
+    public void Http_snapshot_roundtrip_preserves_unsupported_route_and_owner()
+    {
+        var original = CallGraphBuilder.Build([("a.cs", "class A { void Run() {} }")], root: "/proj") with
+        {
+            HttpFactsVersion = "1",
+            HttpRoutes = [new HttpRouteFact
+            {
+                Symbol = "handler", Application = "ApplicationA", Path = "/api/{id:int}",
+                Methods = ["GET"], Site = new HttpRouteSite("a.cs", 2, 3),
+                Restrictions = ["aspnet.unsupported-template"], Order = null,
+            }],
+        };
+        var read = CodeMapJson.Read(CodeMapJson.Write(original));
+        Assert.Equal("1", read.HttpFactsVersion);
+        var route = Assert.Single(read.HttpRoutes);
+        Assert.Equal("handler", route.Symbol);
+        Assert.Equal("ApplicationA", route.Application);
+        Assert.Equal("/api/{id:int}", route.Path);
+        Assert.Equal(["GET"], route.Methods);
+        Assert.Equal(["aspnet.unsupported-template"], route.Restrictions);
+        Assert.Equal(new HttpRouteSite("a.cs", 2, 3), route.Site);
+        Assert.Null(route.Order);
+    }
+
+    [Fact]
+    public void Historical_snapshot_does_not_claim_current_http_capability()
+    {
+        var historical = CodeMapJson.Read("""{"schema":"callatlas.ir.v3","nodes":[],"edges":[]}""");
+        var read = CodeMapJson.Read(CodeMapJson.Write(historical));
+        Assert.Equal("", read.HttpFactsVersion);
+        Assert.Empty(read.HttpRoutes);
+    }
+
+    [Theory]
+    [InlineData("""{"schema":"callatlas.ir.v3","httpFactsVersion":"2","httpRoutes":[]}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","httpFactsVersion":"1"}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","httpFactsVersion":"1","httpRoutes":null}""")]
+    public void Incompatible_or_incomplete_http_capability_is_rejected(string json) =>
+        Assert.Throws<CallAtlasException>(() => CodeMapJson.Read(json));
+}
