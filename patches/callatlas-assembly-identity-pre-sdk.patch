+    private static readonly JsonSerializerOptions Options = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
+
+    internal static void Write(Utf8JsonWriter writer, CodeMap map)
+    {
+        writer.WriteString("httpFactsVersion", map.HttpFactsVersion);
+        writer.WritePropertyName("httpRoutes");
+        JsonSerializer.Serialize(writer, map.HttpRoutes, Options);
+    }
+
+    internal static HttpRouteSnapshot Read(JsonElement root)
+    {
+        var version = root.TryGetProperty("httpFactsVersion", out var property) ? property.GetString() ?? "" : "";
+        if (version.Length != 0 && version != HttpRouteFact.Version)
+            throw new CallAtlasException($"Unsupported HTTP facts version '{version}'; regenerate the snapshot.");
+        if (!root.TryGetProperty("httpRoutes", out var routes))
+        {
+            if (version == HttpRouteFact.Version) throw new CallAtlasException("Missing HTTP routes; regenerate the snapshot.");
+            return new HttpRouteSnapshot(version, []);
+        }
+        if (routes.ValueKind != JsonValueKind.Array) throw new CallAtlasException("Invalid HTTP routes; regenerate the snapshot.");
+        return new HttpRouteSnapshot(version,
+            JsonSerializer.Deserialize<HttpRouteFact[]>(routes.GetRawText(), Options) ?? []);
+    }
+}
+
+internal sealed record HttpRouteSnapshot(string Version, HttpRouteFact[] Routes);
