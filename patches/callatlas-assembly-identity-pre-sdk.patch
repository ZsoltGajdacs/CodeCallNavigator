@@ -0,0 +1,61 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal sealed class AspNetConstraints(AspNetContracts contracts)
+{
+    internal string[] Restrictions(INamedTypeSymbol controller, IMethodSymbol action)
+    {
+        var result = new List<string>();
+        if (Attributes(controller, action).Any(RequestConstraint)) result.Add("aspnet.request-constraints");
+        if (ReturnMetadata(action.ReturnType)) result.Add("aspnet.return-endpoint-metadata");
+        if (action.Parameters.Any(ParameterMetadata)) result.Add("aspnet.parameter-endpoint-metadata");
+        if (ModelConventions(controller, action)) result.Add("aspnet.model-convention");
+        return result.ToArray();
+    }
+
+    internal bool UnknownMethods(INamedTypeSymbol controller, IMethodSymbol action) =>
+        Attributes(controller, action).Any(UnknownMethodProvider) || DynamicEndpoint(controller, action);
+
+    internal bool DynamicEndpoint(INamedTypeSymbol controller, IMethodSymbol action) =>
+        ReturnMetadata(action.ReturnType) || action.Parameters.Any(ParameterMetadata) || ModelConventions(controller, action);
+
+    private bool ModelConventions(INamedTypeSymbol controller, IMethodSymbol action) =>
+        new AspNetModelConventions(contracts).Applies(controller, action);
+
+    private static IEnumerable<AttributeData> Attributes(INamedTypeSymbol controller, IMethodSymbol action) =>
+        AspNetContracts.Attributes(controller).Concat(AspNetContracts.Attributes(action));
+
+    private bool RequestConstraint(AttributeData attribute) =>
+        contracts.Implements(attribute.AttributeClass, "Microsoft.AspNetCore.Mvc.ActionConstraints.IActionConstraintMetadata")
+        || contracts.Implements(attribute.AttributeClass, "Microsoft.AspNetCore.Routing.IHostMetadata")
+        || contracts.Implements(attribute.AttributeClass, "Microsoft.AspNetCore.Routing.ISuppressMatchingMetadata")
+        || EndpointMethods(attribute.AttributeClass);
+
+    private bool UnknownMethodProvider(AttributeData attribute) =>
+        EndpointMethods(attribute.AttributeClass) || CustomActionMethods(attribute.AttributeClass);
+
+    private bool EndpointMethods(INamedTypeSymbol? type) =>
+        contracts.Implements(type, "Microsoft.AspNetCore.Routing.IHttpMethodMetadata");
+
+    private bool CustomActionMethods(INamedTypeSymbol? type) =>
+        contracts.Implements(type, "Microsoft.AspNetCore.Mvc.Routing.IActionHttpMethodProvider") && !KnownMethodProvider(type);
+
+    private bool ReturnMetadata(ITypeSymbol type)
+    {
+        if (type is not INamedTypeSymbol named) return false;
+        var effective = contracts.TaskResult(named) ?? named;
+        return MetadataProvider(effective as INamedTypeSymbol) || AspNetAwaiterResults.Results(named).Any(MetadataProvider);
+    }
+
+    private bool MetadataProvider(INamedTypeSymbol? type) =>
+        contracts.Implements(type, "Microsoft.AspNetCore.Http.Metadata.IEndpointMetadataProvider");
+
+    private bool ParameterMetadata(IParameterSymbol parameter) =>
+        contracts.Implements(parameter.Type as INamedTypeSymbol, "Microsoft.AspNetCore.Http.Metadata.IEndpointMetadataProvider")
+        || contracts.Implements(parameter.Type as INamedTypeSymbol, "Microsoft.AspNetCore.Http.Metadata.IEndpointParameterMetadataProvider");
+
+    private bool KnownMethodProvider(INamedTypeSymbol? type) => new[] { "Get", "Post", "Put", "Delete", "Patch", "Head", "Options" }
+        .Any(verb => contracts.Is(type, "Microsoft.AspNetCore.Mvc.Http" + verb + "Attribute"))
+        || contracts.Is(type, "Microsoft.AspNetCore.Mvc.AcceptVerbsAttribute");
+}
diff --git a/src/CallAtlas.Core/AspNetContracts.cs b/src/CallAtlas.Core/AspNetContracts.cs
new file mode 100644
index 0000000..accd9b3
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetContracts.cs
@@ -0,0 +1,75 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal sealed class AspNetContracts(Compilation compilation)
+{
+    private readonly Dictionary<string, INamedTypeSymbol?> symbols = new(StringComparer.Ordinal);
+
+    internal INamedTypeSymbol? Type(string metadataName)
+    {
+        if (symbols.TryGetValue(metadataName, out var cached)) return cached;
+        var symbol = compilation.GetTypeByMetadataName(metadataName);
+        symbols[metadataName] = IsFrameworkType(symbol) ? symbol : null;
+        return symbols[metadataName];
+    }
+
+    private static bool IsFrameworkType(INamedTypeSymbol? symbol) => symbol is not null
+        && symbol.Locations.All(location => !location.IsInSource)
+        && symbol.ContainingAssembly.Identity.Name is "Microsoft.AspNetCore.Mvc.Core"
+            or "Microsoft.AspNetCore.Mvc.Abstractions" or "Microsoft.AspNetCore.Http.Abstractions"
+            or "Microsoft.AspNetCore.Routing.Abstractions" or "Microsoft.AspNetCore.Routing";
+
+    internal bool Is(INamedTypeSymbol? symbol, string metadataName) => symbol is not null
+        && SymbolEqualityComparer.Default.Equals(symbol.OriginalDefinition, Type(metadataName));
+
+    internal bool Derives(INamedTypeSymbol? symbol, string metadataName) =>
+        Ancestors(symbol).Any(type => Is(type, metadataName));
+
+    internal bool Implements(INamedTypeSymbol? symbol, string metadataName) => symbol is not null
+        && (Is(symbol, metadataName) || symbol.AllInterfaces.Any(type => Is(type, metadataName)));
+
+    internal ITypeSymbol? TaskResult(INamedTypeSymbol type) =>
+        Ancestors(type).Select(DirectTaskResult).FirstOrDefault(result => result is not null);
+
+    private ITypeSymbol? DirectTaskResult(INamedTypeSymbol type)
+    {
+        if (type.TypeArguments.Length != 1) return null;
+        return RuntimeType(type, "System.Threading.Tasks.Task`1")
+            || RuntimeType(type, "System.Threading.Tasks.ValueTask`1") ? type.TypeArguments[0] : null;
+    }
+
+    private bool RuntimeType(INamedTypeSymbol symbol, string metadataName)
+    {
+        var expected = compilation.GetTypeByMetadataName(metadataName);
+        return expected is not null && RuntimeMetadata(expected)
+            && SymbolEqualityComparer.Default.Equals(symbol.OriginalDefinition, expected);
+    }
+
+    private static bool RuntimeMetadata(INamedTypeSymbol type) => type.Locations.All(location => !location.IsInSource)
+        && type.ContainingAssembly.Identity.Name is "System.Runtime" or "System.Private.CoreLib"
+            or "System.Threading.Tasks" or "mscorlib";
+
+    internal bool RouteProvider(AttributeData attribute) =>
+        Implements(attribute.AttributeClass, "Microsoft.AspNetCore.Mvc.Routing.IRouteTemplateProvider");
+
+    internal bool HasAttribute(ISymbol symbol, string metadataName) =>
+        Attributes(symbol).Any(attribute => Derives(attribute.AttributeClass, metadataName));
+
+    internal static IEnumerable<INamedTypeSymbol> Ancestors(INamedTypeSymbol? type)
+    {
+        for (var current = type; current is not null; current = current.BaseType) yield return current;
+    }
+
+    internal static IEnumerable<AttributeData> Attributes(ISymbol symbol) => symbol switch
+    {
+        INamedTypeSymbol type => Ancestors(type).SelectMany(current => current.GetAttributes()),
+        IMethodSymbol method => MethodChain(method).SelectMany(current => current.GetAttributes()),
+        _ => symbol.GetAttributes(),
+    };
+
+    internal static IEnumerable<IMethodSymbol> MethodChain(IMethodSymbol? method)
+    {
+        for (var current = method; current is not null; current = current.OverriddenMethod) yield return current;
+    }
+}
diff --git a/src/CallAtlas.Core/AspNetEligibility.cs b/src/CallAtlas.Core/AspNetEligibility.cs
new file mode 100644
index 0000000..59c3867
--- /dev/null
+++ b/src/CallAtlas.Core/AspNetEligibility.cs
@@ -0,0 +1,38 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal sealed class AspNetEligibility(AspNetContracts contracts, Compilation compilation)
+{
+    internal bool Controller(INamedTypeSymbol type) => IsPublicClass(type)
+        && !contracts.HasAttribute(type, "Microsoft.AspNetCore.Mvc.NonControllerAttribute")
+        && HasControllerMarker(type);
+
+    private static bool IsPublicClass(INamedTypeSymbol type) => type.TypeKind == TypeKind.Class
+        && !type.IsAbstract && type.DeclaredAccessibility == Accessibility.Public
+        && type.ContainingType is null && type.TypeParameters.Length == 0;
+
+    private bool HasControllerMarker(INamedTypeSymbol type) =>
+        type.Name.EndsWith("Controller", StringComparison.OrdinalIgnoreCase)
+        || contracts.HasAttribute(type, "Microsoft.AspNetCore.Mvc.ControllerAttribute");
+
+    internal bool Action(IMethodSymbol method) => IsPublicMethod(method)
+        && !contracts.HasAttribute(method, "Microsoft.AspNetCore.Mvc.NonActionAttribute")
+        && Root(method).ContainingType.SpecialType != SpecialType.System_Object
+        && !IsDispose(method);
+
+    private static bool IsPublicMethod(IMethodSymbol method) => method.MethodKind == MethodKind.Ordinary
+        && method.DeclaredAccessibility == Accessibility.Public && !method.IsStatic
+        && !method.IsAbstract && !method.IsGenericMethod;
+
+    private bool IsDispose(IMethodSymbol method)
+    {
+        var root = Root(method);
+        var contract = compilation.GetTypeByMetadataName("System.IDisposable");
+        var dispose = contract?.GetMembers("Dispose").OfType<IMethodSymbol>().SingleOrDefault();
+        return dispose is not null && SymbolEqualityComparer.Default.Equals(root,
+            root.ContainingType.FindImplementationForInterfaceMember(dispose));
+    }
+
+    private static IMethodSymbol Root(IMethodSymbol method) => AspNetContracts.MethodChain(method).Last();
+}
diff --git a/src/CallAtlas.Core/AspNetModelConventions.cs b/src/CallAtlas.Core/AspNetModelConventions.cs
new file mode 100644
