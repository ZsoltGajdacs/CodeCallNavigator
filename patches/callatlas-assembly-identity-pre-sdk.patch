new file mode 100644
index 0000000..8839204
--- /dev/null
+++ b/src/CallAtlas.Core/MediatRJson.cs
@@ -0,0 +1,51 @@
+using System.Text.Json;
+
+namespace CallAtlas.Core;
+
+/// <summary>Round-trip additive framework capability without relabeling historical snapshots.</summary>
+internal static class MediatRJson
+{
+    private static readonly JsonSerializerOptions Options = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
+
+    internal static void Write(Utf8JsonWriter writer, CodeMap map)
+    {
+        writer.WriteString("frameworkFactsVersion", map.FrameworkFactsVersion);
+        WriteValue(writer, "frameworkEdges", map.FrameworkEdges);
+        WriteValue(writer, "frameworkEntries", map.FrameworkEntries);
+        WriteValue(writer, "frameworkDiagnostics", map.FrameworkDiagnostics);
+    }
+
+    private static void WriteValue<T>(Utf8JsonWriter writer, string name, T value)
+    {
+        writer.WritePropertyName(name);
+        JsonSerializer.Serialize(writer, value, Options);
+    }
+
+    internal static MediatRSnapshot Read(JsonElement root)
+    {
+        var version = root.TryGetProperty("frameworkFactsVersion", out var property) ? property.GetString() ?? "" : "";
+        if (version.Length != 0 && version != MediatRFacts.Version)
+            throw new CallAtlasException($"Unsupported framework facts version '{version}'; regenerate the snapshot.");
+        if (version == MediatRFacts.Version) RequireArrays(root);
+        return new MediatRSnapshot(version,
+            ReadValue<MediatRDispatchFact>(root, "frameworkEdges"),
+            ReadValue<string>(root, "frameworkEntries"),
+            ReadValue<string>(root, "frameworkDiagnostics"));
+    }
+
+    private static void RequireArrays(JsonElement root)
+    {
+        var fields = new[] { "frameworkEdges", "frameworkEntries", "frameworkDiagnostics" };
+        if (!fields.All(name => HasArray(root, name)))
+            throw new CallAtlasException("Incomplete framework facts; regenerate the snapshot.");
+    }
+
+    private static bool HasArray(JsonElement root, string name) =>
+        root.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.Array;
+
+    private static T[] ReadValue<T>(JsonElement root, string name) => root.TryGetProperty(name, out var value)
+        ? JsonSerializer.Deserialize<T[]>(value.GetRawText(), Options) ?? [] : [];
+}
+
+internal sealed record MediatRSnapshot(string Version, MediatRDispatchFact[] Edges,
+    string[] Entries, string[] Diagnostics);
