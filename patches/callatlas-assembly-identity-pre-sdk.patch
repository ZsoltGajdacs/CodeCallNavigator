@@ -0,0 +1,74 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+/// <summary>Structural compiler type identities retain constructed owners and array element assemblies.</summary>
+internal static class MediatRTypes
+{
+    private static readonly JsonSerializerOptions Options = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+    };
+
+    internal static string Key(ITypeSymbol type) =>
+        JsonSerializer.Serialize(Describe(type, assembly => assembly.Identity.ToString()), Options);
+
+    internal static string Stable(ITypeSymbol type) =>
+        JsonSerializer.Serialize(Describe(type, assembly => assembly.Identity.Name), Options);
+
+    internal static bool IsClosed(ITypeSymbol type) => type switch
+    {
+        INamedTypeSymbol named => IsClosedNamed(named),
+        IArrayTypeSymbol array => IsClosed(array.ElementType),
+        _ => false,
+    };
+
+    private static bool IsClosedNamed(INamedTypeSymbol type) =>
+        IsNamedDefinition(type) && type.TypeArguments.All(IsClosed) && IsClosedOwner(type.ContainingType);
+
+    private static bool IsNamedDefinition(INamedTypeSymbol type) =>
+        !type.IsUnboundGenericType && type.TypeKind != TypeKind.Error;
+
+    private static bool IsClosedOwner(INamedTypeSymbol? owner) => owner is null || IsClosed(owner);
+
+    private static CompilerType Describe(ITypeSymbol type, Func<IAssemblySymbol, string> assemblyName) => type switch
+    {
+        INamedTypeSymbol named => Named(named, assemblyName),
+        IArrayTypeSymbol array => Array(array, assemblyName),
+        _ => throw new InvalidOperationException("Unsupported MediatR compiler type identity"),
+    };
+
+    private static CompilerType Named(INamedTypeSymbol type, Func<IAssemblySymbol, string> assemblyName) => new()
+    {
+        Kind = "named",
+        Assembly = assemblyName(type.ContainingAssembly),
+        Namespace = type.ContainingNamespace.ToDisplayString(),
+        Name = type.MetadataName,
+        Owner = type.ContainingType is null ? null : Describe(type.ContainingType, assemblyName),
+        Arguments = type.TypeArguments.Select(argument => Describe(argument, assemblyName)).ToArray(),
+    };
+
+    private static CompilerType Array(IArrayTypeSymbol type, Func<IAssemblySymbol, string> assemblyName) => new()
+    {
+        Kind = "array",
+        Element = Describe(type.ElementType, assemblyName),
+        Rank = type.Rank,
+        SzArray = type.IsSZArray,
+    };
+
+    private sealed record CompilerType
+    {
+        public required string Kind { get; init; }
+        public string? Assembly { get; init; }
+        public string? Namespace { get; init; }
+        public string? Name { get; init; }
+        public CompilerType? Owner { get; init; }
+        public CompilerType[]? Arguments { get; init; }
+        public CompilerType? Element { get; init; }
+        public int? Rank { get; init; }
+        public bool? SzArray { get; init; }
+    }
+}
