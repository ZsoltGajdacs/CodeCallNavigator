+// Rasterize only the thin strip around a segment, rather than its axis-aligned bounds.
+// Keep the original rect for layer bounds and the original endpoints for fragment coverage.
+fn segment_quad(i: In, corner: vec2<f32>) -> vec2<f32> {
+    let delta = i.radii.zw - i.radii.xy;
+    let len = length(delta);
+    let tangent = select(vec2<f32>(1.0, 0.0), delta / max(len, 1e-4), len >= 1e-4);
+    let normal = vec2<f32>(-tangent.y, tangent.x);
+    // push_shape pads by max(half width, 0.5) + 1; base_vs adds another device pixel.
+    // This also covers round caps, subpixel strokes, and the antialias fringe.
+    let pad = max(i.params.x, 0.5) + 2.0;
+    return i.radii.xy + tangent * mix(-pad, len + pad, corner.x)
+        + normal * mix(-pad, pad, corner.y);
+}
