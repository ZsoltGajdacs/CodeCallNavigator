+    #[cfg(target_os = "macos")]
+    #[test]
+    fn oriented_segment_quads_preserve_caps_clips_and_layer_pixels() {
+        use super::super::Gpu;
+        let gpu = Gpu::headless();
+        let current = uber_wgsl();
+        let branch = "    if (kind > 4.5 && kind < 5.5) {\n        p = segment_quad(i, corner);\n    }\n";
+        assert_eq!(current.matches(branch).count(), 1);
+        let reference = current.replacen(branch, "", 1);
+        assert!(try_uber_metallib(&gpu.device, &current, uber_metallib(&gpu.device), UBER_WGSL_BLAKE3, |_| ()).is_none(),
+            "the pinned AABB metallib must not replace the patched WGSL");
+        for scale in [1.0, 2.0] {
+            compare_segment_quads(&gpu, &current, &reference, scale);
+        }
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_renderer(device: &wgpu::Device, source: &str) -> super::super::Renderer {
+        use super::super::{Blend, Renderer, OFFSCREEN_FORMAT};
+        let mut renderer = Renderer::new_classic(device, OFFSCREEN_FORMAT);
+        renderer.shader = super::super::dxbc::Shaders::one(wgsl_shader(device, source));
+        renderer.pipeline = Renderer::pipeline(device, &renderer.layout, &renderer.shader, OFFSCREEN_FORMAT, "vs", Blend::SourceOver);
+        renderer.extra.clear();
+        renderer
+    }
+
+    #[cfg(target_os = "macos")]
+    fn compare_segment_quads(gpu: &super::super::Gpu, current: &str, reference: &str, scale: f32) {
+        use super::super::{LayerSpec, Instance, Offscreen};
+        let mut oriented = segment_renderer(&gpu.device, current);
+        let mut aabb = segment_renderer(&gpu.device, reference);
+        let target = Offscreen::new(&gpu.device, (128.0 * scale) as u32, (96.0 * scale) as u32);
+        for instance in segment_samples(scale) {
+            let bounds = [8.0 * scale, 4.0 * scale, 112.0 * scale, 88.0 * scale];
+            let layer = Instance::begin_layer(bounds, instance.clip, LayerSpec { opacity: 0.65, ..Default::default() });
+            for instances in [vec![instance], vec![layer, instance, Instance::end_layer()]] {
+                let expected = segment_pixels(gpu, &mut aabb, &target, &instances);
+                let actual = segment_pixels(gpu, &mut oriented, &target, &instances);
+                let worst = actual.iter().zip(&expected).map(|(a, b)| a.abs_diff(*b)).max().unwrap();
+                assert!(worst <= 1, "segment pixels changed by {worst} at scale {scale}: {:?}", instance.radii);
+            }
+        }
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_pixels(gpu: &super::super::Gpu, renderer: &mut super::super::Renderer, target: &super::super::Offscreen, instances: &[super::super::Instance]) -> Vec<u8> {
+        let mut text = crate::text::TextSystem::default();
+        let size = (target.width, target.height);
+        renderer.prepare(&gpu.device, &gpu.queue, &mut text.atlas, instances, size);
+        let mut encoder = gpu.device.create_command_encoder(&Default::default());
+        renderer.draw(&mut encoder, &target.view, [0.0; 4]);
+        target.copy(&mut encoder);
+        renderer.submit(&gpu.queue, encoder);
+        target.read(&gpu.device)
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_samples(scale: f32) -> Vec<super::super::Instance> {
+        let ends = [
+            [10.0, 14.0, 114.0, 82.0], [114.0, 82.0, 10.0, 14.0],
+            [10.0, 82.0, 114.0, 14.0], [114.0, 14.0, 10.0, 82.0],
+            [64.0, 10.0, 64.0, 86.0], [8.0, 48.0, 120.0, 48.0],
+            [64.0, 48.0, 64.0, 48.0], [64.0, 48.0, 64.00001, 48.0],
+            [-100.0, -60.0, 220.0, 154.0], [8.0, 8.0, 120.0, 88.0],
+        ];
+        ends.into_iter().flat_map(|points| [false, true].into_iter().flat_map(move |round| {
+            [0.15, 1.2, 4.0].map(|width| segment_sample(points, round, width, scale))
+        })).collect()
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_sample(points: [f32; 4], round: bool, width: f32, scale: f32) -> super::super::Instance {
+        use super::super::{Instance, KIND_SEGMENT, pack_fade};
+        use bytemuck::Zeroable;
+        let [ax, ay, bx, by] = points.map(|value| value * scale);
+        let half = width * scale * 0.5;
+        let pad = half.max(0.5) + 1.0;
+        let clip = [12.0 * scale, 8.0 * scale, 116.0 * scale, 88.0 * scale];
+        Instance {
+            rect: [ax.min(bx) - pad, ay.min(by) - pad, (ax - bx).abs() + pad * 2.0, (ay - by).abs() + pad * 2.0],
+            radii: [ax, ay, bx, by], fill: [0.32, 0.08, 0.16, 0.4],
+            params: [half, KIND_SEGMENT, u8::from(round) as f32, 1.0], clip,
+            fade: pack_fade([3.0 * scale; 4], clip, clip), ..Instance::zeroed()
+        }
+    }
+
 }
