 /// <summary>确定性 JSON 写出：字段顺序固定、排序在模型构建时完成、不含时间戳。</summary>
 public static class CodeMapJson
 {
+    private static void WriteDeclarations(Utf8JsonWriter writer, CodeMap map)
+    {
+            writer.WriteStartObject("entryPoints");
+            writer.WriteStartArray("candidates");
+            foreach (var entry in CodeMapQuery.EntryPoints(map))
+                writer.WriteStringValue(entry.Id);
+            writer.WriteEndArray();
+            writer.WriteStartArray("applicationStarts");
+            foreach (var identity in map.ApplicationStarts)
+                writer.WriteStringValue(identity);
+            writer.WriteEndArray();
+            writer.WriteEndObject();
+
+            writer.WriteStartArray("nodes");
+            foreach (var n in map.Nodes)
+            {
+                writer.WriteStartObject();
+                writer.WriteString("id", n.Id);
+                writer.WriteString("kind", n.Kind);
+                writer.WriteString("container", n.Container);
+                writer.WriteString("name", n.Name);
+                writer.WriteString("location", n.Location);
+                WriteDeclaration(writer, n.Declaration);
+                writer.WriteEndObject();
+            }
+            writer.WriteEndArray();
+
+    }
+
+    private static void WriteDeclaration(Utf8JsonWriter writer, MethodDeclarationFacts? facts)
+    {
+        if (facts is null) return;
+        writer.WriteStartObject("declaration");
+        writer.WriteBoolean("hasSourceDeclaration", facts.HasSourceDeclaration);
+        writer.WriteBoolean("isImplicit", facts.IsImplicit);
+        writer.WriteString("callableKind", facts.CallableKind);
+        writer.WriteBoolean("isObjectMember", facts.IsObjectMember);
+        writer.WriteString("visibility", facts.Visibility);
+        writer.WriteString("containerVisibility", facts.ContainerVisibility);
+        writer.WriteEndObject();
+    }
+
+    private static MethodDeclarationFacts? ReadDeclaration(JsonElement node)
+    {
+        if (!node.TryGetProperty("declaration", out var facts)) return null;
+        return new MethodDeclarationFacts
+        {
+            HasSourceDeclaration = facts.GetProperty("hasSourceDeclaration").GetBoolean(),
+            IsImplicit = facts.GetProperty("isImplicit").GetBoolean(),
+            CallableKind = facts.GetProperty("callableKind").GetString() ?? "",
+            IsObjectMember = facts.GetProperty("isObjectMember").GetBoolean(),
+            Visibility = facts.TryGetProperty("visibility", out var access) ? access.GetString() : null,
+            ContainerVisibility = facts.TryGetProperty("containerVisibility", out var containerAccess) ? containerAccess.GetString() : null,
+        };
+    }
+
