+        let mut text = crate::text::TextSystem::default();
+        let size = (target.width, target.height);
+        renderer.prepare(&gpu.device, &gpu.queue, &mut text.atlas, instances, size);
+        let mut encoder = gpu.device.create_command_encoder(&Default::default());
+        renderer.draw(&mut encoder, &target.view, [0.0; 4]);
+        target.copy(&mut encoder);
+        renderer.submit(&gpu.queue, encoder);
+        target.read(&gpu.device)
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_samples(scale: f32) -> Vec<super::super::Instance> {
+        let ends = [
+            [10.0, 14.0, 114.0, 82.0], [114.0, 82.0, 10.0, 14.0],
+            [10.0, 82.0, 114.0, 14.0], [114.0, 14.0, 10.0, 82.0],
+            [64.0, 10.0, 64.0, 86.0], [8.0, 48.0, 120.0, 48.0],
+            [64.0, 48.0, 64.0, 48.0], [64.0, 48.0, 64.00001, 48.0],
+            [-100.0, -60.0, 220.0, 154.0], [8.0, 8.0, 120.0, 88.0],
+        ];
+        ends.into_iter().flat_map(|points| [false, true].into_iter().flat_map(move |round| {
+            [0.15, 1.2, 4.0].map(|width| segment_sample(points, round, width, scale))
+        })).collect()
+    }
+
+    #[cfg(target_os = "macos")]
+    fn segment_sample(points: [f32; 4], round: bool, width: f32, scale: f32) -> super::super::Instance {
+        use super::super::{Instance, KIND_SEGMENT, pack_fade};
+        use bytemuck::Zeroable;
+        let [ax, ay, bx, by] = points.map(|value| value * scale);
+        let half = width * scale * 0.5;
+        let pad = half.max(0.5) + 1.0;
+        let clip = [12.0 * scale, 8.0 * scale, 116.0 * scale, 88.0 * scale];
+        Instance {
+            rect: [ax.min(bx) - pad, ay.min(by) - pad, (ax - bx).abs() + pad * 2.0, (ay - by).abs() + pad * 2.0],
+            radii: [ax, ay, bx, by], fill: [0.32, 0.08, 0.16, 0.4],
+            params: [half, KIND_SEGMENT, u8::from(round) as f32, 1.0], clip,
+            fade: pack_fade([3.0 * scale; 4], clip, clip), ..Instance::zeroed()
+        }
+    }
