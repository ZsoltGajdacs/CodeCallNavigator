+    #[cfg(target_os = "macos")]
+    fn compare_segment_quads(gpu: &super::super::Gpu, current: &str, reference: &str, scale: f32) {
+        use super::super::{LayerSpec, Instance, Offscreen};
+        let mut oriented = segment_renderer(&gpu.device, current);
+        let mut aabb = segment_renderer(&gpu.device, reference);
+        let target = Offscreen::new(&gpu.device, (128.0 * scale) as u32, (96.0 * scale) as u32);
+        for instance in segment_samples(scale) {
+            let bounds = [8.0 * scale, 4.0 * scale, 112.0 * scale, 88.0 * scale];
+            let layer = Instance::begin_layer(bounds, instance.clip, LayerSpec { opacity: 0.65, ..Default::default() });
+            for instances in [vec![instance], vec![layer, instance, Instance::end_layer()]] {
+                let expected = segment_pixels(gpu, &mut aabb, &target, &instances);
+                let actual = segment_pixels(gpu, &mut oriented, &target, &instances);
+                let worst = actual.iter().zip(&expected).map(|(a, b)| a.abs_diff(*b)).max().unwrap();
