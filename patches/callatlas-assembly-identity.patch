+public sealed record CompilationEvidence(string Version, IReadOnlyList<CompilerInputFact> Inputs)
+{
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+
+    internal static CompilationEvidence? CaptureWhenRequested(IReadOnlyList<Compilation> compilations) =>
+        Environment.GetEnvironmentVariable("CODECALLNAVIGATOR_CALLATLAS_COMPILER_EVIDENCE") == "1"
+            ? Capture(compilations)
+            : null;
+
+    private static CompilationEvidence Capture(IReadOnlyList<Compilation> compilations)
+    {
+        var seen = new HashSet<Compilation>();
+        var facts = new HashSet<CompilerInputFact>();
+        var referenceFiles = new Dictionary<string, ReferenceFile>(StringComparer.Ordinal);
+        var pending = new Stack<Compilation>(compilations);
+        while (pending.TryPop(out var compilation))
+        {
+            if (seen.Add(compilation)) CaptureCompilation(compilation, pending, facts, referenceFiles);
+        }
+        return new("1", facts.OrderBy(fact => fact.Path, StringComparer.Ordinal)
+            .ThenBy(fact => fact.Kind, StringComparer.Ordinal)
+            .ThenBy(fact => fact.Sha256, StringComparer.Ordinal)
+            .ThenBy(fact => fact.ContentChanged).ToArray());
+    }
+
+    private static void CaptureCompilation(Compilation compilation, Stack<Compilation> pending,
+        HashSet<CompilerInputFact> facts, Dictionary<string, ReferenceFile> referenceFiles)
+    {
+        foreach (var tree in compilation.SyntaxTrees) facts.Add(Source(tree, compilation.AssemblyName));
+        foreach (var reference in compilation.References)
+        {
+            if (reference is CompilationReference project) pending.Push(project.Compilation);
+            else facts.Add(Reference(reference, referenceFiles));
+        }
+    }
+
+    private static bool IsFilePath(string? path) =>
+        path is not null && Path.IsPathFullyQualified(path) && File.Exists(path);
+
+    private static CompilerInputFact Source(SyntaxTree tree, string? assembly)
+    {
+        var path = tree.FilePath;
+        if (!IsFilePath(path))
+            return new("source", path.Length == 0 ? $"in-memory source in {assembly}" : path, null);
+
+        var actual = tree.GetText();
+        var bytes = File.ReadAllBytes(path);
+        using var stream = new MemoryStream(bytes, writable: false);
+        var disk = SourceText.From(stream, actual.Encoding);
+        return actual.ContentEquals(disk)
+            ? new("source", path, Hex(SHA256.HashData(bytes)))
+            : new("source", path, null, ContentChanged: true);
+    }
+
+    private static CompilerInputFact Reference(MetadataReference reference, Dictionary<string, ReferenceFile> files)
+    {
+        if (reference is not PortableExecutableReference portable)
+            return new("reference", reference.Display ?? "in-memory assembly reference", null);
+        if (portable.FilePath is not { } path || !IsFilePath(path))
+            return new("reference", reference.Display ?? "in-memory assembly reference", null);
+
+        if (!files.TryGetValue(path, out var file))
+        {
+            file = ReferenceFile.Read(path);
+            files.Add(path, file);
+        }
+        return MatchesMetadata(portable, file.Metadata) switch
+        {
+            true => new("reference", path, file.Hash),
+            false => new("reference", path, null, ContentChanged: true),
+            _ => new("reference", path, null),
+        };
+    }
+
+    private static unsafe bool? MatchesMetadata(PortableExecutableReference reference, byte[] bytes)
+    {
+        // Compare the effective metadata loaded by Roslyn to the file whose bytes we hash.
+        // The span is consumed while the Roslyn module still owns its memory.
+        var metadata = reference.GetMetadata();
+        var module = metadata switch
+        {
+            AssemblyMetadata assembly when assembly.GetModules() is [var single] => single,
+            ModuleMetadata single => single,
+            _ => null,
+        };
+        if (module is null) return null;
+        var reader = module.GetMetadataReader();
+        var matches = new ReadOnlySpan<byte>(reader.MetadataPointer, reader.MetadataLength).SequenceEqual(bytes);
+        GC.KeepAlive(module);
+        return matches;
+    }
+
+    private static string Hex(byte[] hash) => Convert.ToHexStringLower(hash);
+
+    private sealed record ReferenceFile(string Hash, byte[] Metadata)
+    {
+        internal static ReferenceFile Read(string path)
+        {
+            using var stream = File.OpenRead(path);
+            using var file = new PEReader(stream, PEStreamOptions.PrefetchMetadata | PEStreamOptions.LeaveOpen);
+            stream.Position = 0;
+            return new(Hex(SHA256.HashData(stream)), file.GetMetadata().GetContent().ToArray());
+        }
+    }
+
+    internal static void Write(Utf8JsonWriter writer, CompilationEvidence? evidence)
+    {
+        if (evidence is null) return;
+        writer.WritePropertyName("compilerEvidence");
+        JsonSerializer.Serialize(writer, evidence, JsonOptions);
+    }
+
+    internal static CompilationEvidence? Read(JsonElement root) =>
+        root.TryGetProperty("compilerEvidence", out var evidence)
+            ? evidence.Deserialize<CompilationEvidence>(JsonOptions)
+            : null;
+}
