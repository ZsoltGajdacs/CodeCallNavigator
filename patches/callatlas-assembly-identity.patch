+    public bool? TestFirst { get; init; }
+    public string? Label { get; init; }
+    public bool? Deferred { get; init; }
+}
+
+public sealed record FlowExpression([property: JsonRequired] string Kind, [property: JsonRequired] FlowSpan Span)
+{
+    public string? Text { get; init; }
+    public IReadOnlyList<FlowCall>? Calls { get; init; }
+    public IReadOnlyList<FlowExpression>? Items { get; init; }
+    public FlowExpression? Left { get; init; }
+    public FlowExpression? Right { get; init; }
+    public FlowExpression? Condition { get; init; }
+    public FlowExpression? WhenTrue { get; init; }
+    public FlowExpression? WhenFalse { get; init; }
+}
+
+public sealed record FlowCase(IReadOnlyList<string> Labels, FlowSpan Span, bool IsDefault,
+    bool FallsThrough, IReadOnlyList<FlowStatement> Body);
diff --git a/src/CallAtlas.Core/FlowExport.cs b/src/CallAtlas.Core/FlowExport.cs
new file mode 100644
index 0000000..f606ebf
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExport.cs
@@ -0,0 +1,100 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed record FlowInput(string Symbol, SyntaxTree Tree, SemanticModel Model, IReadOnlyList<SyntaxNode> Bodies);
+
+internal static class FlowExport
+{
+    internal static FlowInventory Build(IEnumerable<FlowInput> inputs, IReadOnlyDictionary<string, Node> nodes,
+        FlowBindings bindings, string root)
+    {
+        var functions = new List<FunctionFlow>();
+        var sources = new Dictionary<SyntaxTree, FlowSource>();
+        foreach (var group in inputs.GroupBy(i => i.Symbol).OrderBy(g => g.Key, StringComparer.Ordinal))
+        {
+            if (!nodes.TryGetValue(group.Key, out var node) || node.Kind is not ("method" or "accessor" or "localfunction" or "toplevel"))
+                continue;
+            var entries = group.ToArray();
+            if (entries.Select(e => e.Tree).Distinct().Count() != 1) continue; // Ambiguous source ownership is unavailable.
+            var first = entries[0];
+            if (!sources.TryGetValue(first.Tree, out var source)) sources[first.Tree] = source = new FlowSource(first.Tree, root);
+            var bodies = entries.SelectMany(e => e.Bodies).OrderBy(b => b.SpanStart).ToArray();
+            if (bodies.Length == 0) continue;
+            var span = new FlowSpan(source.Span(bodies[0]).Start, source.Span(bodies[^1]).End);
+            var exporter = new FlowBody(group.Key, first.Model, source, bindings);
+            var body = exporter.Export(bodies);
+            var function = new FunctionFlow(group.Key, first.Tree.FilePath, "", first.Model.Compilation.AssemblyName ?? "",
+                "csharp", span, body, exporter.Diagnostics.ToArray());
+            try { FlowValidation.ValidateBody(function); }
+            catch (FlowUnsupported)
+            {
+                function = function with
+                {
+                    Body = [new("unsupported", span) { Text = "Callable exceeds flow export budget", Reason = "Flow export exceeds 1500 IR nodes" }],
+                    Diagnostics = [.. function.Diagnostics, "Flow export exceeds 1500 IR nodes"],
+                };
+            }
+            functions.Add(function);
+        }
+        return new(1, functions);
+    }
+}
+
+internal sealed class FlowUnsupported(string reason, bool limit = false) : Exception(reason)
+{
+    internal bool Limit { get; } = limit;
+}
+
+internal sealed partial class FlowBody(string symbol, SemanticModel model, FlowSource source, FlowBindings bindings)
+{
+    private int nodes;
+    internal List<string> Diagnostics { get; } = [];
+
+    internal IReadOnlyList<FlowStatement> Export(IReadOnlyList<SyntaxNode> bodies)
+    {
+        try
+        {
+            if (bindings.Exceeded(symbol)) throw new FlowUnsupported("Flow binding exceeds 1500 sites or targets per callable", true);
+            if (source.Problem is not null) throw new FlowUnsupported(source.Problem, true);
+            if (bodies.Any(IsAsyncOrIterator))
+                throw new FlowUnsupported("Async/iterator execution and suspension are opaque", true);
+            return bodies.SelectMany(body => Body(body, 0)).ToArray();
+        }
+        catch (FlowUnsupported problem)
+        {
+            Diagnostics.Add(problem.Message);
+            var span = new FlowSpan(source.Span(bodies[0]).Start, source.Span(bodies[^1]).End);
+            return [new("unsupported", span) { Text = "Callable source flow unavailable", Reason = problem.Message }];
+        }
+    }
+
+    private static bool IsAsyncOrIterator(SyntaxNode body)
+    {
+        if (body.Parent is MethodDeclarationSyntax method && method.Modifiers.Any(m => m.ValueText == "async")) return true;
+        if (body.Parent is LocalFunctionStatementSyntax local && local.Modifiers.Any(m => m.ValueText == "async")) return true;
+        return body.DescendantNodesAndSelf(n => n == body || n is not (AnonymousFunctionExpressionSyntax or LocalFunctionStatementSyntax))
+            .Any(n => n is AwaitExpressionSyntax or YieldStatementSyntax);
+    }
+
+    private void Budget(int depth)
+    {
+        if (depth > 24 || ++nodes > 1500)
+            throw new FlowUnsupported("Flow export exceeds 24 nested levels or 1500 IR nodes", true);
+    }
+
+    private IReadOnlyList<FlowStatement> Body(SyntaxNode body, int depth) => body switch
+    {
+        BlockSyntax block => block.Statements.Select(s => Statement(s, depth + 1)).ToArray(),
+        ArrowExpressionClauseSyntax arrow => [new("return", source.Span(arrow)) { Value = Expression(arrow.Expression, depth + 1) }],
+        StatementSyntax statement => [Statement(statement, depth + 1)],
+        _ => [Opaque(body, "Unsupported callable body")],
+    };
+
+    private FlowStatement Opaque(SyntaxNode node, string reason)
+    {
+        if (!Diagnostics.Contains(reason)) Diagnostics.Add(reason);
+        return new("unsupported", source.Span(node)) { Text = FlowText.Label(node), Reason = reason };
+    }
+}
diff --git a/src/CallAtlas.Core/FlowExpressionValidation.cs b/src/CallAtlas.Core/FlowExpressionValidation.cs
new file mode 100644
index 0000000..8443946
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExpressionValidation.cs
@@ -0,0 +1,42 @@
+namespace CallAtlas.Core;
+
+internal static partial class FlowValidation
+{
+    private static void Expression(FlowExpression node, FlowSpan owner, Stack<object> pending)
+    {
+        CheckSpan(node.Span, owner);
+        switch (node.Kind)
+        {
+            case "sequence": PushAll(pending, node.Items); break;
+            case "and": case "or": Push(pending, node.Left); Push(pending, node.Right); break;
+            case "conditional": Push(pending, node.Condition); Push(pending, node.WhenTrue); Push(pending, node.WhenFalse); break;
+            case "value": ValueCalls(node, owner); break;
+            default: throw Invalid("Unknown expression kind");
+        }
+    }
+
+    private static void ValueCalls(FlowExpression node, FlowSpan owner)
+    {
+        Require(node.Text is not null);
+        Require(node.Calls is not null);
+        foreach (var call in node.Calls!) Call(call, owner);
+    }
+
+    private static void Call(FlowCall? call, FlowSpan owner)
+    {
+        Require(call is not null);
+        Require(call!.Label is not null);
+        Require(call.Targets is not null);
+        CheckSpan(call.Span, owner);
+        foreach (var target in call.Targets!) Target(target);
+    }
+
+    private static void Target(FlowTarget? target)
+    {
+        Require(target is not null);
+        Require(!string.IsNullOrEmpty(target!.Symbol));
+        Require(!string.IsNullOrEmpty(target.Certainty));
+        Require(!string.IsNullOrEmpty(target.Provenance));
+        Require(target.Kind == "call");
+    }
+}
diff --git a/src/CallAtlas.Core/FlowExpressions.cs b/src/CallAtlas.Core/FlowExpressions.cs
new file mode 100644
index 0000000..a498c8f
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExpressions.cs
@@ -0,0 +1,149 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.CodeAnalysis.Operations;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowExpression Expression(ExpressionSyntax expression, int depth)
+    {
+        Budget(depth);
+        var conversion = model.GetConversion(expression);
+        if (conversion.IsUserDefined || conversion.IsDynamic)
+            throw new FlowUnsupported("User-defined or dynamic conversion evaluation is opaque");
+        return expression switch
+        {
+            ConditionalExpressionSyntax conditional => new("conditional", source.Span(expression))
+            {
+                Condition = Condition(conditional.Condition, depth + 1), WhenTrue = Expression(conditional.WhenTrue, depth + 1),
+                WhenFalse = Expression(conditional.WhenFalse, depth + 1),
+            },
+            BinaryExpressionSyntax binary => Binary(binary, depth),
+            AssignmentExpressionSyntax assignment => Assignment(assignment, depth),
+            _ => OrderedExpression(expression, depth),
+        };
+    }
+
+    private FlowExpression OrderedExpression(ExpressionSyntax expression, int depth) => expression switch
+    {
+            ParenthesizedExpressionSyntax parenthesized => Expression(parenthesized.Expression, depth + 1),
+            InvocationExpressionSyntax invocation => Invocation(invocation, depth),
+            MemberAccessExpressionSyntax member => Member(member, depth),
+            ElementAccessExpressionSyntax element => Element(element, depth),
+            BaseObjectCreationExpressionSyntax creation when creation.Initializer is null => Sequence(creation,
+                (creation.ArgumentList?.Arguments.Select(a => Expression(a.Expression, depth + 1)) ?? []).Append(Value(creation)).ToArray()),
+            _ => AtomicExpression(expression, depth),
+    };
+
+    private FlowExpression AtomicExpression(ExpressionSyntax expression, int depth) => expression switch
+    {
+            LiteralExpressionSyntax or IdentifierNameSyntax or ThisExpressionSyntax or BaseExpressionSyntax
+                or TypeOfExpressionSyntax or DefaultExpressionSyntax => Value(expression),
+            PrefixUnaryExpressionSyntax prefix => Unary(prefix, prefix.Operand, depth),
+            PostfixUnaryExpressionSyntax postfix => postfix.IsKind(SyntaxKind.SuppressNullableWarningExpression)
+                ? Expression(postfix.Operand, depth + 1) : Unary(postfix, postfix.Operand, depth),
+            CastExpressionSyntax cast when model.GetSymbolInfo(cast).Symbol is not IMethodSymbol =>
+                Sequence(cast, [Expression(cast.Expression, depth + 1), Value(cast)]),
+            _ => throw new FlowUnsupported($"Unsupported {expression.Kind()} expression evaluation"),
+    };
+
+    private FlowExpression Condition(ExpressionSyntax expression, int depth)
+    {
+        if (model.GetTypeInfo(expression).Type?.SpecialType != SpecialType.System_Boolean)
+            throw new FlowUnsupported("User-defined truth conversion/operator is opaque");
+        return Expression(expression, depth);
+    }
+
+    private void StaticReceiver(ExpressionSyntax expression)
+    {
+        if (model.GetTypeInfo(expression).Type?.TypeKind == TypeKind.Dynamic)
+            throw new FlowUnsupported("Dynamic member/indexer/operator evaluation is opaque");
+    }
+
+    private FlowExpression Member(MemberAccessExpressionSyntax member, int depth)
+    {
+        StaticReceiver(member.Expression);
+        return Sequence(member, [Expression(member.Expression, depth + 1), Value(member)]);
+    }
+
+    private FlowExpression Element(ElementAccessExpressionSyntax element, int depth)
+    {
+        StaticReceiver(element.Expression);
+        return Sequence(element,
+            new[] { Expression(element.Expression, depth + 1) }.Concat(element.ArgumentList.Arguments.Select(a => Expression(a.Expression, depth + 1)))
+                .Append(Value(element)).ToArray());
+    }
+
+    private FlowExpression Invocation(InvocationExpressionSyntax invocation, int depth)
+    {
+        var operation = model.GetOperation(invocation);
+        if (operation is INameOfOperation) return Value(invocation) with { Calls = [] };
+        if (operation is IDynamicInvocationOperation)
+            throw new FlowUnsupported("Dynamic invocation is opaque");
+        var values = new List<FlowExpression>();
+        if (invocation.Expression is MemberAccessExpressionSyntax member)
+            values.Add(Expression(member.Expression, depth + 1));
+        else if (invocation.Expression is not (IdentifierNameSyntax or GenericNameSyntax))
+            throw new FlowUnsupported("Conditional/dynamic invocation receiver is opaque");
+        values.AddRange(invocation.ArgumentList.Arguments.Select(a => Expression(a.Expression, depth + 1)));
+        values.Add(InvocationValue(invocation, operation));
+        return Sequence(invocation, values);
+    }
+
+    private FlowExpression InvocationValue(InvocationExpressionSyntax invocation, IOperation? operation)
+    {
+        var value = Value(invocation);
+        if (operation is not IInvocationOperation) return value;
+        if (value.Calls is { Count: > 0 }) return value;
+        // Preserve native graph limitations without silently hiding a compiler-proven invocation.
+        return value with
+        {
+            Calls = [new(source.Span(invocation), FlowText.Label(invocation), [],
+                "Native analyzer omitted binding for this compiler-resolved invocation")],
+        };
+    }
+
+    private FlowExpression Binary(BinaryExpressionSyntax binary, int depth)
+    {
+        if (binary.IsKind(SyntaxKind.CoalesceExpression)) throw new FlowUnsupported("Null-coalescing evaluation is opaque");
+        if (model.GetOperation(binary) is IBinaryOperation { OperatorMethod: not null })
+            throw new FlowUnsupported("Overloaded operator evaluation is opaque");
+        if (model.GetTypeInfo(binary.Left).Type?.TypeKind == TypeKind.Dynamic
+            || model.GetTypeInfo(binary.Right).Type?.TypeKind == TypeKind.Dynamic)
+            throw new FlowUnsupported("Dynamic operator evaluation is opaque");
+        var left = Expression(binary.Left, depth + 1);
+        var right = Expression(binary.Right, depth + 1);
+        if (binary.IsKind(SyntaxKind.LogicalAndExpression) || binary.IsKind(SyntaxKind.LogicalOrExpression))
+            return new(binary.IsKind(SyntaxKind.LogicalAndExpression) ? "and" : "or", source.Span(binary)) { Left = left, Right = right };
+        return Sequence(binary, [left, right, Value(binary)]);
+    }
+
+    private FlowExpression Assignment(AssignmentExpressionSyntax assignment, int depth)
+    {
+        if (!assignment.IsKind(SyntaxKind.SimpleAssignmentExpression)
+            || model.GetSymbolInfo(assignment.Left).Symbol is not (ILocalSymbol or IParameterSymbol or IFieldSymbol))
+            throw new FlowUnsupported("Accessor/compound assignment order is opaque");
+        return Sequence(assignment, [Expression(assignment.Left, depth + 1), Expression(assignment.Right, depth + 1), Value(assignment)]);
+    }
+
+    private FlowExpression Unary(ExpressionSyntax expression, ExpressionSyntax operand, int depth)
+    {
+        StaticReceiver(operand);
+        if (model.GetSymbolInfo(expression).Symbol is IMethodSymbol { MethodKind: not MethodKind.BuiltinOperator }
+            || model.GetSymbolInfo(operand).Symbol is IPropertySymbol)
+            throw new FlowUnsupported("Overloaded/accessor unary evaluation is opaque");
+        return Sequence(expression, [Expression(operand, depth + 1), Value(expression)]);
+    }
+
+    private FlowExpression Value(SyntaxNode node, string? text = null)
+    {
+        Budget(0);
+        return new("value", source.Span(node))
+        { Text = text is null ? FlowText.Label(node) : FlowText.Bounded(text), Calls = bindings.At(symbol, node, source) };
+    }
+
+    private FlowExpression Sequence(SyntaxNode node, IReadOnlyList<FlowExpression> items) =>
+        items.Count == 1 ? items[0] : new("sequence", source.Span(node)) { Items = items };
+}
