+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using CallAtlas.Core;
+using Xunit;
+
+namespace CallAtlas.Tests;
+
+public class FlowFactsTests
+{
+    private static JsonElement Snapshot(string source) => JsonDocument.Parse(
+        CodeMapJson.Write(CallGraphBuilder.Build([("/proj/a.cs", source)], "/proj"))).RootElement.Clone();
+
+    private static JsonElement Function(JsonElement map, string suffix) => map.GetProperty("flowInventory")
+        .GetProperty("functions").EnumerateArray().Single(f => f.GetProperty("symbol").GetString()!.EndsWith(suffix));
+
+    private static IEnumerable<JsonElement> Objects(JsonElement node)
+    {
+        if (node.ValueKind == JsonValueKind.Object)
+        {
+            yield return node;
+            foreach (var property in node.EnumerateObject())
+                foreach (var child in Objects(property.Value)) yield return child;
+        }
+        if (node.ValueKind == JsonValueKind.Array)
+            foreach (var item in node.EnumerateArray())
+                foreach (var child in Objects(item)) yield return child;
+    }
+
+    [Fact]
+    public void Current_flow_capability_roundtrips_and_historical_maps_stay_absent()
+    {
+        var map = Snapshot("class A { static int Leaf(int x) => x; int Run() => Leaf(1); }");
+        Assert.Equal("1", map.GetProperty("flowFactsVersion").GetString());
+        Assert.Equal(1, map.GetProperty("flowInventory").GetProperty("version").GetInt32());
+        var roundtrip = JsonDocument.Parse(CodeMapJson.Write(CodeMapJson.Read(map.GetRawText()))).RootElement;
+        Assert.Equal(map.GetProperty("flowInventory").GetRawText(), roundtrip.GetProperty("flowInventory").GetRawText());
+        var historical = CodeMapJson.Write(CodeMapJson.Read("""{"schema":"callatlas.ir.v3","nodes":[],"edges":[]}"""));
+        Assert.False(JsonDocument.Parse(historical).RootElement.TryGetProperty("flowInventory", out _));
+    }
+
+    [Theory]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"2","flowInventory":{"version":1,"functions":[]}}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1"}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1","flowInventory":null}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1","flowInventory":{"version":2,"functions":[]}}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1","flowInventory":{"version":"1","functions":[]}}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":1}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":null}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1","flowInventory":{"version":1}}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowFactsVersion":"1","flowInventory":{"version":1,"functions":null}}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","flowInventory":{"version":1,"functions":[]}}""")]
+    public void Unsupported_or_incomplete_flow_capability_is_rejected(string json) =>
+        Assert.Throws<CallAtlasException>(() => CodeMapJson.Read(json));
+
+    [Fact]
+    public void Same_line_calls_keep_overload_targets_and_evaluation_order()
+    {
+        var map = Snapshot("class A { static int Leaf(int x) => x; static int Leaf(string s) => s.Length; int Run() { return Leaf(Leaf(1)) + Leaf(\"s\"); } }");
+        var function = Function(map, "A::Run()");
+        var calls = Objects(function.GetProperty("body")).Where(o => o.TryGetProperty("targets", out _)).ToArray();
+        Assert.Equal(3, calls.Length);
+        var targets = calls.Select(c => c.GetProperty("targets")[0].GetProperty("symbol").GetString()!).ToArray();
+        Assert.EndsWith("A::Leaf(System.Int32)", targets[0]);
+        Assert.EndsWith("A::Leaf(System.Int32)", targets[1]);
+        Assert.EndsWith("A::Leaf(System.String)", targets[2]);
+        var ids = map.GetProperty("nodes").EnumerateArray().Select(n => n.GetProperty("id").GetString()).ToHashSet();
+        Assert.All(targets, target => Assert.Contains(target, ids));
+        Assert.True(calls[0].GetProperty("span").GetProperty("start").GetInt32() > calls[1].GetProperty("span").GetProperty("start").GetInt32());
+    }
+
+    [Fact]
+    public void Structured_control_and_detached_local_functions_preserve_shape()
+    {
+        var map = Snapshot("class A { static bool Hit() => true; int P { get { return 1; } } int Run(bool flag) { int Local() => 2; if(flag && Hit()) return Local(); for(int i=0;i<2;i++) { if(flag) continue; break; } switch(P) { case 1: return 1; default: return 0; } } }");
+        var run = Function(map, "A::Run(System.Boolean)");
+        var kinds = Objects(run.GetProperty("body")).Where(o => o.TryGetProperty("kind", out _)).Select(o => o.GetProperty("kind").GetString()).ToArray();
+        Assert.Contains("if", kinds);
+        Assert.Contains("and", kinds);
+        Assert.Contains("loop", kinds);
+        Assert.Contains("switch", kinds);
+        Assert.Contains("continue", kinds);
+        Assert.Contains("break", kinds);
+        Assert.Single(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray(), f => f.GetProperty("symbol").GetString()!.Contains("Local"));
+        Assert.NotEmpty(Function(map, "A::get_P()").GetProperty("body").EnumerateArray());
+    }
+
+    [Fact]
+    public void Top_level_statements_are_one_ordered_callable()
+    {
+        var map = Snapshot("System.Console.WriteLine(1); System.Console.WriteLine(2);");
+        var top = Assert.Single(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray());
+        Assert.Equal(2, top.GetProperty("body").GetArrayLength());
+    }
+
+    [Fact]
+    public void Unsupported_conditional_and_deferred_bodies_do_not_export_eager_nested_calls()
+    {
+        var map = Snapshot("class A { static int Hit() => 1; object Run(A a) { System.Func<int> f = () => Hit(); return a?.Run(a); } }");
+        var body = Function(map, "A::Run(A)").GetProperty("body");
+        Assert.Contains(Objects(body), o => o.TryGetProperty("kind", out var k) && k.GetString() == "unsupported");
+        Assert.DoesNotContain(Objects(body), o => o.TryGetProperty("targets", out var targets) && targets.EnumerateArray().Any(t => t.GetProperty("symbol").GetString()!.Contains("Hit")));
+    }
+
+    [Fact]
+    public void Utf8_offsets_include_actual_bom_unicode_and_crlf()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "callatlas-flow-" + Guid.NewGuid());
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var path = Path.Combine(directory, "A.cs");
+            var source = "class A {\r\n string Run() { string s = \"é😀\"; return s.Trim(); }\r\n}";
+            File.WriteAllText(path, source, new UTF8Encoding(true));
+            var map = JsonDocument.Parse(CodeMapJson.Write(CallGraphBuilder.Build([(path, source)], directory))).RootElement;
+            var call = Objects(Function(map, "A::Run()").GetProperty("body")).Single(o => o.TryGetProperty("targets", out _));
+            var span = call.GetProperty("span");
+            var bytes = File.ReadAllBytes(path);
+            var text = Encoding.UTF8.GetString(bytes[span.GetProperty("start").GetInt32()..span.GetProperty("end").GetInt32()]);
+            Assert.Equal("s.Trim()", text);
+        }
+        finally { Directory.Delete(directory, true); }
+    }
+
+    [Fact]
+    public void Oversized_bodies_produce_bounded_explicit_unsupported_flow()
+    {
+        var source = "class A { void Run() {" + string.Concat(Enumerable.Repeat("System.Console.WriteLine(1);", 1600)) + "} }";
+        var run = Function(Snapshot(source), "A::Run()");
+        Assert.Single(run.GetProperty("body").EnumerateArray());
+        Assert.Equal("unsupported", run.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.NotEmpty(run.GetProperty("diagnostics").EnumerateArray());
+    }
+
+    [Fact]
+    public void Malformed_nested_flow_facts_are_rejected_at_the_json_boundary()
+    {
+        var baseline = Snapshot("class A { int Run() => 1; }").GetRawText();
+        Action<JsonObject>[] changes =
+        [
+            f => f.Remove("symbol"),
+            f => f["span"]!.AsObject().Remove("end"),
+            f => f["span"]!["start"] = -1,
+            f => f["body"]![0]!["value"]!["span"]!["end"] = 1000000,
+            f => f["body"] = new JsonObject(),
+            f => f["body"]![0]!["kind"] = "guessed_future_statement",
+            f => { f["body"]![0]!["kind"] = "evaluate"; f["body"]![0]!["value"] = null; },
+            f => f["body"]![0]!["value"]!["calls"] = new JsonObject(),
+            f => f["body"]![0]!["value"]!["calls"] = new JsonArray(new JsonObject
+                { ["span"] = f["span"]!.DeepClone(), ["label"] = "bad", ["targets"] = new JsonArray(new JsonObject()) }),
+        ];
+        for (var index = 0; index < changes.Length; index++)
+        {
+            var map = JsonNode.Parse(baseline)!;
+            changes[index](map["flowInventory"]!["functions"]![0]!.AsObject());
+            var error = Record.Exception(() => CodeMapJson.Read(map.ToJsonString()));
+            Assert.True(error is CallAtlasException, $"Mutation {index} returned {error?.GetType().Name ?? "no error"}");
+        }
+    }
+
+    [Fact]
+    public void Dispatch_candidates_references_and_delegate_calls_remain_distinct()
+    {
+        var map = Snapshot("interface I { int M(); } class A:I { public int M()=>1; } class B:I { public int M()=>2; } class Caller { int Run(I x) { System.Func<int> f=x.M; return x.M()+f(); } }");
+        var calls = Objects(Function(map, "Caller::Run(I)").GetProperty("body")).Where(o => o.TryGetProperty("targets", out _)).ToArray();
+        Assert.Contains(calls, c => c.GetProperty("targets").EnumerateArray().Any(t => t.GetProperty("certainty").GetString() == "reference"));
+        var dispatch = Assert.Single(calls, c => c.GetProperty("targets").EnumerateArray().Any(t => t.GetProperty("certainty").GetString() == "dispatch"));
+        Assert.Equal(2, dispatch.GetProperty("targets").EnumerateArray().Count(t => t.GetProperty("certainty").GetString() == "possible"));
+        Assert.Contains(calls, c => c.GetProperty("targets").EnumerateArray().Any(t => t.GetProperty("certainty").GetString() == "delegate"));
+    }
+
+    [Fact]
+    public void Depth_budget_and_top_level_size_budget_have_whole_callable_spans()
+    {
+        var deep = "class A { int Run() => " + new string('(', 80) + "1" + new string(')', 80) + "; }";
+        var function = Function(Snapshot(deep), "A::Run()");
+        Assert.Equal("unsupported", function.GetProperty("body")[0].GetProperty("kind").GetString());
+        var topSource = string.Concat(Enumerable.Repeat("System.Console.WriteLine(1);", 1600));
+        var top = Assert.Single(Snapshot(topSource).GetProperty("flowInventory").GetProperty("functions").EnumerateArray());
+        var opaque = Assert.Single(top.GetProperty("body").EnumerateArray());
+        Assert.Equal(topSource.Length, opaque.GetProperty("span").GetProperty("end").GetInt32());
+        Assert.True(opaque.GetProperty("text").GetString()!.Length < 100);
+    }
+
+    [Fact]
+    public void Mismatched_disk_source_has_no_guessed_byte_location()
+    {
+        var path = Path.GetTempFileName();
+        try
+        {
+            File.WriteAllText(path, "class A { int Run() => 2; }");
+            var map = JsonDocument.Parse(CodeMapJson.Write(CallGraphBuilder.Build([(path, "class A { int Run() => 1; }")], Path.GetDirectoryName(path)!))).RootElement;
+            var function = Function(map, "A::Run()");
+            Assert.Equal(0, function.GetProperty("span").GetProperty("end").GetInt32());
+            Assert.Contains(function.GetProperty("diagnostics").EnumerateArray(), d => d.GetString()!.Contains("differs"));
+        }
+        finally { File.Delete(path); }
+    }
+
+    [Fact]
+    public void Overloaded_short_circuit_and_property_assignments_are_opaque()
+    {
+        var map = Snapshot("struct Flag { public static bool operator true(Flag f)=>true; public static bool operator false(Flag f)=>false; public static Flag operator &(Flag a,Flag b)=>a; } class A { static Flag Hit()=>new Flag(); Flag Run(Flag a)=>a && Hit(); int P {get;set;} void Set()=>P=HitInt(); static int HitInt()=>1; }");
+        foreach (var suffix in new[] { "A::Run(Flag)", "A::Set()" })
+        {
+            var body = Function(map, suffix).GetProperty("body");
+            Assert.Equal("unsupported", body[0].GetProperty("kind").GetString());
+            Assert.DoesNotContain(Objects(body), o => o.TryGetProperty("targets", out _));
+        }
+    }
+
+    [Fact]
+    public void User_defined_truth_and_contextual_conversions_are_opaque()
+    {
+        var map = Snapshot("struct Flag { public static bool operator true(Flag f)=>true; public static bool operator false(Flag f)=>false; public static implicit operator int(Flag f)=>1; } class A { int Branch(Flag f) { if(f) return 1; return 0; } int Return(Flag f)=>f; int Argument(Flag f)=>Take(f); static int Take(int x)=>x; }");
+        foreach (var suffix in new[] { "A::Branch(Flag)", "A::Return(Flag)", "A::Argument(Flag)" })
+        {
+            var function = Function(map, suffix);
+            Assert.Equal("unsupported", function.GetProperty("body")[0].GetProperty("kind").GetString());
+            Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+        }
+    }
+
+    [Fact]
+    public void Large_declaration_and_switch_label_lists_are_bounded_before_materialization()
+    {
+        var declarations = "class A { void Run() { int " + string.Join(",", Enumerable.Range(0, 1600).Select(i => "x" + i)) + "; } }";
+        var cases = "class A { void Run(int x) { switch(x) {" + string.Concat(Enumerable.Range(0, 1600).Select(i => "case " + i + ":")) + "return; } } }";
+        foreach (var (source, suffix) in new[] { (declarations, "A::Run()"), (cases, "A::Run(System.Int32)") })
+        {
+            var function = Function(Snapshot(source), suffix);
+            Assert.Single(function.GetProperty("body").EnumerateArray());
+            Assert.Equal("unsupported", function.GetProperty("body")[0].GetProperty("kind").GetString());
+            Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+        }
+    }
+
+    [Fact]
+    public void Excessive_dispatch_candidates_make_callable_explicitly_unsupported()
+    {
+        var source = "interface I { int M(); } " + string.Concat(Enumerable.Range(0, 1501)
+            .Select(i => "class C" + i + ":I { public int M()=>1; }")) + "class Caller { int Run(I x)=>x.M(); }";
+        var function = Function(Snapshot(source), "Caller::Run(I)");
+        Assert.Equal("unsupported", function.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.Contains(function.GetProperty("diagnostics").EnumerateArray(), d => d.GetString()!.Contains("binding exceeds"));
+    }
+
+    [Fact]
+    public void Dynamic_operations_are_opaque_but_dynamic_local_values_are_not()
+    {
+        var map = Snapshot("class A { dynamic Unary(dynamic x)=>-x; dynamic Member(dynamic x)=>x.Prop; dynamic Index(dynamic x)=>x[0]; int Convert(dynamic x)=>x; dynamic Value(dynamic x)=>x; }");
+        foreach (var name in new[] { "Unary", "Member", "Index", "Convert" })
+        {
+            var function = Function(map, "A::" + name + "(dynamic)");
+            Assert.Equal("unsupported", function.GetProperty("body")[0].GetProperty("kind").GetString());
+        }
+        Assert.Empty(Function(map, "A::Value(dynamic)").GetProperty("diagnostics").EnumerateArray());
+    }
+
+    [Fact]
+    public void Nameof_intrinsic_does_not_evaluate_its_operand()
+    {
+        var map = Snapshot("class A { A Child=>this; int Value=>1; string Run()=>nameof(Child.Value); }");
+        var body = Function(map, "A::Run()").GetProperty("body");
+        var value = Assert.Single(Objects(body), o => o.TryGetProperty("kind", out var kind) && kind.GetString() == "value");
+        Assert.Equal("nameof(Child.Value)", value.GetProperty("text").GetString());
+        Assert.Empty(value.GetProperty("calls").EnumerateArray());
+    }
+
+    [Fact]
+    public void User_method_named_nameof_retains_argument_evaluation_and_reports_missing_native_binding()
+    {
+        var map = Snapshot("class A { static int Hit()=>1; static int @nameof(int value)=>value; int Run()=>@nameof(Hit()); }");
+        var calls = Objects(Function(map, "A::Run()").GetProperty("body")).Where(o => o.TryGetProperty("targets", out _)).ToArray();
+        var argument = Assert.Single(calls, c => c.GetProperty("label").GetString() == "Hit()");
+        Assert.EndsWith("A::Hit()", argument.GetProperty("targets")[0].GetProperty("symbol").GetString());
+        var invocation = Assert.Single(calls, c => c.GetProperty("label").GetString() == "@nameof(Hit())");
+        Assert.Empty(invocation.GetProperty("targets").EnumerateArray());
+        Assert.Contains("Native analyzer omitted", invocation.GetProperty("diagnostic").GetString());
+    }
+}
