+using System.Text.Json.Nodes;
+using CallAtlas.Core;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowExecutionValidationTests
+{
+    [Theory]
+    [InlineData("execution", "null")]
+    [InlineData("execution", "\"Synchronous\"")]
+    [InlineData("execution", "\"SYNCHRONOUS\"")]
+    [InlineData("execution", "\"1\"")]
+    [InlineData("call", "{\"timing\":\"Synchronous\"}")]
+    [InlineData("call", "{\"dispatch\":\"Direct\"}")]
+    [InlineData("call", "{\"dispatch\":\"DIRECT\"}")]
+    [InlineData("call", "{\"dispatch\":\"1\"}")]
+    [InlineData("execution", "1")]
+    [InlineData("execution", "\"guessed\"")]
+    [InlineData("call", "null")]
+    [InlineData("call", "{\"timing\":null}")]
+    [InlineData("call", "{\"timing\":1}")]
+    [InlineData("call", "{\"dispatch\":null}")]
+    [InlineData("call", "{\"isolated_ordered\":null}")]
+    [InlineData("call", "{\"dispatch\":1}")]
+    [InlineData("call", "{\"dispatch\":\"guessed\"}")]
+    [InlineData("call", "{\"timing\":\"synchronous\",\"isolated_ordered\":true,\"extra\":true}")]
+    [InlineData("call", "{\"isolated_ordered\":true}")]
+    public void Invalid_fact_states_fail_at_the_json_boundary(string field, string json)
+    {
+        var (map, function, value) = Sample();
+        if(field=="execution") function[field]=JsonNode.Parse(json);
+        else value["calls"]![0]!["invocation"]=JsonNode.Parse(json);
+        Assert.Throws<CallAtlasException>(()=>CodeMapJson.Read(map.ToJsonString()));
+    }
+
+    [Theory]
+    [InlineData("zero")]
+    [InlineData("different")]
+    [InlineData("multiple")]
+    [InlineData("targets")]
+    [InlineData("action")]
+    public void Positive_claims_require_their_structural_owner(string invalid)
+    {
+        var (map, function, value) = Sample();
+        var call=value["calls"]![0]!;
+        call["invocation"]=JsonNode.Parse("""{"timing":"synchronous","dispatch":"direct","isolated_ordered":true}""");
+        switch(invalid)
+        {
+            case "zero": value["span"]=JsonNode.Parse("""{"start":0,"end":0}""");call["span"]=value["span"]!.DeepClone();break;
+            case "different": call["span"]!["start"]=call["span"]!["start"]!.GetValue<int>()+1;break;
+            case "multiple": value["calls"]!.AsArray().Add(call.DeepClone());break;
+            case "targets": var target=call["targets"]![0]!.DeepClone();target["symbol"]="other";call["targets"]!.AsArray().Add(target);break;
+            case "action": function["body"]![0]!["kind"]="action";function["body"]![0]!["calls"]=value["calls"]!.DeepClone();break;
+        }
+        Assert.Throws<CallAtlasException>(()=>CodeMapJson.Read(map.ToJsonString()));
+    }
+
+    private static (JsonNode Map,JsonNode Function,JsonNode Value) Sample()
+    {
+        var map=JsonNode.Parse(Snapshot("class A { static int Leaf()=>1; int Run()=>Leaf(); }").GetRawText())!;
+        var function=map["flowInventory"]!["functions"]!.AsArray().Single(f=>f!["symbol"]!.GetValue<string>().EndsWith("A::Run()"))!;
+        return(map,function,function["body"]![0]!["value"]!);
+    }
+}
