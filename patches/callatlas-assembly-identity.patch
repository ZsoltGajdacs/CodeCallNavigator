@@ -0,0 +1,56 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace CallAtlas.Core;
+
+// Shared IR tokens are case-sensitive. The built-in enum converter accepts aliases
+// such as Synchronous, which Rust correctly rejects; keep these two contracts exact.
+internal sealed class FlowExecutionTimingJson : JsonConverter<FlowExecutionTiming>
+{
+    public override FlowExecutionTiming Read(ref Utf8JsonReader reader, Type type, JsonSerializerOptions options)
+        => FlowFactToken.Read(ref reader) switch
+        {
+            "unknown" => FlowExecutionTiming.Unknown,
+            "synchronous" => FlowExecutionTiming.Synchronous,
+            "deferred" => FlowExecutionTiming.Deferred,
+            _ => throw new JsonException("Unknown execution timing"),
+        };
+
+    public override void Write(Utf8JsonWriter writer, FlowExecutionTiming value, JsonSerializerOptions options)
+        => writer.WriteStringValue(value switch
+        {
+            FlowExecutionTiming.Unknown => "unknown",
+            FlowExecutionTiming.Synchronous => "synchronous",
+            FlowExecutionTiming.Deferred => "deferred",
+            _ => throw new JsonException("Unknown execution timing"),
+        });
+}
+
+internal sealed class FlowInvocationDispatchJson : JsonConverter<FlowInvocationDispatch>
+{
+    public override FlowInvocationDispatch Read(ref Utf8JsonReader reader, Type type, JsonSerializerOptions options)
+        => FlowFactToken.Read(ref reader) switch
+        {
+            "unknown" => FlowInvocationDispatch.Unknown,
+            "direct" => FlowInvocationDispatch.Direct,
+            "virtual" => FlowInvocationDispatch.Virtual,
+            "candidate" => FlowInvocationDispatch.Candidate,
+            _ => throw new JsonException("Unknown invocation dispatch"),
+        };
+
+    public override void Write(Utf8JsonWriter writer, FlowInvocationDispatch value, JsonSerializerOptions options)
+        => writer.WriteStringValue(value switch
+        {
+            FlowInvocationDispatch.Unknown => "unknown",
+            FlowInvocationDispatch.Direct => "direct",
+            FlowInvocationDispatch.Virtual => "virtual",
+            FlowInvocationDispatch.Candidate => "candidate",
+            _ => throw new JsonException("Unknown invocation dispatch"),
+        });
+}
+
+internal static class FlowFactToken
+{
+    internal static string Read(ref Utf8JsonReader reader) => reader.TokenType == JsonTokenType.String
+        ? reader.GetString()! : throw new JsonException("Flow fact must be an exact string token");
+}
diff --git a/src/CallAtlas.Core/FlowExport.cs b/src/CallAtlas.Core/FlowExport.cs
new file mode 100644
index 0000000..c70d0f4
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExport.cs
@@ -0,0 +1,95 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed record FlowInput(string Symbol, SyntaxTree Tree, SemanticModel Model, IReadOnlyList<SyntaxNode> Bodies, IMethodSymbol? Declaration);
+
+internal static class FlowExport
+{
+    internal static FlowInventory Build(IEnumerable<FlowInput> inputs, IReadOnlyDictionary<string, Node> nodes,
+        FlowBindings bindings, string root)
+    {
+        var functions = new List<FunctionFlow>();
+        var ownership = new FlowOwnership();
+        var sources = new Dictionary<SyntaxTree, FlowSource>();
+        foreach (var group in inputs.GroupBy(i => i.Symbol).OrderBy(g => g.Key, StringComparer.Ordinal))
+        {
+            if (!nodes.TryGetValue(group.Key, out var node) || node.Kind is not ("method" or "accessor" or "localfunction" or "toplevel"))
+                continue;
+            var owned = ownership.Select(group.ToArray(), node, root);
+            if (owned is null) continue;
+            var first = owned.Input;
+            if (!sources.TryGetValue(first.Tree, out var source)) sources[first.Tree] = source = new FlowSource(first.Tree, root);
+            var bodies = owned.Bodies;
+            var span = new FlowSpan(source.Span(bodies[0]).Start, source.Span(bodies[^1]).End);
+            var exporter = new FlowBody(group.Key, first.Model, source, bindings);
+            var body = exporter.Export(bodies);
+            var function = new FunctionFlow(group.Key, first.Tree.FilePath, "", first.Model.Compilation.AssemblyName ?? "",
+                "csharp", span, body, exporter.Diagnostics.ToArray())
+            { Execution = FlowExecution.Classify(first, bodies) };
+            try { FlowValidation.ValidateBody(function); }
+            catch (FlowUnsupported)
+            {
+                function = function with
+                {
+                    Body = [new("unsupported", span) { Text = "Callable exceeds flow export budget", Reason = "Flow export exceeds 1500 IR nodes" }],
+                    Diagnostics = [.. function.Diagnostics, "Flow export exceeds 1500 IR nodes"],
+                };
+            }
+            functions.Add(function);
+        }
+        return new(1, functions);
+    }
+}
+
+internal sealed class FlowUnsupported(string reason, bool limit = false) : Exception(reason)
+{
+    internal bool Limit { get; } = limit;
+}
+
+internal sealed partial class FlowBody(string symbol, SemanticModel model, FlowSource source, FlowBindings bindings)
+{
+    private int nodes;
+    internal List<string> Diagnostics { get; } = [];
+
+    internal IReadOnlyList<FlowStatement> Export(IReadOnlyList<SyntaxNode> bodies)
+    {
+        try
+        {
+            if (bindings.Exceeded(symbol)) throw new FlowUnsupported("Flow binding exceeds 1500 sites or targets per callable", true);
+            if (source.Problem is not null) throw new FlowUnsupported(source.Problem, true);
+            if (bodies.Any(FlowSuspension.IsAsyncOrIterator))
+                throw new FlowUnsupported("Async/iterator execution and suspension are opaque", true);
+            if (bodies.All(body => body.Parent is GlobalStatementSyntax))
+                return LexicalBody(bodies.Cast<StatementSyntax>().ToArray(), 0, 0);
+            return bodies.SelectMany(body => Body(body, 0)).ToArray();
+        }
+        catch (FlowUnsupported problem)
+        {
+            Diagnostics.Add(problem.Message);
+            var span = new FlowSpan(source.Span(bodies[0]).Start, source.Span(bodies[^1]).End);
+            return [new("unsupported", span) { Text = "Callable source flow unavailable", Reason = problem.Message }];
+        }
+    }
+
+    private void Budget(int depth)
+    {
+        if (depth > 24 || ++nodes > 1500)
+            throw new FlowUnsupported("Flow export exceeds 24 nested levels or 1500 IR nodes", true);
+    }
+
+    private IReadOnlyList<FlowStatement> Body(SyntaxNode body, int depth) => body switch
+    {
+        BlockSyntax block => LexicalBody(block.Statements, 0, depth),
+        ArrowExpressionClauseSyntax arrow => [new("return", source.Span(arrow)) { Value = Expression(arrow.Expression, depth + 1) }],
+        StatementSyntax statement => [Statement(statement, depth + 1)],
+        _ => [Opaque(body, "Unsupported callable body")],
+    };
+
+    private FlowStatement Opaque(SyntaxNode node, string reason)
+    {
+        if (!Diagnostics.Contains(reason)) Diagnostics.Add(reason);
+        return new("unsupported", source.Span(node)) { Text = FlowText.Label(node), Reason = reason };
+    }
+}
diff --git a/src/CallAtlas.Core/FlowExpressionValidation.cs b/src/CallAtlas.Core/FlowExpressionValidation.cs
new file mode 100644
index 0000000..23f3276
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExpressionValidation.cs
@@ -0,0 +1,53 @@
+namespace CallAtlas.Core;
+
+internal static partial class FlowValidation
+{
+    private static void Expression(FlowExpression node, FlowSpan owner, Stack<object> pending)
+    {
+        CheckSpan(node.Span, owner);
+        switch (node.Kind)
+        {
+            case "sequence": PushAll(pending, node.Items); break;
+            case "and": case "or": Push(pending, node.Left); Push(pending, node.Right); break;
+            case "conditional": Push(pending, node.Condition); Push(pending, node.WhenTrue); Push(pending, node.WhenFalse); break;
+            case "value": ValueCalls(node, owner); break;
+            default: throw Invalid("Unknown expression kind");
+        }
+    }
+
+    private static void ValueCalls(FlowExpression node, FlowSpan owner)
+    {
+        Require(node.Text is not null);
+        Require(node.Calls is not null);
+        foreach (var call in node.Calls!)
+        {
+            Call(call, owner);
+            if (call.Invocation.IsolatedOrdered)
+            {
+                Require(call.Invocation.Timing == FlowExecutionTiming.Synchronous);
+                Require(node.Calls.Count == 1);
+                Require(node.Span.Start < node.Span.End && node.Span == call.Span);
+            }
+        }
+    }
+
+    private static void Call(FlowCall? call, FlowSpan owner)
+    {
+        Require(call is not null);
+        Require(call!.Label is not null);
+        Require(call.Targets is not null);
+        CheckSpan(call.Span, owner);
+        foreach (var target in call.Targets!) Target(target);
+        if (call.Invocation.Dispatch == FlowInvocationDispatch.Direct)
+            Require(call.Targets!.Where(target => target.Kind == "call").Select(target => target.Symbol).Distinct().Take(2).Count() <= 1);
+    }
+
+    private static void Target(FlowTarget? target)
+    {
+        Require(target is not null);
+        Require(!string.IsNullOrEmpty(target!.Symbol));
+        Require(!string.IsNullOrEmpty(target.Certainty));
+        Require(!string.IsNullOrEmpty(target.Provenance));
+        Require(target.Kind == "call");
+    }
+}
diff --git a/src/CallAtlas.Core/FlowExpressions.cs b/src/CallAtlas.Core/FlowExpressions.cs
new file mode 100644
index 0000000..29109ea
--- /dev/null
+++ b/src/CallAtlas.Core/FlowExpressions.cs
@@ -0,0 +1,149 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.CodeAnalysis.Operations;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowExpression Expression(ExpressionSyntax expression, int depth)
+    {
+        Budget(depth);
+        var conversion = model.GetConversion(expression);
+        if (conversion.IsUserDefined || conversion.IsDynamic)
+            throw new FlowUnsupported("User-defined or dynamic conversion evaluation is opaque");
+        return expression switch
+        {
+            ConditionalExpressionSyntax conditional => new("conditional", source.Span(expression))
+            {
+                Condition = Condition(conditional.Condition, depth + 1), WhenTrue = Expression(conditional.WhenTrue, depth + 1),
+                WhenFalse = Expression(conditional.WhenFalse, depth + 1),
+            },
+            BinaryExpressionSyntax binary => Binary(binary, depth),
+            AssignmentExpressionSyntax assignment => Assignment(assignment, depth),
+            _ => OrderedExpression(expression, depth),
+        };
+    }
+
+    private FlowExpression OrderedExpression(ExpressionSyntax expression, int depth) => expression switch
+    {
+            ParenthesizedExpressionSyntax parenthesized => Expression(parenthesized.Expression, depth + 1),
+            InvocationExpressionSyntax invocation => Invocation(invocation, depth),
+            MemberAccessExpressionSyntax member => Member(member, depth),
+            ElementAccessExpressionSyntax element => Element(element, depth),
+            BaseObjectCreationExpressionSyntax creation when creation.Initializer is null => Sequence(creation,
+                (creation.ArgumentList?.Arguments.Select(a => Expression(a.Expression, depth + 1)) ?? []).Append(Value(creation)).ToArray()),
+            _ => AtomicExpression(expression, depth),
+    };
+
+    private FlowExpression AtomicExpression(ExpressionSyntax expression, int depth) => expression switch
+    {
+            LiteralExpressionSyntax or IdentifierNameSyntax or ThisExpressionSyntax or BaseExpressionSyntax
+                or TypeOfExpressionSyntax or DefaultExpressionSyntax => Value(expression),
+            PrefixUnaryExpressionSyntax prefix => Unary(prefix, prefix.Operand, depth),
+            PostfixUnaryExpressionSyntax postfix => postfix.IsKind(SyntaxKind.SuppressNullableWarningExpression)
+                ? Expression(postfix.Operand, depth + 1) : Unary(postfix, postfix.Operand, depth),
+            CastExpressionSyntax cast when model.GetSymbolInfo(cast).Symbol is not IMethodSymbol =>
+                Sequence(cast, [Expression(cast.Expression, depth + 1), Value(cast)]),
+            _ => throw new FlowUnsupported($"Unsupported {expression.Kind()} expression evaluation"),
+    };
+
+    private FlowExpression Condition(ExpressionSyntax expression, int depth)
+    {
+        if (model.GetTypeInfo(expression).Type?.SpecialType != SpecialType.System_Boolean)
+            throw new FlowUnsupported("User-defined truth conversion/operator is opaque");
+        return Expression(expression, depth);
+    }
+
+    private void StaticReceiver(ExpressionSyntax expression)
+    {
+        if (model.GetTypeInfo(expression).Type?.TypeKind == TypeKind.Dynamic)
+            throw new FlowUnsupported("Dynamic member/indexer/operator evaluation is opaque");
+    }
+
+    private FlowExpression Member(MemberAccessExpressionSyntax member, int depth)
+    {
+        StaticReceiver(member.Expression);
+        return Sequence(member, [Expression(member.Expression, depth + 1), Value(member)]);
+    }
+
+    private FlowExpression Element(ElementAccessExpressionSyntax element, int depth)
+    {
+        StaticReceiver(element.Expression);
+        return Sequence(element,
+            new[] { Expression(element.Expression, depth + 1) }.Concat(element.ArgumentList.Arguments.Select(a => Expression(a.Expression, depth + 1)))
+                .Append(Value(element)).ToArray());
+    }
+
+    private FlowExpression Invocation(InvocationExpressionSyntax invocation, int depth)
+    {
+        var operation = model.GetOperation(invocation);
+        if (operation is INameOfOperation) return Value(invocation) with { Calls = [] };
+        if (operation is IDynamicInvocationOperation)
+            throw new FlowUnsupported("Dynamic invocation is opaque");
+        var values = new List<FlowExpression>();
+        if (invocation.Expression is MemberAccessExpressionSyntax member)
+            values.Add(Expression(member.Expression, depth + 1));
+        else if (invocation.Expression is not (IdentifierNameSyntax or GenericNameSyntax))
+            throw new FlowUnsupported("Conditional/dynamic invocation receiver is opaque");
+        values.AddRange(invocation.ArgumentList.Arguments.Select(a => Expression(a.Expression, depth + 1)));
+        values.Add(InvocationValue(invocation, operation));
+        return Sequence(invocation, values);
+    }
+
+    private FlowExpression InvocationValue(InvocationExpressionSyntax invocation, IOperation? operation)
+    {
+        var value = Value(invocation);
+        if (operation is not IInvocationOperation invocationOperation) return value;
+        if (value.Calls is not { Count: > 0 })
+        {
+            // Preserve native graph limitations; compiler facts never invent a graph target.
+            value = value with { Calls = [new(source.Span(invocation), FlowText.Label(invocation), [],
+                "Native analyzer omitted binding for this compiler-resolved invocation")] };
+        }
+        return FlowInvocationProof.Apply(value, invocationOperation);
+    }
+
+    private FlowExpression Binary(BinaryExpressionSyntax binary, int depth)
+    {
+        if (binary.IsKind(SyntaxKind.CoalesceExpression)) throw new FlowUnsupported("Null-coalescing evaluation is opaque");
+        if (model.GetOperation(binary) is IBinaryOperation { OperatorMethod: not null })
+            throw new FlowUnsupported("Overloaded operator evaluation is opaque");
+        if (model.GetTypeInfo(binary.Left).Type?.TypeKind == TypeKind.Dynamic
+            || model.GetTypeInfo(binary.Right).Type?.TypeKind == TypeKind.Dynamic)
+            throw new FlowUnsupported("Dynamic operator evaluation is opaque");
+        var left = Expression(binary.Left, depth + 1);
+        var right = Expression(binary.Right, depth + 1);
+        if (binary.IsKind(SyntaxKind.LogicalAndExpression) || binary.IsKind(SyntaxKind.LogicalOrExpression))
+            return new(binary.IsKind(SyntaxKind.LogicalAndExpression) ? "and" : "or", source.Span(binary)) { Left = left, Right = right };
+        return Sequence(binary, [left, right, Value(binary)]);
+    }
+
+    private FlowExpression Assignment(AssignmentExpressionSyntax assignment, int depth)
+    {
+        if (!assignment.IsKind(SyntaxKind.SimpleAssignmentExpression)
+            || model.GetSymbolInfo(assignment.Left).Symbol is not (ILocalSymbol or IParameterSymbol or IFieldSymbol))
+            throw new FlowUnsupported("Accessor/compound assignment order is opaque");
+        return Sequence(assignment, [Expression(assignment.Left, depth + 1), Expression(assignment.Right, depth + 1), Value(assignment)]);
+    }
+
+    private FlowExpression Unary(ExpressionSyntax expression, ExpressionSyntax operand, int depth)
+    {
+        StaticReceiver(operand);
+        if (model.GetSymbolInfo(expression).Symbol is IMethodSymbol { MethodKind: not MethodKind.BuiltinOperator }
+            || model.GetSymbolInfo(operand).Symbol is IPropertySymbol)
+            throw new FlowUnsupported("Overloaded/accessor unary evaluation is opaque");
+        return Sequence(expression, [Expression(operand, depth + 1), Value(expression)]);
+    }
+
+    private FlowExpression Value(SyntaxNode node, string? text = null)
+    {
+        Budget(0);
+        return new("value", source.Span(node))
+        { Text = text is null ? FlowText.Label(node) : FlowText.Bounded(text), Calls = bindings.At(symbol, node, source) };
+    }
+
+    private FlowExpression Sequence(SyntaxNode node, IReadOnlyList<FlowExpression> items) =>
+        items.Count == 1 ? items[0] : new("sequence", source.Span(node)) { Items = items };
+}
diff --git a/src/CallAtlas.Core/FlowForeach.cs b/src/CallAtlas.Core/FlowForeach.cs
new file mode 100644
index 0000000..4886b0b
--- /dev/null
+++ b/src/CallAtlas.Core/FlowForeach.cs
@@ -0,0 +1,82 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Foreach(ForEachStatementSyntax statement, int depth)
+    {
+        if (!statement.AwaitKeyword.IsKind(SyntaxKind.None))
+            return OpaqueCompletion(statement, "Await foreach execution and suspension are opaque");
+        try
+        {
+            var guard = ForeachProof(statement);
+            Budget(depth + 2); // Acquisition protection and loop are synthetic scopes.
+            var acquire = Sequence(statement, [Expression(statement.Expression, depth + 1),
+                SyntheticValue(statement, "capture foreach collection once"),
+                ImplicitCall(statement, ImplicitFlowOperation.GetEnumerator, "collection"),
+                SyntheticValue(statement, "capture foreach enumerator once")]);
+            var body = new List<FlowStatement>
+            {
+                EvaluateSynthetic(statement, ImplicitCall(statement, ImplicitFlowOperation.Current, "enumerator")),
+                EvaluateSynthetic(statement, SyntheticValue(statement, "assign iteration variable " + FlowText.Bounded(statement.Identifier.ValueText))),
+            };
+            body.AddRange(Body(statement.Statement, depth + 2));
+            var loop = new FlowStatement("loop", source.Span(statement))
+            { Condition = ImplicitCall(statement, ImplicitFlowOperation.MoveNext, "enumerator"), Body = body, Update = [], TestFirst = true };
+            return Protected(statement, [loop]) with
+            {
+                Resources = [EvaluateSynthetic(statement, acquire)],
+                Cleanup = [Dispose(statement, "enumerator", guard)],
+            };
+        }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return OpaqueCompletion(statement, problem.Message); }
+    }
+
+    private CleanupGuard ForeachProof(ForEachStatementSyntax statement)
+    {
+        ProveCollection(statement);
+        var info = model.GetForEachStatementInfo(statement);
+        ProveEnumeratorOperations(info);
+        if (!info.ElementConversion.IsIdentity || !info.CurrentConversion.IsIdentity)
+            throw new FlowUnsupported("Foreach element/current conversions are opaque");
+        return EnumeratorDisposal(info.GetEnumeratorMethod!.ReturnType, info.DisposeMethod);
+    }
+
+    private void ProveCollection(ForEachStatementSyntax statement)
+    {
+        var collection = model.GetTypeInfo(statement.Expression).Type;
+        if (collection is null) throw new FlowUnsupported("Foreach collection type is unresolved");
+        if (collection.TypeKind is TypeKind.Dynamic or TypeKind.Array)
+            throw new FlowUnsupported("Dynamic/array foreach lowering is opaque");
+        if (collection.SpecialType == SpecialType.System_String)
+            throw new FlowUnsupported("String foreach lowering is opaque");
+        if (statement.Type is RefTypeSyntax) throw new FlowUnsupported("Ref iteration is opaque");
+    }
+
+    private static void ProveEnumeratorOperations(ForEachStatementInfo info)
+    {
+        if (info.IsAsynchronous) throw new FlowUnsupported("Asynchronous enumerator operations are opaque");
+        if (info.GetEnumeratorMethod is null) throw new FlowUnsupported("Foreach GetEnumerator is unresolved");
+        if (info.MoveNextMethod is null) throw new FlowUnsupported("Foreach MoveNext is unresolved");
+        if (info.CurrentProperty is null) throw new FlowUnsupported("Foreach Current is unresolved");
+    }
+
+    private CleanupGuard EnumeratorDisposal(ITypeSymbol enumerator, IMethodSymbol? dispose)
+    {
+        if (enumerator.IsRefLikeType || enumerator.TypeKind is TypeKind.Dynamic or TypeKind.TypeParameter)
+            throw new FlowUnsupported("Ref-like/dynamic/generic enumerator cleanup is opaque");
+        var disposable = model.Compilation.GetSpecialType(SpecialType.System_IDisposable);
+        var conversion = ((CSharpCompilation)model.Compilation).ClassifyConversion(enumerator, disposable);
+        if (conversion.IsImplicit && !conversion.IsUserDefined)
+        {
+            if (dispose is null) throw new FlowUnsupported("Compiler did not expose the required enumerator disposal operation");
+            return DisposableGuard(enumerator);
+        }
+        if (enumerator.IsSealed) return CleanupGuard.Never;
+        if (enumerator.IsReferenceType) return CleanupGuard.RuntimeDisposable;
+        throw new FlowUnsupported("Enumerator disposal category is unresolved");
+    }
+}
diff --git a/src/CallAtlas.Core/FlowInvocationProof.cs b/src/CallAtlas.Core/FlowInvocationProof.cs
new file mode 100644
index 0000000..17e5220
--- /dev/null
+++ b/src/CallAtlas.Core/FlowInvocationProof.cs
@@ -0,0 +1,34 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.Operations;
+
+namespace CallAtlas.Core;
+
+/// <summary>Only the explicit final invocation Value owns compiler activation/order proof.</summary>
+internal static class FlowInvocationProof
+{
+    internal static FlowExpression Apply(FlowExpression value, IInvocationOperation operation)
+    {
+        if (!SupportedOperation(operation) || !IsolatedValue(value)) return value;
+        var facts = new FlowInvocationFacts(FlowExecutionTiming.Synchronous, Dispatch(operation), true);
+        return value with { Calls = [value.Calls![0] with { Invocation = facts }] };
+    }
+
+    private static bool SupportedOperation(IInvocationOperation operation) => !operation.IsImplicit
+        && PlainTarget(operation.TargetMethod)
+        && operation.Arguments.All(argument => argument.Parameter?.RefKind == RefKind.None);
+
+    private static bool PlainTarget(IMethodSymbol target) => target is
+        { IsImplicitlyDeclared: false, ReducedFrom: null, IsExtensionMethod: false,
+          ReturnsByRef: false, ReturnsByRefReadonly: false, MethodKind: MethodKind.Ordinary or MethodKind.LocalFunction };
+
+    private static bool IsolatedValue(FlowExpression value) => value.Calls is { Count: 1 }
+        && value.Span.Start < value.Span.End && value.Calls[0].Span == value.Span;
+
+    private static FlowInvocationDispatch Dispatch(IInvocationOperation operation)
+    {
+        var target = operation.TargetMethod;
+        var virtualTarget = target is { IsVirtual: true } or { IsAbstract: true } or { IsOverride: true }
+            || target.ContainingType.TypeKind == TypeKind.Interface;
+        return operation.IsVirtual || virtualTarget ? FlowInvocationDispatch.Virtual : FlowInvocationDispatch.Direct;
+    }
+}
diff --git a/src/CallAtlas.Core/FlowJson.cs b/src/CallAtlas.Core/FlowJson.cs
new file mode 100644
index 0000000..3052879
--- /dev/null
+++ b/src/CallAtlas.Core/FlowJson.cs
@@ -0,0 +1,73 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace CallAtlas.Core;
+
+internal static class FlowJson
+{
+    internal static readonly JsonSerializerOptions Options = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+        MaxDepth = 128,
+        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow,
+        Converters = { new FlowExecutionTimingJson(), new FlowInvocationDispatchJson() },
+    };
+
+    internal static void Write(Utf8JsonWriter writer, CodeMap map)
+    {
+        if (map.FlowFactsVersion.Length == 0) return;
+        writer.WriteString("flowFactsVersion", map.FlowFactsVersion);
+        writer.WritePropertyName("flowInventory");
+        JsonSerializer.Serialize(writer, map.FlowInventory, Options);
+    }
+
+    internal static (string Version, FlowInventory? Inventory) Read(JsonElement root)
+    {
+        var version = Capability(root);
+        if (version.Length == 0) return Historical(root);
+        var inventory = Required(root, "flowInventory", JsonValueKind.Object);
+        var ir = Required(inventory, "version", JsonValueKind.Number);
+        if (!ir.TryGetInt32(out var number) || number != 1) throw Invalid("Unsupported inventory version");
+        Required(inventory, "functions", JsonValueKind.Array);
+        return (version, Decode(inventory));
+    }
+
+    private static string Capability(JsonElement root)
+    {
+        var present = root.TryGetProperty("flowFactsVersion", out var value);
+        if (present && value.ValueKind != JsonValueKind.String) throw Invalid("Invalid capability version");
+        var version = present ? value.GetString()! : "";
+        if (version.Length != 0 && version != FlowInventory.CapabilityVersion) throw Invalid("Unsupported capability version");
+        return version;
+    }
+
+    private static (string, FlowInventory?) Historical(JsonElement root)
+    {
+        if (root.TryGetProperty("flowInventory", out _)) throw Invalid("Inventory has no capability version");
+        return ("", null);
+    }
+
+    private static JsonElement Required(JsonElement owner, string name, JsonValueKind kind)
+    {
+        if (!owner.TryGetProperty(name, out var value) || value.ValueKind != kind)
+            throw Invalid($"Missing or invalid {name}");
+        return value;
+    }
+
+    private static FlowInventory Decode(JsonElement inventory)
+    {
+        try
+        {
+            var result = JsonSerializer.Deserialize<FlowInventory>(inventory.GetRawText(), Options)
+                ?? throw Invalid("Incomplete inventory");
+            FlowValidation.Validate(result);
+            return result;
+        }
+        catch (JsonException) { throw Invalid("Malformed inventory"); }
+        catch (FlowUnsupported) { throw Invalid("Inventory exceeds export budget"); }
+    }
+
+    private static CallAtlasException Invalid(string reason) =>
+        new($"{reason} in flow facts; regenerate the snapshot.");
+}
diff --git a/src/CallAtlas.Core/FlowLexicalScopes.cs b/src/CallAtlas.Core/FlowLexicalScopes.cs
new file mode 100644
index 0000000..138624e
--- /dev/null
+++ b/src/CallAtlas.Core/FlowLexicalScopes.cs
@@ -0,0 +1,51 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private IReadOnlyList<FlowStatement> LexicalBody(IReadOnlyList<StatementSyntax> statements, int start, int depth)
+    {
+        var body = new List<FlowStatement>();
+        for (var index = start; index < statements.Count; index++)
+        {
+            if (statements[index] is LocalDeclarationStatementSyntax declaration && !declaration.UsingKeyword.IsKind(SyntaxKind.None))
+            {
+                body.Add(UsingDeclaration(declaration, statements, index + 1, depth + 1));
+                return body;
+            }
+            body.Add(Statement(statements[index], depth + 1));
+        }
+        return body;
+    }
+
+    private FlowStatement UsingDeclaration(LocalDeclarationStatementSyntax declaration,
+        IReadOnlyList<StatementSyntax> statements, int suffix, int depth)
+    {
+        Budget(depth);
+        if (!declaration.AwaitKeyword.IsKind(SyntaxKind.None))
+            return OpaqueContinuation(declaration, statements, "Await using declaration and its remaining lexical scope are opaque");
+        try
+        {
+            var resources = Resources(declaration.Declaration, depth);
+            Budget(depth + resources.Length);
+            var body = LexicalBody(statements, suffix, depth + resources.Length);
+            return UsingScope(declaration, resources, body, depth);
+        }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return OpaqueContinuation(declaration, statements, problem.Message + "; remaining lexical scope is opaque"); }
+    }
+    private FlowStatement OpaqueContinuation(LocalDeclarationStatementSyntax declaration,
+        IReadOnlyList<StatementSyntax> statements, string reason)
+    {
+        var first = source.Span(declaration);
+        var last = source.Span(statements[^1]);
+        var span = new FlowSpan(first.Start, last.End);
+        var result = OpaqueCompletion(declaration, reason);
+        var body = result.Body!.ToArray();
+        body[0] = body[0] with { Span = span, Text = "using declaration and remaining lexical scope" };
+        return result with { Span = span, Body = body };
+    }
+
+}
