+using System.Text.Json.Serialization;
+
+namespace CallAtlas.Core;
+
+/// <summary>Detached source flow. Field names deliberately match the consumer's version-1 IR.</summary>
+public sealed record FlowInventory([property: JsonRequired] int Version,
+    [property: JsonRequired] IReadOnlyList<FunctionFlow> Functions)
+{
+    public const string CapabilityVersion = "2";
+}
+
+public sealed record FunctionFlow([property: JsonRequired] string Symbol, [property: JsonRequired] string File,
+    [property: JsonRequired] string Build, [property: JsonRequired] string Project, [property: JsonRequired] string Language,
+    [property: JsonRequired] FlowSpan Span, [property: JsonRequired] IReadOnlyList<FlowStatement> Body,
+    [property: JsonRequired] IReadOnlyList<string> Diagnostics,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)] FlowExecutionTiming Execution = FlowExecutionTiming.Unknown);
+public sealed record FlowSpan([property: JsonRequired] int Start, [property: JsonRequired] int End);
+public sealed record FlowTarget([property: JsonRequired] string Symbol, [property: JsonRequired] string Certainty,
+    [property: JsonRequired] string Provenance, string Kind = "call");
+public sealed record FlowCall([property: JsonRequired] FlowSpan Span, [property: JsonRequired] string Label,
+    [property: JsonRequired] IReadOnlyList<FlowTarget> Targets, string? Diagnostic,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)] FlowInvocationFacts Invocation = default);
+
+public sealed record FlowStatement([property: JsonRequired] string Kind, [property: JsonRequired] FlowSpan Span)
+{
+    public string? Text { get; init; }
+    public string? Reason { get; init; }
+    public FlowExpression? Value { get; init; }
+    public FlowExpression? Condition { get; init; }
+    public FlowExpression? Subject { get; init; }
+    public IReadOnlyList<FlowStatement>? Body { get; init; }
+    public IReadOnlyList<FlowStatement>? ThenBranch { get; init; }
+    public IReadOnlyList<FlowStatement>? ElseBranch { get; init; }
+    public IReadOnlyList<FlowStatement>? Update { get; init; }
+    public IReadOnlyList<FlowCase>? Cases { get; init; }
+    public IReadOnlyList<FlowStatement>? Resources { get; init; }
+    public IReadOnlyList<FlowCatch>? Catches { get; init; }
+    public IReadOnlyList<FlowStatement>? Finally { get; init; }
+    public IReadOnlyList<FlowStatement>? Cleanup { get; init; }
+    public bool? TestFirst { get; init; }
+    public string? Label { get; init; }
+    public bool? Deferred { get; init; }
+}
+
+public sealed record FlowExpression([property: JsonRequired] string Kind, [property: JsonRequired] FlowSpan Span)
+{
+    public string? Text { get; init; }
+    public IReadOnlyList<FlowCall>? Calls { get; init; }
+    public IReadOnlyList<FlowExpression>? Items { get; init; }
+    public FlowExpression? Left { get; init; }
+    public FlowExpression? Right { get; init; }
+    public FlowExpression? Condition { get; init; }
+    public FlowExpression? WhenTrue { get; init; }
+    public FlowExpression? WhenFalse { get; init; }
+}
+
+public sealed record FlowCase(IReadOnlyList<string> Labels, FlowSpan Span, bool IsDefault,
+    bool FallsThrough, IReadOnlyList<FlowStatement> Body);
+public sealed record FlowCatch([property: JsonRequired] string Parameter, [property: JsonRequired] bool CatchAll,
+    [property: JsonRequired] IReadOnlyList<FlowStatement> Body);
+
+
+/// <summary>Whole-body suitability is independent of activation at a caller's invocation site.</summary>
+public enum FlowExecutionTiming { Unknown, Synchronous, Deferred }
+public enum FlowInvocationDispatch { Unknown, Direct, Virtual, Candidate }
+
+public readonly record struct FlowInvocationFacts(
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)] FlowExecutionTiming Timing = FlowExecutionTiming.Unknown,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)] FlowInvocationDispatch Dispatch = FlowInvocationDispatch.Unknown,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingDefault)] bool IsolatedOrdered = false);
