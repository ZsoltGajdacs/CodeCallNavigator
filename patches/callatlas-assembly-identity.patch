+using System.Text.Json;
+using System.Text.Json.Nodes;
+using CallAtlas.Core;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowExecutionDefaultsTests
+{
+    [Fact]
+    public void Explicit_unknown_and_empty_facts_serialize_as_absent_with_stable_roundtrip_bytes()
+    {
+        var map=JsonNode.Parse(Snapshot("class A { static int Leaf()=>1; int Run()=>Leaf(); }").GetRawText())!;
+        foreach(var function in map["flowInventory"]!["functions"]!.AsArray())
+        {
+            function!["execution"]="unknown";
+            SetDefaultCalls(function);
+        }
+        var saved=CodeMapJson.Write(CodeMapJson.Read(map.ToJsonString()));
+        var inventory=JsonDocument.Parse(saved).RootElement.GetProperty("flowInventory");
+        Assert.All(Objects(inventory),node=>{
+            Assert.False(node.TryGetProperty("execution",out _));
+            Assert.False(node.TryGetProperty("invocation",out _));
+        });
+        Assert.Equal(saved,CodeMapJson.Write(CodeMapJson.Read(saved)));
+    }
+
+    private static void SetDefaultCalls(JsonNode root)
+    {
+        var pending=new Stack<JsonNode>([root]);
+        while(pending.TryPop(out var node))
+        {
+            if(node is JsonObject obj && obj.ContainsKey("targets"))
+                obj["invocation"]=JsonNode.Parse("""{"timing":"unknown","dispatch":"unknown","isolated_ordered":false}""");
+            foreach(var child in Children(node)) pending.Push(child);
+        }
+    }
+
+    private static IEnumerable<JsonNode> Children(JsonNode node) => node switch
+    {
+        JsonObject obj => obj.Select(property=>property.Value).OfType<JsonNode>(),
+        JsonArray array => array.OfType<JsonNode>(),
+        _ => [],
+    };
+}
