+using System.Text.Json;
+using CallAtlas.Core;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+using static CallAtlas.Tests.FlowExecutionFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowInvocationCompilerTests
+{
+    [Fact]
+    public void Activation_is_synchronous_even_when_the_callee_is_async_or_an_iterator()
+    {
+        var map = CheckedSnapshot("using System.Threading.Tasks; using System.Collections.Generic; class A { async Task Async(){await Task.Delay(1);} IEnumerable<int> Iter(){yield return 1;} object Run(){Async();return Iter();} }");
+        var calls = Calls(Function(map,"A::Run()"));
+        Assert.Equal(2,calls.Length);
+        Assert.All(calls,call=>Assert.Equal("synchronous",call.GetProperty("invocation").GetProperty("timing").GetString()));
+        Assert.False(Function(map,"A::Async()").TryGetProperty("execution",out _));
+        Assert.Equal("deferred",Function(map,"A::Iter()").GetProperty("execution").GetString());
+    }
+
+    [Fact]
+    public void Receivers_and_arguments_precede_the_isolated_final_invocation()
+    {
+        var map = CheckedSnapshot("class A { static A Receiver()=>new A(); static int Arg()=>1; int Leaf(int x)=>x; int Run()=>Receiver().Leaf(Arg()); }");
+        var calls = Calls(Function(map,"A::Run()"));
+        Assert.Equal(new[]{"Receiver()","Arg()","Receiver().Leaf(Arg())"},calls.Select(call=>call.GetProperty("label").GetString()));
+        Assert.All(calls,call=>Assert.True(call.GetProperty("invocation").GetProperty("isolated_ordered").GetBoolean()));
+    }
+
+    [Fact]
+    public void Delegate_extension_constructor_accessor_and_reference_facts_remain_unknown()
+    {
+        var map = CheckedSnapshot("using System; static class Extensions { public static int Ext(this int x)=>x; } class A { static int Leaf()=>1; int P=>1; int Ref(ref int x)=>x; int Run(){Func<int> f=Leaf;int x=1;Ref(ref x);var a=new A();return f()+x.Ext()+a.P;} }");
+        var calls = Calls(Function(map,"A::Run()"));
+        Assert.NotEmpty(calls);
+        Assert.All(calls,call=>Assert.False(call.TryGetProperty("invocation",out _)));
+    }
+
+    [Fact]
+    public void Unknown_default_facts_are_absent_and_top_level_suspension_stays_unknown()
+    {
+        var map = CheckedSnapshot("await System.Threading.Tasks.Task.Delay(1); System.Console.WriteLine(1);");
+        var top=Assert.Single(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray());
+        Assert.False(top.TryGetProperty("execution",out _));
+        Assert.Empty(Calls(top));
+    }
+
+    [Fact]
+    public void Local_execution_excludes_nested_iterator_suspension_and_unproven_top_level_stays_unknown()
+    {
+        var map = CheckedSnapshot("using System.Collections.Generic; int Local()=>1; IEnumerable<int> Iter(){yield return 1;} System.Console.WriteLine(Local());");
+        var functions=map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray().ToArray();
+        var local=functions.Single(f=>f.GetProperty("symbol").GetString()!.Contains("Local"));
+        var iterator=functions.Single(f=>f.GetProperty("symbol").GetString()!.Contains("Iter"));
+        var top=functions.Single(f=>f.GetProperty("symbol").GetString()!.Contains("<top-level>"));
+        Assert.Equal("synchronous",local.GetProperty("execution").GetString());
+        Assert.Equal("deferred",iterator.GetProperty("execution").GetString());
+        // The in-memory DLL compilation has no compiler entry point to prove ownership.
+        Assert.False(top.TryGetProperty("execution",out _));
+    }
+
+    private static JsonElement[] Calls(JsonElement function) => Objects(function.GetProperty("body"))
+        .Where(value=>value.TryGetProperty("targets",out _)).ToArray();
+}
