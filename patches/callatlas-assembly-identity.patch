+using CallAtlas.Core;
+using Xunit;
+
+namespace CallAtlas.Tests;
+
+public class MediatRFactsTests
+{
+    [Fact]
+    public void Framework_snapshot_roundtrip_preserves_capability_and_all_facts()
+    {
+        var original = CallGraphBuilder.Build([("a.cs", "class A { void Run() {} }")], root: "/proj") with
+        {
+            FrameworkFactsVersion = "1",
+            FrameworkEdges = [new MediatRDispatchFact
+            {
+                From = "caller", To = "handler", Dispatch = "send", Payload = "[Contracts]::Ping",
+                Handler = "[Application]::Handler", Invocation = new MediatRSourceSite("a.cs", 3, 7),
+                Awaited = true, Conditional = true,
+            }],
+            FrameworkEntries = ["handler"],
+            FrameworkDiagnostics = ["deferred site"],
+        };
+        var read = CodeMapJson.Read(CodeMapJson.Write(original));
+        Assert.Equal("1", read.FrameworkFactsVersion);
+        Assert.Equal(original.FrameworkEdges, read.FrameworkEdges);
+        Assert.Equal(original.FrameworkEntries, read.FrameworkEntries);
+        Assert.Equal(original.FrameworkDiagnostics, read.FrameworkDiagnostics);
+        Assert.Equal(original.Edges, read.Edges);
+    }
+
+    [Fact]
+    public void Historical_snapshot_is_not_relabelled_as_current_framework_facts()
+    {
+        var historical = CodeMapJson.Read("""{"schema":"callatlas.ir.v3","nodes":[],"edges":[]}""");
+        var roundtrip = CodeMapJson.Read(CodeMapJson.Write(historical));
+        Assert.Equal("", roundtrip.FrameworkFactsVersion);
+        Assert.Empty(roundtrip.FrameworkEdges);
+    }
+
+    [Theory]
+    [InlineData("2")]
+    [InlineData("1")]
+    public void Unsupported_or_incomplete_framework_snapshot_is_rejected(string version)
+    {
+        var json = "{\"schema\":\"callatlas.ir.v3\",\"frameworkFactsVersion\":\"" + version + "\"}";
+        Assert.Throws<CallAtlasException>(() => CodeMapJson.Read(json));
+    }
+}
