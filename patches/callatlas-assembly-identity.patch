@@ -0,0 +1,56 @@
+using System.Text;
+using System.Text.Json;
+using CallAtlas.Core;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.Text;
+using Xunit;
+
+namespace CallAtlas.Tests;
+
+public class SourceFactsTests
+{
+    [Fact]
+    public void Current_source_capability_roundtrips_without_claiming_historical_support()
+    {
+        var map = CallGraphBuilder.Build([("a.cs", "class A {}")], "/proj");
+        var current = JsonDocument.Parse(CodeMapJson.Write(map)).RootElement;
+        Assert.Equal("1", current.GetProperty("sourceFactsVersion").GetString());
+        var roundtrip = JsonDocument.Parse(CodeMapJson.Write(CodeMapJson.Read(current.GetRawText()))).RootElement;
+        Assert.Equal("1", roundtrip.GetProperty("sourceFactsVersion").GetString());
+        var historical = JsonDocument.Parse(CodeMapJson.Write(CodeMapJson.Read("""{"schema":"callatlas.ir.v3","nodes":[],"edges":[]}"""))).RootElement;
+        Assert.False(historical.TryGetProperty("sourceFactsVersion", out _));
+    }
+
+    [Theory]
+    [InlineData(65001)]
+    [InlineData(1200)]
+    [InlineData(28591)]
+    public void Source_code_page_comes_from_the_compiler_text(int codePage)
+    {
+        var tree = CSharpSyntaxTree.ParseText(SourceText.From("class A {}", Encoding.GetEncoding(codePage)), path: "a.cs");
+        var compilation = CSharpCompilation.Create("Facts", [tree], [MetadataReference.CreateFromFile(typeof(object).Assembly.Location)]);
+        var facts = ArchitectureFileFacts.From(tree, compilation.GetSemanticModel(tree));
+        var json = JsonDocument.Parse(JsonSerializer.Serialize(facts, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })).RootElement;
+        Assert.Equal(codePage, json.GetProperty("sourceCodePage").GetInt32());
+    }
+
+    [Fact]
+    public void Unknown_in_memory_encoding_is_omitted()
+    {
+        var map = CallGraphBuilder.Build([("a.cs", "class A {}")], "/proj");
+        var file = Assert.Single(JsonDocument.Parse(CodeMapJson.Write(map)).RootElement.GetProperty("architectureFiles").EnumerateArray());
+        Assert.False(file.TryGetProperty("sourceCodePage", out _));
+    }
+
+    [Theory]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":"2","architectureFiles":[]}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":1,"architectureFiles":[]}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":null,"architectureFiles":[]}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":"1"}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":"1","architectureFiles":null}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":"1","architectureFiles":[{"sourceCodePage":0}]}""")]
+    [InlineData("""{"schema":"callatlas.ir.v3","sourceFactsVersion":"1","architectureFiles":[null]}""")]
+    public void Unsupported_or_incomplete_source_capability_is_rejected(string json) =>
+        Assert.Throws<CallAtlasException>(() => CodeMapJson.Read(json));
+}
