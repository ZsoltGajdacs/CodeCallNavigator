new file mode 100644
index 0000000..a2b430d
--- /dev/null
+++ b/src/CallAtlas.Core/CallGraphBindings.cs
@@ -0,0 +1,129 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+// Native invocation binding and its worker-local state share the same source-site facts.
+public sealed partial class CallGraphBuilder
+{
+    private static void RecordCall(
+        SemanticModel model,
+        IReadOnlySet<IAssemblySymbol> ourAssemblies,
+        InvocationExpressionSyntax invoke,
+        string fromId,
+        ExtractionShard shard,
+        string root)
+    {
+        var info = model.GetSymbolInfo(invoke);
+        if (info.Symbol is IMethodSymbol target)
+        {
+            // 委托调用要在 external 过滤<b>之前</b>判：符号是 Func/Action 上的 Invoke，
+            // 它在 BCL 里，照原逻辑会变成一条 "System.Action::Invoke" 外部计数——
+            // 于是"3 次去不掉的委托调用"与"3 次普通的 BCL 调用"在产物里长得一样。
+            // 委托的类型是用户自己的（这里的 Action 是 System 的，但签名是我们声明的），
+            // 真实去向静态不可知，必须显式记成一条 delegate 级的边挂到委托类型上。
+            var receiverType = ReceiverType(model, invoke);
+            if (receiverType is { TypeKind: TypeKind.Delegate } delegateType)
+            {
+                var delegateId = DelegateTargetId(shard.Implicit, delegateType);
+                AddOrCount(shard.Edges, fromId, delegateId, "call", EdgeTier.Delegate);
+                shard.FlowBindings.Add(fromId, invoke, new(delegateId, EdgeTier.Delegate, "roslyn:delegate")
+                    { Diagnostic = "Delegate invocation does not identify the runtime callable" });
+                return;
+            }
+
+            if (IsExternal(ourAssemblies, target))
+            {
+                // 外部（BCL/第三方）调用：只聚合计数，不展开成节点
+                var od = target.OriginalDefinition;
+                NoteExternal(shard.External,
+                    $"{DisplayOf(od.ContainingType)}::{od.Name}");
+                shard.FlowBindings.Add(fromId, invoke, new(null, "", "roslyn:call")
+                    { Diagnostic = "External compiler target: " + SymbolId.Canonical(od) });
+                return;
+            }
+
+            var tier = EdgeTierClassifier.ForCall(target, receiverType);
+            AddOrCount(shard.Edges, fromId, IdOf(target), "call", tier);
+
+            // D2：dispatch 边的目标静态上只有一个（接口契约 / 虚方法声明），
+            // 于是真实实现全部入度为 0、在图上表现为死代码。把本次编译内
+            // **可发现的**实现挂到这条边的 virtualTargets 上——
+            // 属性级规模，不是 N 条边的规模，图不会膨胀。
+            if (tier == EdgeTier.Dispatch)
+                RecordVirtualTargets(model.Compilation, ourAssemblies, target, IdOf(target), shard);
+
+            shard.FlowBindings.Add(fromId, invoke, new(IdOf(target), tier, "roslyn:call")
+                { Candidates = shard.VirtualTargets.GetValueOrDefault(IdOf(target)) });
+
+            EnsureNode(shard.Implicit, target, "method");
+            return;
+        }
+
+        // 绑定失败：按**失败原因**细分，而不是把所有"有候选符号"的情况一律叫 ambiguous。
+        // 实测：`AddProject(project, units, compilations)`（同类内 private 调用，完全合法）
+        // 只因形参类型里含未解析的包类型就被记成 ambiguous——那既不是歧义，也误导了使用者。
+        var reason = ClassifyFailure(model, invoke, info);
+        Unresolve(shard.Unresolved, reason, invoke.ToString(), invoke.GetLocation(), root);
+        shard.FlowBindings.Add(fromId, invoke, new(null, "", "roslyn:call") { Diagnostic = reason });
+    }
+
+    /// <summary>
+    /// 绑定失败的原因分级。顺序即优先级：**错误类型导致的失败**要先判——它会让所有重载
+    /// 候选都"存在但不可用"，若先看 CandidateSymbols 就会把缺引用的连锁反应误报成歧义
+    /// （自举实测 53 条 ambiguous 里绝大多数是这个成因）。
+    /// </summary>
+    private static string ClassifyFailure(SemanticModel model, InvocationExpressionSyntax invoke, SymbolInfo info)
+    {
+        // 1. 实参/接收者里含 error type → 这是"引用缺失"的连锁反应，不是调用本身有问题
+        if (info.CandidateSymbols.Length == 0 && model.GetTypeInfo(invoke).Type is IErrorTypeSymbol)
+            return "error-type";
+        if (invoke.ArgumentList.Arguments.Any(a => model.GetTypeInfo(a.Expression).Type is IErrorTypeSymbol))
+            return "error-type";
+        if (IsErrorTypeReceiver(model, invoke))
+            return "error-type";
+
+        // 2. 有候选却绑不上：区分"可访问性"与"真歧义"——诊断码是唯一可靠依据
+        if (info.CandidateSymbols.Length > 0)
+        {
+            var inaccessible = model.GetDiagnostics(invoke.Span)
+                .Any(d => d.Severity == DiagnosticSeverity.Error && AccessibilityCodes.Contains(d.Id));
+            return inaccessible ? "inaccessible" : "ambiguous";
+        }
+
+        return "unresolved";
+    }
+
+    /// <summary>接收者（<c>x.M()</c> 里的 <c>x</c>）是 error type 时，整条调用都不可信。
+    /// 接收者形态由 <see cref="ReceiverExpression"/> 统一给出——条件访问曾在这里也取不到接收者，
+    /// 于是"接收者坏了"被判成 <c>unresolved</c> 而不是 <c>error-type</c>，把成因说错了。</summary>
+    private static bool IsErrorTypeReceiver(SemanticModel model, InvocationExpressionSyntax invoke)
+    {
+        var receiver = ReceiverExpression(invoke);
+        return receiver is not null && model.GetTypeInfo(receiver).Type is IErrorTypeSymbol;
+    }
+
+    /// <summary>可访问性相关的 CS 码：CS0122 不可访问、CS0271/CS0272 属性无 get/set、
+    /// CS1061 不包含定义、CS0117 成员不存在。</summary>
+    private static readonly HashSet<string> AccessibilityCodes = new(StringComparer.Ordinal)
+    {
+        "CS0122", "CS0271", "CS0272", "CS1061", "CS0117",
+    };
+
+    /// <summary>
+    /// 阶段二的按线程累加器。边 / 外部计数 / 未解析计数都只是"计数"，
+    /// 隐式补节点的内容也只由符号本身决定（与谁先算到无关），因此分片之间互不干扰，
+    /// 合并顺序不影响最终产物（写出前全排序）——并行化不破坏字节级确定性。
+    /// </summary>
+    private sealed class ExtractionShard
+    {
+        public readonly Dictionary<EdgeIdentity, int> Edges = new();
+        public readonly Dictionary<string, int> External = new();
+        public readonly Dictionary<(string Reason, string Expr, string Loc), int> Unresolved = new();
+        public readonly Dictionary<string, Node> Implicit = new();
+        /// <summary>dispatch 边的静态目标 id → 本次编译内可发现的实现 id 集合（D2）。</summary>
+        public readonly Dictionary<string, HashSet<string>> VirtualTargets = new();
+        public readonly FlowBindings FlowBindings = new();
+    }
+
+}
