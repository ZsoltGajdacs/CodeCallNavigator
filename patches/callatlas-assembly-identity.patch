@@ -0,0 +1,17 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal static class FlowText
+{
+    internal static string Bounded(string text) => text.Length <= 512 ? text : text[..512] + "…";
+    /// <summary>Labels stay bounded; full source is addressed through the immutable byte span.</summary>
+    internal static string Label(SyntaxNode node)
+    {
+        const int maximum = 512;
+        var text = node.SyntaxTree.GetText();
+        var length = Math.Min(node.Span.Length, maximum);
+        if (length < node.Span.Length && length > 0 && char.IsHighSurrogate(text[node.SpanStart + length - 1])) length--;
+        return text.ToString(new(node.SpanStart, length)) + (length < node.Span.Length ? "…" : "");
+    }
+}
