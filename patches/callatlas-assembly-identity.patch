+using System.Text.Json;
+using System.Text.Json.Nodes;
+using CallAtlas.Core;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowExecutionFactsTests
+{
+    [Fact]
+    public void Known_execution_and_invocation_facts_roundtrip_at_the_strict_boundary()
+    {
+        var map = JsonNode.Parse(Snapshot("class A { static int Leaf()=>1; int Run()=>Leaf(); }").GetRawText())!;
+        var function = map["flowInventory"]!["functions"]!.AsArray().Single(f=>f!["symbol"]!.GetValue<string>().EndsWith("A::Run()"))!;
+        function["execution"] = "synchronous";
+        var site = function["body"]![0]!["value"]!;
+        var call = site["calls"]![0]!;
+        call["invocation"] = JsonNode.Parse("""{"timing":"synchronous","dispatch":"direct","isolated_ordered":true}""");
+        var result = CodeMapJson.Write(CodeMapJson.Read(map.ToJsonString()));
+        var saved = Function(JsonDocument.Parse(result).RootElement,"A::Run()");
+        Assert.Equal("synchronous", saved.GetProperty("execution").GetString());
+        Assert.True(Objects(saved).Single(o=>o.TryGetProperty("targets",out _)).GetProperty("invocation").GetProperty("isolated_ordered").GetBoolean());
+    }
+
+    [Fact]
+    public void Compiler_callable_execution_is_independent_of_return_type_and_nested_declarations()
+    {
+        var map = CheckedSnapshot("using System.Collections.Generic; using System.Threading.Tasks; class A { Task Plain()=>Task.CompletedTask; async Task Async(){await Task.Delay(1);} IEnumerable<int> Iterator(){yield return 1;} int Outer(){async Task Local(){await Task.Delay(1);} System.Func<Task> f=async()=>{await Task.Delay(1);}; return 1;} }");
+        Assert.Equal("synchronous", Function(map,"A::Plain()").GetProperty("execution").GetString());
+        Assert.False(Function(map,"A::Async()").TryGetProperty("execution",out _));
+        Assert.Equal("deferred", Function(map,"A::Iterator()").GetProperty("execution").GetString());
+        Assert.Equal("synchronous", Function(map,"A::Outer()").GetProperty("execution").GetString());
+        var local = map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray().Single(f=>f.GetProperty("symbol").GetString()!.Contains("Local"));
+        Assert.False(local.TryGetProperty("execution",out _));
+    }
+
+    [Fact]
+    public void Explicit_final_invocations_have_compiler_dispatch_before_native_target_pruning()
+    {
+        var map = CheckedSnapshot("class A { static int Leaf()=>1; virtual public int V()=>1; int Run(A a){int Local()=>Leaf(); return a.V()+Local()+System.Math.Abs(-1);} }");
+        var calls = Objects(Function(map,"A::Run(A)")).Where(o=>o.TryGetProperty("targets",out _)).ToArray();
+        Assert.Equal(3,calls.Length);
+        Assert.Equal("virtual", calls[0].GetProperty("invocation").GetProperty("dispatch").GetString());
+        Assert.Equal("direct", calls[1].GetProperty("invocation").GetProperty("dispatch").GetString());
+        Assert.Equal("direct", calls[2].GetProperty("invocation").GetProperty("dispatch").GetString());
+        Assert.Empty(calls[2].GetProperty("targets").EnumerateArray());
+        Assert.All(calls,c=>Assert.True(c.GetProperty("invocation").GetProperty("isolated_ordered").GetBoolean()));
+    }
+    internal static JsonElement CheckedSnapshot(string source)
+    {
+        var map = Snapshot(source);
+        Assert.Equal(0, map.GetProperty("bodyErrorCount").GetInt32());
+        Assert.Empty(map.GetProperty("diagnostics").EnumerateArray());
+        return map;
+    }
+}
