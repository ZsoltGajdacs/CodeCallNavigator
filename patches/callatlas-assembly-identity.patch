+/// <summary>Source origin and callable category supplied by Roslyn.</summary>
+public sealed record MethodDeclarationFacts
+{
+    public bool HasSourceDeclaration { get; init; }
+    public bool IsImplicit { get; init; }
+    public string CallableKind { get; init; } = "";
+    public bool IsObjectMember { get; init; }
+
+    public static MethodDeclarationFacts From(IMethodSymbol method) => new()
+    {
+        HasSourceDeclaration = method.DeclaringSyntaxReferences.Length > 0,
+        IsImplicit = method.IsImplicitlyDeclared,
+        CallableKind = method.MethodKind.ToString(),
+        IsObjectMember = MatchesObjectMember(method),
+    };
+
+    private static bool MatchesObjectMember(IMethodSymbol method)
+    {
+        var type = method.ContainingType;
+        while (type is not null && type.SpecialType != SpecialType.System_Object)
+            type = type.BaseType;
+        type ??= ReferencedObjectType(method);
+        var names = method.ExplicitInterfaceImplementations.Select(member => member.Name).Append(method.Name);
+        return type is not null && names.SelectMany(name => type.GetMembers(name)).OfType<IMethodSymbol>()
+            .Any(candidate => SameSignature(method, candidate));
+    }
+
+    private static INamedTypeSymbol? ReferencedObjectType(IMethodSymbol method) =>
+        method.ContainingModule.ReferencedAssemblySymbols
+            .Select(assembly => assembly.GetTypeByMetadataName("System.Object")
+                ?? assembly.ResolveForwardedType("System.Object"))
+            .FirstOrDefault(type => type is not null);
+
+    private static bool SameSignature(IMethodSymbol method, IMethodSymbol candidate) =>
+        method.Arity == candidate.Arity && method.IsStatic == candidate.IsStatic
+        && method.Parameters.Length == candidate.Parameters.Length
+        && method.Parameters.Zip(candidate.Parameters).All(pair =>
+            pair.First.RefKind == pair.Second.RefKind
+            && SymbolEqualityComparer.Default.Equals(pair.First.Type, pair.Second.Type));
 }
 
