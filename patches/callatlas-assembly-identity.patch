diff --git a/src/CallAtlas.Core/FlowBindings.cs b/src/CallAtlas.Core/FlowBindings.cs
new file mode 100644
index 0000000..ab25c1c
--- /dev/null
+++ b/src/CallAtlas.Core/FlowBindings.cs
@@ -0,0 +1,71 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.Text;
+
+namespace CallAtlas.Core;
+
+/// <summary>Worker-local binding events, recorded at the resolver decision rather than reconstructed from counts.</summary>
+internal sealed class FlowBindings
+{
+    private readonly Dictionary<(string Caller, SyntaxTree Tree, TextSpan Span), BoundFlowCall> calls = new();
+    private readonly Dictionary<string, int> counts = new(StringComparer.Ordinal);
+    private readonly HashSet<string> exceeded = new(StringComparer.Ordinal);
+
+    internal bool Exceeded(string caller) => exceeded.Contains(caller);
+
+    internal void Add(string caller, SyntaxNode node, FlowBinding binding)
+    {
+        if (Exceeded(caller)) return;
+        var call = Site(caller, node, binding.Diagnostic);
+        if (call is null) return;
+        if (binding.Target is not null)
+        {
+            if (call.Targets.Count >= 1500) { exceeded.Add(caller); return; }
+            call.Targets.Add(new(binding.Target, binding.Certainty, binding.Provenance));
+        }
+        foreach (var candidate in binding.Candidates ?? [])
+        {
+            if (candidate == binding.Target) continue;
+            if (call.Targets.Count >= 1500) { exceeded.Add(caller); return; }
+            call.Targets.Add(new(candidate, "possible", binding.Provenance));
+        }
+    }
+
+    private BoundFlowCall? Site(string caller, SyntaxNode node, string? diagnostic)
+    {
+        var key = (caller, node.SyntaxTree, node.Span);
+        if (calls.TryGetValue(key, out var call)) return call;
+        if (!Allocate(caller)) return null;
+        calls[key] = call = new([], diagnostic);
+        return call;
+    }
+
+    private bool Allocate(string caller)
+    {
+        if (counts.GetValueOrDefault(caller) >= 1500)
+        {
+            exceeded.Add(caller);
+            return false;
+        }
+        counts[caller] = counts.GetValueOrDefault(caller) + 1;
+        return true;
+    }
+
+    internal IReadOnlyList<FlowCall> At(string caller, SyntaxNode node, FlowSource source) =>
+        calls.TryGetValue((caller, node.SyntaxTree, node.Span), out var call)
+            ? [new(source.Span(node), FlowText.Label(node), call.Targets.Distinct().OrderBy(t => t.Symbol, StringComparer.Ordinal)
+                .ThenBy(t => t.Certainty, StringComparer.Ordinal).ToArray(), call.Diagnostic)]
+            : [];
+
+    internal void Merge(FlowBindings other)
+    {
+        exceeded.UnionWith(other.exceeded);
+        foreach (var (key, value) in other.calls)
+        {
+            if (Exceeded(key.Caller)) continue;
+            if (!Allocate(key.Caller)) continue;
+            calls.Add(key, value);
+        }
+    }
+
+    private sealed record BoundFlowCall(List<FlowTarget> Targets, string? Diagnostic);
+}
