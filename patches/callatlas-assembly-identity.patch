--- /dev/null
+++ b/src/CallAtlas.Core/FlowExceptions.cs
@@ -0,0 +1,21 @@
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Try(TryStatementSyntax statement, int depth)
+    {
+        var final = statement.Finally is null ? [] : Body(statement.Finally.Block, depth + 1);
+        if (statement.Catches.Any(clause => clause.Filter is not null))
+            return Protected(statement, [OpaqueCompletion(statement, "Filtered catch dispatch precedes unwind and remains opaque")])
+                with { Finally = final };
+        var catches = statement.Catches.Select(clause =>
+        {
+            Budget(depth + 1);
+            return new FlowCatch(clause.Declaration is null ? "all" : FlowText.Label(clause.Declaration), clause.Declaration is null,
+                Body(clause.Block, depth + 1));
+        }).ToArray();
+        return Protected(statement, Body(statement.Block, depth + 1)) with { Catches = catches, Finally = final };
+    }
+}
