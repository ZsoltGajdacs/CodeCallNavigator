+/// <summary>Separate compiler facts: native CallAtlas relationships remain unchanged.</summary>
+public sealed record MediatRFacts
+{
+    public const string Version = "1";
+    public IReadOnlyList<MediatRDispatchFact> Edges { get; init; } = [];
+    public IReadOnlyList<string> Diagnostics { get; init; } = [];
+    public IReadOnlyList<string> Entries { get; init; } = [];
+}
+
+public sealed record MediatRSourceSite(string File, int Line, int Column);
+
+public sealed record MediatRDispatchFact
+{
+    public required string From { get; init; }
+    public required string To { get; init; }
+    public required string Dispatch { get; init; }
+    public required MediatRSourceSite Invocation { get; init; }
+    public required string Payload { get; init; }
+    public required string Handler { get; init; }
+    public bool Awaited { get; init; }
+    public bool Conditional { get; init; }
+}
+
+internal sealed record MediatRBody(SemanticModel Model, string From, SyntaxNode[] Bodies);
+internal sealed record MediatRHandler(string Assembly, string Payload, string Dispatch,
+    string Type, string Method);
diff --git a/src/CallAtlas.Core/MediatRHandlerCatalog.cs b/src/CallAtlas.Core/MediatRHandlerCatalog.cs
new file mode 100644
index 0000000..32069da
--- /dev/null
+++ b/src/CallAtlas.Core/MediatRHandlerCatalog.cs
@@ -0,0 +1,58 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal static class MediatRHandlerCatalog
+{
+    internal static IEnumerable<MediatRHandler> Collect(
+        IReadOnlyList<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units,
+        IReadOnlySet<string> nodes)
+    {
+        var seen = new HashSet<INamedTypeSymbol>(SymbolEqualityComparer.Default);
+        foreach (var (type, compilation) in SourceTypes(units))
+        {
+            if (!seen.Add(type)) continue;
+            foreach (var handler in ForType(type, compilation, nodes)) yield return handler;
+        }
+    }
+
+    private static IEnumerable<(INamedTypeSymbol Type, Compilation Compilation)> SourceTypes(
+        IReadOnlyList<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units)
+    {
+        foreach (var (tree, model, compilation) in units)
+        foreach (var type in tree.GetRoot().DescendantNodes().OfType<BaseTypeDeclarationSyntax>()
+                     .Select(declaration => model.GetDeclaredSymbol(declaration)).OfType<INamedTypeSymbol>()
+                     .Where(IsConcreteClass))
+            yield return (type, compilation);
+    }
+
+    private static bool IsConcreteClass(INamedTypeSymbol type) =>
+        type.TypeKind == TypeKind.Class && !type.IsAbstract && MediatRContracts.IsClosed(type);
+
+    private static IEnumerable<MediatRHandler> ForType(INamedTypeSymbol type,
+        Compilation compilation, IReadOnlySet<string> nodes) =>
+        BoundContracts(type, compilation).SelectMany(binding => binding.Contract.GetMembers("Handle")
+            .OfType<IMethodSymbol>().Select(member => Resolve(type, binding, member, nodes)))
+            .OfType<MediatRHandler>();
+
+    private static IEnumerable<HandlerContract> BoundContracts(INamedTypeSymbol type, Compilation compilation) =>
+        type.AllInterfaces.Select(contract => new HandlerContract(contract,
+                MediatRContracts.HandlerKind(compilation, contract)))
+            .Where(IsSupportedBinding);
+
+    private static bool IsSupportedBinding(HandlerContract binding) => binding.Dispatch is not null
+        && MediatRContracts.IsClosed(binding.Contract.TypeArguments[0]);
+
+    private static MediatRHandler? Resolve(INamedTypeSymbol type, HandlerContract binding,
+        IMethodSymbol member, IReadOnlySet<string> nodes)
+    {
+        if (type.FindImplementationForInterfaceMember(member) is not IMethodSymbol method) return null;
+        var id = SymbolId.Canonical(method);
+        return nodes.Contains(id) ? new MediatRHandler(type.ContainingAssembly.Identity.ToString(),
+            MediatRContracts.TypeKey(binding.Contract.TypeArguments[0]), binding.Dispatch!,
+            MediatRContracts.StableType(type), id) : null;
+    }
+
+    private sealed record HandlerContract(INamedTypeSymbol Contract, string? Dispatch);
+}
diff --git a/src/CallAtlas.Core/MediatRInference.cs b/src/CallAtlas.Core/MediatRInference.cs
new file mode 100644
index 0000000..498a0e5
--- /dev/null
+++ b/src/CallAtlas.Core/MediatRInference.cs
@@ -0,0 +1,139 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Microsoft.CodeAnalysis.Operations;
+
+namespace CallAtlas.Core;
+
+internal sealed class MediatRInference
+{
+    private readonly MediatRHandler[] handlers;
+    private readonly List<MediatRDispatchFact> edges = [];
+    private readonly SortedSet<string> diagnostics = new(StringComparer.Ordinal);
+    private readonly string root;
+
+    private MediatRInference(MediatRHandler[] handlers, string root)
+    {
+        this.handlers = handlers;
+        this.root = root;
+    }
+
+    internal static MediatRFacts Analyze(
+        IReadOnlyList<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units,
+        IEnumerable<MediatRBody> bodies, IReadOnlySet<string> nodes, string root)
+    {
+        var scopes = CompilationScopes(units);
+        if (scopes.Count == 0) return new MediatRFacts();
+        var activeUnits = units.Where(unit => scopes.ContainsKey(unit.Compilation)).ToArray();
+        var analysis = new MediatRInference(MediatRHandlerCatalog.Collect(activeUnits, nodes).ToArray(), root);
+        foreach (var body in bodies)
+        {
+            if (scopes.TryGetValue(body.Model.Compilation, out var visible)) analysis.AnalyzeBody(body, visible);
+        }
+        return new MediatRFacts
+        {
+            Edges = analysis.edges.OrderBy(edge => edge.From, StringComparer.Ordinal)
+                .ThenBy(edge => edge.To, StringComparer.Ordinal)
+                .ThenBy(edge => edge.Invocation.File, StringComparer.Ordinal)
+                .ThenBy(edge => edge.Invocation.Line).ThenBy(edge => edge.Invocation.Column)
+                .ThenBy(edge => edge.Handler, StringComparer.Ordinal).ToArray(),
+            Diagnostics = analysis.diagnostics.ToArray(),
+            Entries = analysis.handlers.Select(handler => handler.Method).Distinct(StringComparer.Ordinal)
+                .Order(StringComparer.Ordinal).ToArray(),
+        };
+    }
+
+    private static Dictionary<Compilation, HashSet<string>> CompilationScopes(
+        IReadOnlyList<(SyntaxTree Tree, SemanticModel Model, Compilation Compilation)> units) =>
+        units.Select(unit => unit.Compilation).Distinct().Where(MediatRContracts.HasFrameworkContracts)
+            .ToDictionary(compilation => compilation, MediatRContracts.VisibleAssemblies);
+
+    private void AnalyzeBody(MediatRBody body, IReadOnlySet<string> visible)
+    {
+        foreach (var syntax in body.Bodies.SelectMany(node => node.DescendantNodesAndSelf(Descend))
+                     .OfType<InvocationExpressionSyntax>())
+        {
+            if (!IsDispatchName(syntax.Expression)) continue;
+            if (body.Model.GetOperation(syntax) is not IInvocationOperation invocation) continue;
+            var dispatch = MediatRContracts.DispatchKind(invocation, body.Model.Compilation);
+            if (dispatch is not null) AnalyzeInvocation(body.From, syntax, invocation, dispatch, visible);
+        }
+    }
+
+    private static bool IsDispatchName(ExpressionSyntax expression) => expression switch
+    {
+        MemberAccessExpressionSyntax access => access.Name.Identifier.ValueText is "Send" or "Publish",
+        MemberBindingExpressionSyntax binding => binding.Name.Identifier.ValueText is "Send" or "Publish",
+        SimpleNameSyntax name => name.Identifier.ValueText is "Send" or "Publish",
+        _ => false,
+    };
+
+    private static bool Descend(SyntaxNode node) =>
+        node is not (MethodDeclarationSyntax or ConstructorDeclarationSyntax or LocalFunctionStatementSyntax);
+
+    private void AnalyzeInvocation(string from, InvocationExpressionSyntax syntax, IInvocationOperation invocation,
+        string dispatch, IReadOnlySet<string> visible)
+    {
+        if (syntax.Ancestors().OfType<AnonymousFunctionExpressionSyntax>().Any())
+        {
+            Defer(syntax, "anonymous callable has no native identity");
+            return;
+        }
+        var payload = MediatRContracts.Payload(invocation);
+        if (payload is null)
+        {
+            Defer(syntax, "concrete closed payload type is unknown");
+            return;
+        }
+        var key = MediatRContracts.TypeKey(payload);
+        var candidates = handlers.Where(handler => handler.Dispatch == dispatch && handler.Payload == key
+            && visible.Contains(handler.Assembly)).ToArray();
+        if (candidates.Length == 0 || dispatch == "send" && candidates.Length != 1)
+        {
+            Defer(syntax, candidates.Length == 0 ? "no exact closed source handler in compiler scope"
+                : "multiple request handlers in compiler scope");
+            return;
+        }
+        foreach (var handler in candidates)
+            edges.Add(new MediatRDispatchFact
+            {
+                From = from, To = handler.Method, Dispatch = dispatch, Invocation = Site(syntax),
+                Payload = MediatRContracts.StableType(payload), Handler = handler.Type,
+                Awaited = IsDirectAwait(syntax),
+                Conditional = Context(syntax).Any(IsConditional),
+            });
+    }
+
+    private static bool IsDirectAwait(InvocationExpressionSyntax syntax)
+    {
+        SyntaxNode expression = syntax;
+        while (expression.Parent is ParenthesizedExpressionSyntax parenthesized)
+            expression = parenthesized;
+        return expression.Parent is AwaitExpressionSyntax;
+    }
+
+    private static IEnumerable<SyntaxNode> Context(SyntaxNode syntax) =>
+        syntax.Ancestors().TakeWhile(node => node is not (BaseMethodDeclarationSyntax
+            or LocalFunctionStatementSyntax or AnonymousFunctionExpressionSyntax));
+
+    private static bool IsConditional(SyntaxNode node) =>
+        node is IfStatementSyntax or SwitchSectionSyntax or SwitchExpressionArmSyntax or ConditionalExpressionSyntax
+            or ConditionalAccessExpressionSyntax or ForStatementSyntax or ForEachStatementSyntax
+            or WhileStatementSyntax or DoStatementSyntax or CatchClauseSyntax
+        || node.IsKind(SyntaxKind.LogicalAndExpression) || node.IsKind(SyntaxKind.LogicalOrExpression)
+        || node.IsKind(SyntaxKind.CoalesceExpression);
+
+    private MediatRSourceSite Site(SyntaxNode syntax)
+    {
+        var position = syntax.SyntaxTree.GetLineSpan(syntax.Span).StartLinePosition;
+        return new MediatRSourceSite(Path.GetRelativePath(root, syntax.SyntaxTree.FilePath).Replace('\\', '/'),
+            position.Line + 1, position.Character + 1);
+    }
+
+    private void Defer(SyntaxNode syntax, string reason)
+    {
+        var site = Site(syntax);
+        var file = Path.GetFullPath(syntax.SyntaxTree.FilePath).Replace('\\', '/');
+        diagnostics.Add($"MediatR dispatch deferred ({reason}) at {file}:{site.Line}:{site.Column}");
+    }
+}
