new file mode 100644
index 0000000..0298653
--- /dev/null
+++ b/src/CallAtlas.Core/FlowLock.cs
@@ -0,0 +1,60 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Lock(LockStatementSyntax statement, int depth)
+    {
+        try
+        {
+            MonitorProof(statement);
+            Budget(depth + 1);
+            var capture = EvaluateSynthetic(statement, Sequence(statement, [Expression(statement.Expression, depth + 1),
+                SyntheticValue(statement, "capture lock object once")]));
+            var initialize = EvaluateSynthetic(statement, SyntheticValue(statement, "initialize lockTaken = false"));
+            var body = new List<FlowStatement> { EvaluateSynthetic(statement, ImplicitCall(statement, ImplicitFlowOperation.MonitorEnter, "lock object")) };
+            body.AddRange(Body(statement.Statement, depth + 1));
+            var exit = EvaluateSynthetic(statement, ImplicitCall(statement, ImplicitFlowOperation.MonitorExit, "lock object"));
+            var release = new FlowStatement("if", source.Span(statement))
+            { Condition = SyntheticValue(statement, "lockTaken is true"), ThenBranch = [exit], ElseBranch = [] };
+            var scope = Protected(statement, body) with { Finally = [release] };
+            return new("block", source.Span(statement)) { Body = [capture, initialize, scope] };
+        }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return OpaqueCompletion(statement, problem.Message); }
+    }
+
+    private void MonitorProof(LockStatementSyntax statement)
+    {
+        var type = model.GetTypeInfo(statement.Expression).Type;
+        if (type is null) throw new FlowUnsupported("Lock receiver type is unresolved");
+        if (!type.IsReferenceType) throw new FlowUnsupported("Lock receiver is not a reference type");
+        if (type.TypeKind == TypeKind.Dynamic) throw new FlowUnsupported("Dynamic lock receiver is opaque");
+        var specialized = model.Compilation.GetTypeByMetadataName("System.Threading.Lock");
+        if (SymbolEqualityComparer.Default.Equals(type, specialized))
+            throw new FlowUnsupported("System.Threading.Lock scope lowering is opaque");
+        var monitor = model.Compilation.GetTypeByMetadataName("System.Threading.Monitor");
+        if (monitor is null) throw new FlowUnsupported("Compiler Monitor metadata is unavailable");
+        if (monitor.GetMembers("Enter").OfType<IMethodSymbol>().Count(ModernEnter) != 1)
+            throw new FlowUnsupported("Modern Monitor.Enter(object, ref bool) contract is unresolved or ambiguous");
+        if (monitor.GetMembers("Exit").OfType<IMethodSymbol>().Count(MonitorExit) != 1)
+            throw new FlowUnsupported("Monitor.Exit(object) contract is unresolved or ambiguous");
+    }
+
+    private static bool PublicStaticVoid(IMethodSymbol method) =>
+        method.IsStatic && method.DeclaredAccessibility == Accessibility.Public && method.ReturnsVoid && method.Arity == 0;
+
+    private static bool ModernEnter(IMethodSymbol method)
+    {
+        if (!PublicStaticVoid(method) || method.Parameters.Length != 2) return false;
+        return ObjectParameter(method.Parameters[0]) && method.Parameters[1] is
+            { RefKind: RefKind.Ref, Type.SpecialType: SpecialType.System_Boolean };
+    }
+
+    private static bool MonitorExit(IMethodSymbol method) => PublicStaticVoid(method) &&
+        method.Parameters.Length == 1 && ObjectParameter(method.Parameters[0]);
+
+    private static bool ObjectParameter(IParameterSymbol parameter) =>
+        parameter.RefKind == RefKind.None && parameter.Type.SpecialType == SpecialType.System_Object;
+}
diff --git a/src/CallAtlas.Core/FlowMemberOwnership.cs b/src/CallAtlas.Core/FlowMemberOwnership.cs
new file mode 100644
index 0000000..8a956e1
--- /dev/null
+++ b/src/CallAtlas.Core/FlowMemberOwnership.cs
@@ -0,0 +1,31 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+/// <summary>Include bodyless/generated compiler members without binding every skipped auto-accessor syntax.</summary>
+internal sealed class FlowMemberOwnership
+{
+    private readonly Dictionary<INamedTypeSymbol, HashSet<string>> aliases = new(SymbolEqualityComparer.Default);
+
+    internal bool Ambiguous(INamedTypeSymbol type, string symbol)
+    {
+        if (!aliases.TryGetValue(type, out var ambiguous))
+        {
+            ambiguous = type.GetMembers().SelectMany(Methods)
+                .Select(method => (method.PartialDefinitionPart ?? method).OriginalDefinition)
+                .GroupBy(SymbolId.Canonical)
+                .Where(group => group.Distinct(SymbolEqualityComparer.Default).Take(2).Count() > 1)
+                .Select(group => group.Key).ToHashSet(StringComparer.Ordinal);
+            aliases[type] = ambiguous;
+        }
+        return ambiguous.Contains(symbol);
+    }
+
+    private static IEnumerable<IMethodSymbol> Methods(ISymbol member) => member switch
+    {
+        IMethodSymbol method => [method],
+        IPropertySymbol property => new[] { property.GetMethod, property.SetMethod }.OfType<IMethodSymbol>(),
+        IEventSymbol eventSymbol => new[] { eventSymbol.AddMethod, eventSymbol.RemoveMethod, eventSymbol.RaiseMethod }.OfType<IMethodSymbol>(),
+        _ => [],
+    };
+}
diff --git a/src/CallAtlas.Core/FlowOriginalSource.cs b/src/CallAtlas.Core/FlowOriginalSource.cs
new file mode 100644
index 0000000..d26f5c6
--- /dev/null
+++ b/src/CallAtlas.Core/FlowOriginalSource.cs
@@ -0,0 +1,24 @@
+using System.Text;
+
+namespace CallAtlas.Core;
+
+internal sealed record FlowOriginalSource(int Prefix, string? Problem)
+{
+    internal static FlowOriginalSource Check(string file, string analyzed)
+    {
+        if (!File.Exists(file)) return new(0, null); // In-memory extraction has no disk snapshot.
+        var bytes = File.ReadAllBytes(file);
+        var prefix = bytes.AsSpan().StartsWith(new byte[] { 0xef, 0xbb, 0xbf }) ? 3 : 0;
+        return new(prefix, Compare(bytes.AsSpan(prefix), analyzed));
+    }
+
+    private static string? Compare(ReadOnlySpan<byte> bytes, string analyzed)
+    {
+        try
+        {
+            var original = new UTF8Encoding(false, true).GetString(bytes);
+            return original == analyzed ? null : "Analyzed source differs from original UTF-8 file bytes";
+        }
+        catch (DecoderFallbackException) { return "Original source is not valid UTF-8"; }
+    }
+}
diff --git a/src/CallAtlas.Core/FlowOwnership.cs b/src/CallAtlas.Core/FlowOwnership.cs
new file mode 100644
index 0000000..053980b
--- /dev/null
+++ b/src/CallAtlas.Core/FlowOwnership.cs
@@ -0,0 +1,48 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+/// <summary>Native IDs can alias compiler declarations; detached flow requires unique source ownership.</summary>
+internal sealed record OwnedFlowBody(FlowInput Input, SyntaxNode[] Bodies);
+
+internal sealed class FlowOwnership
+{
+    private readonly FlowMemberOwnership members = new();
+
+    internal OwnedFlowBody? Select(IReadOnlyList<FlowInput> entries, Node node, string root)
+    {
+        if (!UniqueDeclaration(entries)) return null;
+        var active = entries.Where(entry => entry.Bodies.Count != 0).ToArray();
+        if (active.Length == 0) return null;
+        if (active.Select(entry => entry.Tree).Distinct().Take(2).Count() != 1) return null;
+        var declaration = entries.Select(entry => entry.Declaration).FirstOrDefault(value => value is not null);
+        if (declaration is not null && members.Ambiguous(declaration.ContainingType, entries[0].Symbol)) return null;
+        var bodies = active.SelectMany(entry => entry.Bodies)
+            .DistinctBy(body => (body.SyntaxTree, body.Span, body.RawKind))
+            .OrderBy(body => body.SpanStart).ToArray();
+        if (!UniqueBodies(bodies, node.Kind)) return null;
+        if (!SameSourceFile(node, active[0].Tree, root)) return null;
+        return new(active[0], bodies);
+    }
+
+    private static bool SameSourceFile(Node node, SyntaxTree tree, string root)
+    {
+        // Location is the native structural file:line field, not a diagnostic or a symbol ID.
+        var separator = node.Location.LastIndexOf(':');
+        if (separator < 0) return false;
+        return node.Location[..separator] == CallGraphBuilder.Rel(root, tree.FilePath);
+    }
+
+    private static bool UniqueBodies(IReadOnlyList<SyntaxNode> bodies, string kind) => kind == "toplevel"
+        ? bodies.All(body => body.Parent is GlobalStatementSyntax)
+        : bodies.Count == 1;
+
+    private static bool UniqueDeclaration(IEnumerable<FlowInput> entries)
+    {
+        // A partial implementation and its definition are one callable, unlike native ID collisions.
+        return entries.Select(entry => entry.Declaration).OfType<IMethodSymbol>()
+            .Select(declaration => (declaration.PartialDefinitionPart ?? declaration).OriginalDefinition)
+            .Distinct(SymbolEqualityComparer.Default).Take(2).Count() <= 1;
+    }
+}
diff --git a/src/CallAtlas.Core/FlowSource.cs b/src/CallAtlas.Core/FlowSource.cs
new file mode 100644
index 0000000..f71c23c
--- /dev/null
+++ b/src/CallAtlas.Core/FlowSource.cs
@@ -0,0 +1,22 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+/// <summary>One conversion table per tree; offsets refer to the original UTF-8 bytes, including its BOM.</summary>
+internal sealed class FlowSource
+{
+    private readonly int[] offsets;
+    internal string? Problem { get; }
+
+    internal FlowSource(SyntaxTree tree, string root)
+    {
+        var text = tree.GetText().ToString();
+        var file = Path.IsPathRooted(tree.FilePath) ? tree.FilePath : Path.Combine(root, tree.FilePath);
+        var original = FlowOriginalSource.Check(file, text);
+        Problem = original.Problem;
+        offsets = FlowUtf8Offsets.Convert(text, original.Prefix);
+    }
+
+    internal FlowSpan Span(SyntaxNode node) => Problem is null
+        ? new(offsets[node.SpanStart], offsets[node.Span.End]) : new(0, 0);
+}
diff --git a/src/CallAtlas.Core/FlowStatementValidation.cs b/src/CallAtlas.Core/FlowStatementValidation.cs
new file mode 100644
index 0000000..0daf248
--- /dev/null
+++ b/src/CallAtlas.Core/FlowStatementValidation.cs
@@ -0,0 +1,107 @@
+namespace CallAtlas.Core;
+
+internal static partial class FlowValidation
+{
+    private static void Statement(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        CheckSpan(node.Span, owner);
+        switch (node.Kind)
+        {
+            case "evaluate": case "throw": case "return": ValueStatement(node, pending); break;
+            default: StructuredStatement(node, owner, pending); break;
+        }
+    }
+
+    private static void StructuredStatement(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        switch (node.Kind)
+        {
+            case "if": case "loop": case "switch": Control(node, owner, pending); break;
+            case "block": case "region": Region(node, pending); break;
+            case "try": Protected(node, pending); break;
+            default: Leaf(node); break;
+        }
+    }
+
+    private static void ValueStatement(FlowStatement node, Stack<object> pending)
+    {
+        if (node.Kind == "return" && node.Value is null) return;
+        Push(pending, node.Value);
+    }
+
+    private static void Protected(FlowStatement node, Stack<object> pending)
+    {
+        PushAll(pending, node.Resources); PushAll(pending, node.Body);
+        PushAll(pending, node.Finally); PushAll(pending, node.Cleanup);
+        PushAll(pending, node.Catches);
+        if (node.Resources!.Count != 0) Require(node.Resources.Count == node.Cleanup!.Count);
+    }
+
+    private static void Catch(FlowCatch clause, Stack<object> pending)
+    {
+        Require(clause.Parameter is not null);
+        PushAll(pending, clause.Body);
+    }
+
+    private static void Control(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        switch (node.Kind)
+        {
+            case "if": Branch(node, pending); break;
+            case "loop": Loop(node, pending); break;
+            case "switch": Dispatch(node, owner, pending); break;
+        }
+    }
+
+    private static void Branch(FlowStatement node, Stack<object> pending)
+    {
+        Push(pending, node.Condition);
+        PushAll(pending, node.ThenBranch);
+        PushAll(pending, node.ElseBranch);
+    }
+
+    private static void Loop(FlowStatement node, Stack<object> pending)
+    {
+        if (node.Condition is not null) pending.Push(node.Condition);
+        PushAll(pending, node.Body);
+        PushAll(pending, node.Update ?? []);
+        Require(node.TestFirst.HasValue);
+    }
+
+    private static void Dispatch(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        Push(pending, node.Subject);
+        Require(node.Cases is not null);
+        foreach (var branch in node.Cases!) Case(branch, owner, pending);
+    }
+
+    private static void Case(FlowCase? branch, FlowSpan owner, Stack<object> pending)
+    {
+        Require(branch is not null);
+        Require(branch!.Labels is not null);
+        Require(branch.Labels!.All(l => l is not null));
+        CheckSpan(branch.Span, owner);
+        PushAll(pending, branch.Body);
+    }
+
+    private static void Region(FlowStatement node, Stack<object> pending)
+    {
+        if (node.Kind == "region")
+        {
+            Require(node.Label is not null);
+            Require(node.Deferred.HasValue);
+        }
+        PushAll(pending, node.Body);
+    }
+
+    private static void Leaf(FlowStatement node)
+    {
+        switch (node.Kind)
+        {
+            case "action": Require(node.Text is not null); break;
+            case "break": case "continue": break;
+            case "unsupported": Require(node.Text is not null); Require(!string.IsNullOrWhiteSpace(node.Reason)); break;
+            default: throw Invalid("Unknown statement kind");
+        }
+    }
+}
diff --git a/src/CallAtlas.Core/FlowStatements.cs b/src/CallAtlas.Core/FlowStatements.cs
new file mode 100644
index 0000000..c989e28
--- /dev/null
+++ b/src/CallAtlas.Core/FlowStatements.cs
@@ -0,0 +1,120 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Statement(StatementSyntax statement, int depth)
+    {
+        Budget(depth);
+        try { return Structured(statement, depth); }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return Opaque(statement, problem.Message); }
+    }
+
+    private FlowStatement Structured(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            BlockSyntax block => new("block", span) { Body = Body(block, depth) },
+            EmptyStatementSyntax => new("action", span) { Text = ";" },
+            ExpressionStatementSyntax expression => new("evaluate", span) { Value = Expression(expression.Expression, depth + 1) },
+            LocalDeclarationStatementSyntax declaration when declaration.UsingKeyword.IsKind(SyntaxKind.None) =>
+                new("evaluate", span) { Value = Declaration(declaration.Declaration, depth + 1) },
+            LocalFunctionStatementSyntax local => new("region", span)
+            { Label = $"Local function {FlowText.Bounded(local.Identifier.ValueText)} (separate callable)", Deferred = true, Body = [] },
+            _ => TransferOrControl(statement, depth),
+        };
+    }
+
+    private FlowStatement TransferOrControl(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            ReturnStatementSyntax ret => new("return", span) { Value = ret.Expression is null ? null : Expression(ret.Expression, depth + 1) },
+            ThrowStatementSyntax thrown => new("throw", span)
+            { Value = thrown.Expression is null ? Value(thrown, "rethrow") : Expression(thrown.Expression, depth + 1) },
+            BreakStatementSyntax => new("break", span),
+            ContinueStatementSyntax => new("continue", span),
+            _ => ControlStatement(statement, depth),
+        };
+    }
+
+    private FlowStatement ControlStatement(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            IfStatementSyntax branch => new("if", span)
+            {
+                Condition = Condition(branch.Condition, depth + 1), ThenBranch = Body(branch.Statement, depth + 1),
+                ElseBranch = branch.Else is null ? [] : Body(branch.Else.Statement, depth + 1),
+            },
+            WhileStatementSyntax loop => new("loop", span)
+            { Condition = Condition(loop.Condition, depth + 1), Body = Body(loop.Statement, depth + 1), TestFirst = true },
+            DoStatementSyntax loop => new("loop", span)
+            { Condition = Condition(loop.Condition, depth + 1), Body = Body(loop.Statement, depth + 1), TestFirst = false },
+            ForStatementSyntax loop => For(loop, depth),
+            SwitchStatementSyntax dispatch => Switch(dispatch, depth),
+            _ => LifetimeStatement(statement, depth),
+        };
+    }
+
+    private FlowStatement LifetimeStatement(StatementSyntax statement, int depth)
+    {
+        return statement switch
+        {
+            TryStatementSyntax protectedStatement => Try(protectedStatement, depth),
+            UsingStatementSyntax usingStatement => Using(usingStatement, depth),
+            ForEachStatementSyntax forEach => Foreach(forEach, depth),
+            LockStatementSyntax lockStatement => Lock(lockStatement, depth),
+            _ => Opaque(statement, $"Unsupported {statement.Kind()} control flow"),
+        };
+    }
+
+    private FlowStatement For(ForStatementSyntax loop, int depth)
+    {
+        Budget(depth); // The lowered loop is an additional node inside the initialization block.
+        var initialization = new List<FlowStatement>();
+        if (loop.Declaration is not null)
+            initialization.Add(new("evaluate", source.Span(loop.Declaration)) { Value = Declaration(loop.Declaration, depth + 1) });
+        initialization.AddRange(loop.Initializers.Select(e => new FlowStatement("evaluate", source.Span(e)) { Value = Expression(e, depth + 1) }));
+        initialization.Add(new("loop", source.Span(loop))
+        {
+            Condition = loop.Condition is null ? null : Condition(loop.Condition, depth + 1),
+            Body = Body(loop.Statement, depth + 1), TestFirst = true,
+            Update = loop.Incrementors.Select(e => new FlowStatement("evaluate", source.Span(e)) { Value = Expression(e, depth + 1) }).ToArray(),
+        });
+        return new("block", source.Span(loop)) { Body = initialization };
+    }
+
+    private FlowStatement Switch(SwitchStatementSyntax dispatch, int depth)
+    {
+        if (dispatch.Sections.SelectMany(s => s.Labels).Any(l => l is not (CaseSwitchLabelSyntax or DefaultSwitchLabelSyntax)))
+            throw new FlowUnsupported("Pattern/guard switch dispatch is opaque");
+        var cases = dispatch.Sections.Select(section => Case(section, depth + 1)).ToArray();
+        return new("switch", source.Span(dispatch)) { Subject = Expression(dispatch.Expression, depth + 1), Cases = cases };
+    }
+
+    private FlowCase Case(SwitchSectionSyntax section, int depth)
+    {
+        Budget(depth);
+        var labels = section.Labels.OfType<CaseSwitchLabelSyntax>().Select(label =>
+        {
+            Budget(depth);
+            return FlowText.Label(label.Value);
+        }).ToArray();
+        return new(labels, source.Span(section), section.Labels.Any(l => l is DefaultSwitchLabelSyntax), false,
+            LexicalBody(section.Statements, 0, depth));
+    }
+
+    private FlowExpression Declaration(VariableDeclarationSyntax declaration, int depth)
+    {
+        Budget(depth);
+        return Sequence(declaration, declaration.Variables.Select(v => v.Initializer is null
+            ? Value(v, v.Identifier.ValueText) : Expression(v.Initializer.Value, depth + 1)).ToArray());
+    }
+}
diff --git a/src/CallAtlas.Core/FlowSuspension.cs b/src/CallAtlas.Core/FlowSuspension.cs
new file mode 100644
index 0000000..ce90262
--- /dev/null
+++ b/src/CallAtlas.Core/FlowSuspension.cs
@@ -0,0 +1,40 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal static class FlowSuspension
+{
+    internal static bool IsAsyncOrIterator(SyntaxNode body)
+    {
+        // A grouped top-level declaration is deferred; its separate callable owns its body.
+        if (DeferredDeclaration(body)) return false;
+        if (AsyncDeclaration(body.Parent)) return true;
+        return OwnNodes(body).Any(Suspends);
+    }
+
+    internal static bool HasYield(SyntaxNode body) => OwnNodes(body).Any(node => node is YieldStatementSyntax);
+
+    private static IEnumerable<SyntaxNode> OwnNodes(SyntaxNode body) => DeferredDeclaration(body)
+        ? [] : body.DescendantNodesAndSelf(node => node == body || !DeferredDeclaration(node));
+
+    private static bool DeferredDeclaration(SyntaxNode node) =>
+        node is AnonymousFunctionExpressionSyntax or LocalFunctionStatementSyntax;
+
+    private static bool AsyncDeclaration(SyntaxNode? node) => node switch
+    {
+        MethodDeclarationSyntax method => method.Modifiers.Any(token => token.IsKind(SyntaxKind.AsyncKeyword)),
+        LocalFunctionStatementSyntax local => local.Modifiers.Any(token => token.IsKind(SyntaxKind.AsyncKeyword)),
+        _ => false,
+    };
+
+    private static bool Suspends(SyntaxNode node) => node switch
+    {
+        AwaitExpressionSyntax or YieldStatementSyntax => true,
+        UsingStatementSyntax resource => !resource.AwaitKeyword.IsKind(SyntaxKind.None),
+        LocalDeclarationStatementSyntax resource => !resource.AwaitKeyword.IsKind(SyntaxKind.None),
+        CommonForEachStatementSyntax loop => !loop.AwaitKeyword.IsKind(SyntaxKind.None),
+        _ => false,
+    };
+}
