+using System.Text.Json;
+using System.Text.Json.Nodes;
+using CallAtlas.Core;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowCleanupTests
+{
+    private const string Resource = "using System; sealed class R:IDisposable { public void Dispose(){} } ";
+    private static JsonElement Run(string body) => Function(Snapshot(Resource + "class A { static R Make()=>new R(); static int Hit()=>1; int Run() {" + body + "} }"), "A::Run()");
+
+    [Fact]
+    public void Try_catch_finally_exports_existing_completion_contract_and_roundtrips()
+    {
+        var map=Snapshot(Resource + "class A { static int Hit()=>1; int Run() { try { return Hit(); } catch { throw; } finally { Hit(); } } }");
+        var statement=Function(map,"A::Run()").GetProperty("body")[0];
+        Assert.Equal("try",statement.GetProperty("kind").GetString());
+        Assert.True(statement.GetProperty("catches")[0].GetProperty("catch_all").GetBoolean());
+        Assert.NotEmpty(statement.GetProperty("finally").EnumerateArray());
+        var read=JsonDocument.Parse(CodeMapJson.Write(CodeMapJson.Read(map.GetRawText()))).RootElement;
+        Assert.Equal(map.GetProperty("flowInventory").GetRawText(),read.GetProperty("flowInventory").GetRawText());
+    }
+
+    [Fact]
+    public void Multiple_using_resources_acquire_in_order_and_cleanup_in_reverse()
+    {
+        var function=Run("using(R first=Make(), second=Make()) { return Hit(); }");
+        var scope=function.GetProperty("body")[0];
+        Assert.Equal("try",scope.GetProperty("kind").GetString());
+        Assert.Equal(2,scope.GetProperty("resources").GetArrayLength());
+        Assert.Equal(2,scope.GetProperty("cleanup").GetArrayLength());
+        Assert.Contains("second",scope.GetProperty("cleanup")[0].GetRawText());
+        Assert.Contains("first",scope.GetProperty("cleanup")[1].GetRawText());
+        Assert.Contains(Objects(scope.GetProperty("cleanup")),node=>node.TryGetProperty("text",out var text) && text.GetString()!.Contains("implicit non-null"));
+        Assert.All(Objects(scope.GetProperty("cleanup")).Where(node=>node.TryGetProperty("targets",out _)),call=>Assert.Empty(call.GetProperty("targets").EnumerateArray()));
+    }
+
+    [Fact]
+    public void Using_declarations_protect_the_lexical_suffix_including_top_level()
+    {
+        var function=Run("using var first=Make(); Hit(); using var second=Make(); return Hit();");
+        var scope=function.GetProperty("body")[0];
+        Assert.Equal("try",scope.GetProperty("kind").GetString());
+        Assert.Contains(Objects(scope.GetProperty("body")),node=>node.TryGetProperty("kind",out var kind) && kind.GetString()=="try");
+        var top=Snapshot("using var resource=new R(); System.Console.WriteLine(1); class R:System.IDisposable { public void Dispose(){} }");
+        var topFlow=top.GetProperty("flowInventory").GetProperty("functions").EnumerateArray().Single(f=>f.GetProperty("symbol").GetString()!.EndsWith("Program::<top-level>"));
+        Assert.Equal("try",topFlow.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.Contains("WriteLine",topFlow.GetProperty("body")[0].GetProperty("body").GetRawText());
+    }
+
+    [Fact]
+    public void Foreach_and_monitor_lock_use_proven_implicit_operations_without_native_targets()
+    {
+        var map=Snapshot("using System; sealed class E:IDisposable { public int Current=>1; public bool MoveNext()=>false; public void Dispose(){} } sealed class S { public E GetEnumerator()=>new E(); } class A { void Run(){ foreach(var item in new S()) { if(item==0)continue; break; } } void Locked(object gate){ lock(gate){ Run(); } } }");
+        var function=Function(map,"A::Run()");
+        var labels=Objects(function.GetProperty("body")).Where(n=>n.TryGetProperty("label",out _) && n.TryGetProperty("targets",out _)).Select(n=>n.GetProperty("label").GetString()!).ToArray();
+        foreach(var operation in new[]{"GetEnumerator","MoveNext","Current","Dispose"}) Assert.Contains(labels,label=>label.Contains(operation));
+        var locked=Function(map,"A::Locked(System.Object)");
+        var scope=Objects(locked.GetProperty("body")).Single(n=>n.TryGetProperty("kind",out var kind) && kind.GetString()=="try");
+        Assert.Empty(scope.GetProperty("resources").EnumerateArray());
+        Assert.Contains("Enter",scope.GetProperty("body").GetRawText());
+        Assert.Contains("lockTaken",scope.GetProperty("finally").GetRawText());
+        Assert.Contains("Exit",scope.GetProperty("finally").GetRawText());
+    }
+
+    [Fact]
+    public void Filtered_catches_are_partial_and_preserve_explicit_exceptional_outcomes()
+    {
+        var map=Snapshot("using System; class A { static bool Filter()=>true; int Run(){ try { throw new Exception(); } catch(Exception e) when(Filter()) { return 1; } finally { System.Console.WriteLine(2); } } }");
+        var function=Function(map,"A::Run()");
+        Assert.Contains(Objects(function.GetProperty("body")),n=>n.TryGetProperty("kind",out var kind) && kind.GetString()=="if");
+        Assert.Contains(Objects(function.GetProperty("body")),n=>n.TryGetProperty("kind",out var kind) && kind.GetString()=="throw");
+        Assert.DoesNotContain(Objects(function.GetProperty("body")),n=>n.TryGetProperty("targets",out var targets) && targets.EnumerateArray().Any(t=>t.GetProperty("symbol").GetString()!.Contains("Filter()")));
+        Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+        Assert.True(function.GetProperty("span").GetProperty("start").GetInt32()>0);
+        CodeMapJson.Read(map.GetRawText()); // Nested zero spans are the same unlocated sentinel as shared core.
+    }
+
+    [Fact]
+    public void Many_flat_resources_hit_synthetic_depth_budget()
+    {
+        var resources=string.Join(",",Enumerable.Range(0,30).Select(index=>"r"+index+"=Make()"));
+        var function=Run("using(R "+resources+") { return 1; }");
+        Assert.Equal("unsupported",function.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.Contains(function.GetProperty("diagnostics").EnumerateArray(),d=>d.GetString()!.Contains("24"));
+    }
+
+    [Fact]
+    public void Malformed_try_contracts_are_rejected_before_consumption()
+    {
+        var baseline=Snapshot("class A { void Run(){try{} finally{}} }").GetRawText();
+        Action<JsonObject>[] mutations=
+        [
+            scope=>scope.Remove("resources"),
+            scope=>scope.Remove("body"),
+            scope=>scope.Remove("catches"),
+            scope=>scope.Remove("finally"),
+            scope=>scope.Remove("cleanup"),
+            scope=>scope["resources"]=null,
+            scope=>scope["body"]=null,
+            scope=>scope["catches"]=null,
+            scope=>scope["finally"]=null,
+            scope=>scope["cleanup"]=null,
+            scope=>scope["catches"]=new JsonArray(new JsonObject{["parameter"]="all",["catch_all"]=true,["body"]=null}),
+            scope=>scope["catches"]=new JsonArray((JsonNode?)null),
+            scope=>scope["catches"]=new JsonArray(new JsonObject{["parameter"]="all",["body"]=new JsonArray()}),
+            scope=>scope["catches"]=new JsonArray(new JsonObject{["parameter"]="all",["catch_all"]=true}),
+            scope=>scope["catches"]=new JsonArray(new JsonObject{["catch_all"]=true,["body"]=new JsonArray()}),
+            scope=>scope["resources"]=new JsonArray(new JsonObject{["kind"]="action",["span"]=new JsonObject{["start"]=0,["end"]=0},["text"]="acquire"}),
+            scope=>scope["span"]!["end"]=999999,
+        ];
+        foreach(var mutation in mutations)
+        {
+            var map=JsonNode.Parse(baseline)!;
+            mutation(map["flowInventory"]!["functions"]![0]!["body"]![0]!.AsObject());
+            Assert.Throws<CallAtlasException>(()=>CodeMapJson.Read(map.ToJsonString()));
+        }
+    }
+
+    [Fact]
+    public void Captured_null_nullable_and_runtime_enumerator_guards_are_explicit()
+    {
+        var map=Snapshot("using System; using System.Collections; struct R:IDisposable {public void Dispose(){}} class A { void Nullable(R? value){using(value){}} void Runtime(IEnumerable values){foreach(var value in values){}} }");
+        Assert.Contains("HasValue",Function(map,"A::Nullable(R?)").GetRawText());
+        Assert.Contains("runtime IDisposable",Function(map,"A::Runtime(System.Collections.IEnumerable)").GetRawText());
+        var directNull=Run("using((R)null){ return 1; }");
+        Assert.DoesNotContain(Objects(directNull.GetProperty("body")),node=>node.TryGetProperty("label",out var label) && label.GetString()!.Contains("Dispose"));
+    }
+
+    [Fact]
+    public void Unsupported_foreach_conversions_and_specialized_locks_remain_partial()
+    {
+        var map=Snapshot("using System.Collections.Generic; class A { void Converted(List<int> values){foreach(double value in values){}} void Specialized(System.Threading.Lock gate){lock(gate){}} }");
+        foreach(var suffix in new[]{"A::Converted(System.Collections.Generic.List<System.Int32>)","A::Specialized(System.Threading.Lock)"})
+        {
+            var function=Function(map,suffix);
+            Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+            Assert.DoesNotContain(Objects(function.GetProperty("body")),node=>node.TryGetProperty("label",out var label) && label.GetString()!.StartsWith("synthetic C#: Monitor"));
+        }
+    }
+    [Fact]
+    public void Await_keywords_and_deconstruction_remain_non_eager_partial_regions()
+    {
+        var map=Snapshot("using System; using System.Collections.Generic; using System.Threading.Tasks; class R:IAsyncDisposable {public ValueTask DisposeAsync()=>default;} class A { async Task Using(R r){await using(r){System.Console.WriteLine(1);}} async Task Each(IAsyncEnumerable<int> items){await foreach(var item in items){System.Console.WriteLine(item);}} void Deconstruct(List<(int,int)> items){foreach(var (a,b) in items){System.Console.WriteLine(a);}} }");
+        foreach(var function in map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray().Where(f=>f.GetProperty("symbol").GetString()!.Contains("A::")))
+        {
+            Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+            Assert.DoesNotContain(Objects(function.GetProperty("body")),node=>node.TryGetProperty("label",out var label) && label.GetString()!.Contains("WriteLine"));
+        }
+    }
+
+    [Fact]
+    public void Legacy_monitor_contract_does_not_claim_modern_lockTaken_lowering()
+    {
+        var map=Snapshot("namespace System.Threading { public static class Monitor { public static void Enter(object gate){} public static void Exit(object gate){} } } class A { void Run(object gate){lock(gate){}} }");
+        var function=Function(map,"A::Run(System.Object)");
+        Assert.Contains(function.GetProperty("diagnostics").EnumerateArray(),item=>item.GetString()!.Contains("Modern Monitor.Enter"));
+        Assert.DoesNotContain(Objects(function.GetProperty("body")),node=>node.TryGetProperty("label",out var label) && label.GetString()!.StartsWith("synthetic C#: Monitor"));
+    }
+
+    [Fact]
+    public void Unsupported_using_declaration_explicitly_owns_its_remaining_scope()
+    {
+        var function=Run("using dynamic resource=Make(); Hit(); return 1;");
+        var region=function.GetProperty("body")[0];
+        var opaque=region.GetProperty("body")[0];
+        Assert.Contains("remaining lexical scope",opaque.GetProperty("reason").GetString());
+        Assert.True(opaque.GetProperty("span").GetProperty("end").GetInt32()>opaque.GetProperty("span").GetProperty("start").GetInt32()+40);
+        Assert.Contains("remaining lexical scope",opaque.GetProperty("text").GetString());
+    }
+
+    [Fact]
+    public void Top_level_await_using_keyword_hides_its_entire_continuation()
+    {
+        var map=Snapshot("await using var resource=new R(); System.Console.WriteLine(1); class R:System.IAsyncDisposable {public System.Threading.Tasks.ValueTask DisposeAsync()=>default;}");
+        var function=Function(map,"Program::<top-level>");
+        Assert.NotEmpty(function.GetProperty("diagnostics").EnumerateArray());
+        Assert.Equal("unsupported",function.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.DoesNotContain(Objects(function.GetProperty("body")),node=>node.TryGetProperty("label",out var label) && label.GetString()!.Contains("WriteLine"));
+
+    }
+
+    [Fact]
+    public void Top_level_await_foreach_makes_the_callable_opaque_without_eager_suffix()
+    {
+        var map=Snapshot("await foreach(var value in new S()){} Hit(); static void Hit(){} class S {public E GetAsyncEnumerator()=>new E();} class E:System.IAsyncDisposable {public int Current=>1; public System.Threading.Tasks.ValueTask<bool> MoveNextAsync()=>default; public System.Threading.Tasks.ValueTask DisposeAsync()=>default;}");
+        var function=Function(map,"Program::<top-level>");
+        Assert.Equal("unsupported",function.GetProperty("body")[0].GetProperty("kind").GetString());
+        Assert.DoesNotContain(Objects(function.GetProperty("body")),node=>node.TryGetProperty("targets",out var targets) && targets.EnumerateArray().Any(target=>target.GetProperty("symbol").GetString()!.EndsWith("::Hit#local")));
+    }
+
+    [Fact]
+    public void Deferred_async_declarations_do_not_infect_top_level_execution()
+    {
+        var map=Snapshot("async System.Threading.Tasks.Task Local(){await System.Threading.Tasks.Task.Delay(1);} System.Func<System.Threading.Tasks.Task> lambda=async()=>{await System.Threading.Tasks.Task.Delay(1);}; Hit(); static void Hit(){}");
+        var function=Function(map,"Program::<top-level>");
+        Assert.Contains(Objects(function.GetProperty("body")),node=>node.TryGetProperty("targets",out var targets) && targets.EnumerateArray().Any(target=>target.GetProperty("symbol").GetString()!.EndsWith("::Hit#local")));
+        var local=map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray().Single(flow=>flow.GetProperty("symbol").GetString()!.EndsWith("::Local#local"));
+        Assert.Equal("unsupported",local.GetProperty("body")[0].GetProperty("kind").GetString());
+    }
+
+}
