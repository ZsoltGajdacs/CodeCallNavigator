+using System.Text.Json;
+using CallAtlas.Core;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+using Xunit;
+using static CallAtlas.Tests.FlowFactsTests;
+
+namespace CallAtlas.Tests;
+
+public class FlowOwnershipTests
+{
+    [Theory]
+    [InlineData("int Run(bool b){if(b){int F()=>1;return F();}else{int F()=>2;return F();}}", "localfunction", 2)]
+    [InlineData("int F()=>1; int F<T>()=>2; int Run()=>F()+F<int>();", "method", 2)]
+    public void Aliased_native_ids_do_not_claim_one_unambiguous_flow_body(string declaration, string kind, int existingEdgeCount)
+    {
+        var map = Snapshot("class A { " + declaration + " }");
+        var local = Assert.Single(map.GetProperty("nodes").EnumerateArray(), node =>
+            node.GetProperty("kind").GetString() == kind && node.GetProperty("name").GetString() == "F");
+        var symbol = local.GetProperty("id").GetString();
+        Assert.Contains(map.GetProperty("edges").EnumerateArray(), edge =>
+            edge.GetProperty("to").GetString() == symbol && edge.GetProperty("count").GetInt32() == existingEdgeCount);
+        Assert.DoesNotContain(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray(),
+            function => function.GetProperty("symbol").GetString() == symbol);
+        AssertValidSource(map);
+    }
+
+    [Theory]
+    [InlineData("abstract class A { public abstract int F(); public int F<T>()=>2; }", "F")]
+    [InlineData("abstract class A { public abstract int P {get;} public int get_P<T>()=>2; public int Run()=>P; }", "get_P")]
+    public void Bodyless_native_declaration_alias_does_not_claim_another_methods_body(string source, string name)
+    {
+        var map = Snapshot(source);
+        var method = Assert.Single(map.GetProperty("nodes").EnumerateArray(), node => node.GetProperty("name").GetString() == name);
+        Assert.DoesNotContain(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray(),
+            function => function.GetProperty("symbol").GetString() == method.GetProperty("id").GetString());
+        if (name == "get_P")
+            Assert.Equal("CS0082", Assert.Single(map.GetProperty("diagnostics").EnumerateArray()).GetProperty("id").GetString());
+        else AssertValidSource(map);
+    }
+
+    [Fact]
+    public void Partial_definition_and_implementation_remain_one_source_callable()
+    {
+        var map = Snapshot("partial class A { partial void F(); partial void F(){} }");
+        AssertValidSource(map);
+        var function = Function(map, "A::F()");
+        Assert.Empty(function.GetProperty("body").EnumerateArray());
+        Assert.Empty(function.GetProperty("diagnostics").EnumerateArray());
+    }
+
+    [Fact]
+    public void Cross_file_partial_definition_retains_graph_without_misattributed_flow()
+    {
+        var map = JsonDocument.Parse(CodeMapJson.Write(CallGraphBuilder.Build(
+            [("/proj/definition.cs", "partial class A { partial void F(); }"),
+             ("/proj/implementation.cs", "partial class A { partial void F(){} }")], "/proj"))).RootElement;
+        var method = Assert.Single(map.GetProperty("nodes").EnumerateArray(), node => node.GetProperty("name").GetString() == "F");
+        Assert.Equal("definition.cs:1", method.GetProperty("location").GetString());
+        Assert.DoesNotContain(map.GetProperty("flowInventory").GetProperty("functions").EnumerateArray(),
+            function => function.GetProperty("symbol").GetString() == method.GetProperty("id").GetString());
+        AssertValidSource(map);
+    }
+
+    [Fact]
+    public void Implementation_first_cross_file_partial_retains_its_matching_source_flow()
+    {
+        var map = JsonDocument.Parse(CodeMapJson.Write(CallGraphBuilder.Build(
+            [("/proj/implementation.cs", "partial class A { partial void F(){} }"),
+             ("/proj/definition.cs", "partial class A { partial void F(); }")], "/proj"))).RootElement;
+        var method = Assert.Single(map.GetProperty("nodes").EnumerateArray(), node => node.GetProperty("name").GetString() == "F");
+        Assert.Equal("implementation.cs:1", method.GetProperty("location").GetString());
+        Assert.Equal("/proj/implementation.cs", Function(map, "A::F()").GetProperty("file").GetString());
+        AssertValidSource(map);
+    }
+
+    [Fact]
+    public void Identical_body_sites_are_deduplicated_before_source_selection()
+    {
+        var tree = CSharpSyntaxTree.ParseText("class A { void F(){} }", path: "/proj/a.cs");
+        var model = CSharpCompilation.Create("sample", [tree]).GetSemanticModel(tree);
+        var declaration = tree.GetRoot().DescendantNodes().OfType<MethodDeclarationSyntax>().Single();
+        var symbol = (IMethodSymbol)model.GetDeclaredSymbol(declaration)!;
+        var input = new FlowInput(SymbolId.Canonical(symbol), tree, model, [declaration.Body!], symbol);
+        var node = new Node { Id = input.Symbol, Kind = "method", Name = symbol.Name,
+            Container = symbol.ContainingType.Name, Location = "a.cs:1" };
+        var selected = new FlowOwnership().Select([input, input], node, "/proj");
+        Assert.NotNull(selected);
+        Assert.Same(declaration.Body, Assert.Single(selected.Bodies));
+    }
+
+    [Fact]
+    public void Distinct_top_level_sites_remain_one_ordered_callable()
+    {
+        var map = Snapshot("System.Console.WriteLine(1); System.Console.WriteLine(2);");
+        var function = Function(map, "Program::<top-level>");
+        var calls = Objects(function.GetProperty("body")).Where(node => node.TryGetProperty("targets", out _)).ToArray();
+        Assert.Equal(new[] { "System.Console.WriteLine(1)", "System.Console.WriteLine(2)" },
+            calls.Select(call => call.GetProperty("label").GetString()));
+        Assert.Empty(function.GetProperty("diagnostics").EnumerateArray());
+    }
+
+    private static void AssertValidSource(JsonElement map)
+    {
+        Assert.Equal(0, map.GetProperty("bodyErrorCount").GetInt32());
+        Assert.Empty(map.GetProperty("diagnostics").EnumerateArray());
+    }
+}
