new file mode 100644
index 0000000..3a9a62f
--- /dev/null
+++ b/src/CallAtlas.Core/FlowText.cs
@@ -0,0 +1,17 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal static class FlowText
+{
+    internal static string Bounded(string text) => text.Length <= 512 ? text : text[..512] + "…";
+    /// <summary>Labels stay bounded; full source is addressed through the immutable byte span.</summary>
+    internal static string Label(SyntaxNode node)
+    {
+        const int maximum = 512;
+        var text = node.SyntaxTree.GetText();
+        var length = Math.Min(node.Span.Length, maximum);
+        if (length < node.Span.Length && length > 0 && char.IsHighSurrogate(text[node.SpanStart + length - 1])) length--;
+        return text.ToString(new(node.SpanStart, length)) + (length < node.Span.Length ? "…" : "");
+    }
+}
diff --git a/src/CallAtlas.Core/FlowUsing.cs b/src/CallAtlas.Core/FlowUsing.cs
new file mode 100644
index 0000000..3fffae3
--- /dev/null
+++ b/src/CallAtlas.Core/FlowUsing.cs
@@ -0,0 +1,97 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal enum CleanupGuard { None, NonNull, HasValue, RuntimeDisposable, Never }
+internal sealed record FlowResource(SyntaxNode Owner, ExpressionSyntax Initializer, string Name, CleanupGuard Guard);
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Using(UsingStatementSyntax statement, int depth)
+    {
+        if (!statement.AwaitKeyword.IsKind(SyntaxKind.None))
+            return OpaqueCompletion(statement, "Await using resource lifetime and suspension are opaque");
+        try
+        {
+            var resources = statement.Declaration is null
+                ? new[] { Resource(statement.Expression!, "using expression") }
+                : Resources(statement.Declaration, depth);
+            Budget(depth + resources.Length);
+            return UsingScope(statement, resources, Body(statement.Statement, depth + resources.Length + 1), depth);
+        }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return OpaqueCompletion(statement, problem.Message); }
+    }
+
+    private FlowResource[] Resources(VariableDeclarationSyntax declaration, int depth)
+    {
+        Budget(depth + declaration.Variables.Count);
+        return declaration.Variables.Select(variable =>
+        {
+            if (variable.Initializer is null || model.GetDeclaredSymbol(variable) is not ILocalSymbol local)
+                throw new FlowUnsupported("Using resource has no compiler-resolved initialized local");
+            return Resource(variable.Initializer.Value, FlowText.Bounded(variable.Identifier.ValueText), local.Type, variable);
+        }).ToArray();
+    }
+
+    private FlowResource Resource(ExpressionSyntax initializer, string name, ITypeSymbol? declared = null, SyntaxNode? owner = null)
+    {
+        var type = declared ?? model.GetTypeInfo(initializer).Type ?? model.GetTypeInfo(initializer).ConvertedType;
+        if (type is null) throw new FlowUnsupported("Using expression has no compiler-resolved resource type");
+        return new(owner ?? initializer, initializer, name, DisposableGuard(type, initializer));
+    }
+
+    private CleanupGuard DisposableGuard(ITypeSymbol type, ExpressionSyntax? initializer = null)
+    {
+        if (type.TypeKind == TypeKind.Dynamic || type.IsRefLikeType)
+            throw new FlowUnsupported("Dynamic/ref-like pattern disposal is opaque");
+        ProveDisposableConversion(type);
+        if (initializer is not null && model.GetConstantValue(initializer) is { HasValue: true, Value: null }) return CleanupGuard.Never;
+        if (type is INamedTypeSymbol { OriginalDefinition.SpecialType: SpecialType.System_Nullable_T }) return CleanupGuard.HasValue;
+        if (type.IsReferenceType) return CleanupGuard.NonNull;
+        if (type.IsValueType) return CleanupGuard.None;
+        throw new FlowUnsupported("Resource value/reference cleanup category is unresolved");
+    }
+
+    private void ProveDisposableConversion(ITypeSymbol type)
+    {
+        var disposable = model.Compilation.GetSpecialType(SpecialType.System_IDisposable);
+        var conversion = ((CSharpCompilation)model.Compilation).ClassifyConversion(type, disposable);
+        if (!conversion.IsImplicit || conversion.IsUserDefined)
+            throw new FlowUnsupported("Resource has no proven standard IDisposable conversion");
+    }
+
+    private FlowStatement UsingScope(SyntaxNode owner, IReadOnlyList<FlowResource> resources,
+        IReadOnlyList<FlowStatement> body, int depth)
+    {
+        Budget(depth + resources.Count); // Shared core recursively nests each acquisition, even a flat declaration.
+        var acquire = resources.Select(resource => Acquire(resource, depth + resources.Count)).ToArray();
+        var cleanup = resources.Reverse().Select(resource => Dispose(resource.Owner, resource.Name, resource.Guard)).ToArray();
+        return Protected(owner, body) with { Resources = acquire, Cleanup = cleanup };
+    }
+
+    private FlowStatement Acquire(FlowResource resource, int depth)
+    {
+        Budget(depth);
+        var value = Sequence(resource.Owner, [Expression(resource.Initializer, depth + 1),
+            SyntheticValue(resource.Owner, "capture using resource " + resource.Name + " once")]);
+        return EvaluateSynthetic(resource.Owner, value);
+    }
+
+    private FlowStatement Dispose(SyntaxNode owner, string name, CleanupGuard guard)
+    {
+        Budget(0);
+        if (guard == CleanupGuard.Never) return new("block", source.Span(owner)) { Body = [] };
+        var dispose = EvaluateSynthetic(owner, ImplicitCall(owner, ImplicitFlowOperation.Dispose, name));
+        if (guard == CleanupGuard.None) return dispose;
+        var check = guard switch
+        {
+            CleanupGuard.HasValue => "implicit HasValue check on captured ",
+            CleanupGuard.RuntimeDisposable => "runtime IDisposable check on captured ",
+            _ => "implicit non-null check on captured ",
+        };
+        return new("if", source.Span(owner))
+        { Condition = SyntheticValue(owner, check + name), ThenBranch = [dispose], ElseBranch = [] };
+    }
+}
diff --git a/src/CallAtlas.Core/FlowUtf8Offsets.cs b/src/CallAtlas.Core/FlowUtf8Offsets.cs
new file mode 100644
index 0000000..6f0b625
--- /dev/null
+++ b/src/CallAtlas.Core/FlowUtf8Offsets.cs
@@ -0,0 +1,27 @@
+using System.Text;
+
+namespace CallAtlas.Core;
+
+internal static class FlowUtf8Offsets
+{
+    internal static int[] Convert(string text, int prefix)
+    {
+        var offsets = new int[text.Length + 1];
+        var count = prefix;
+        for (var index = 0; index < text.Length; index++)
+        {
+            offsets[index] = count;
+            if (IsPair(text, index))
+            {
+                offsets[++index] = count;
+                count += 4;
+            }
+            else count += Encoding.UTF8.GetByteCount(text.AsSpan(index, 1));
+        }
+        offsets[^1] = count;
+        return offsets;
+    }
+
+    private static bool IsPair(string text, int index) => index + 1 < text.Length
+        && char.IsHighSurrogate(text[index]) && char.IsLowSurrogate(text[index + 1]);
+}
diff --git a/src/CallAtlas.Core/FlowValidation.cs b/src/CallAtlas.Core/FlowValidation.cs
new file mode 100644
index 0000000..a779b1e
--- /dev/null
+++ b/src/CallAtlas.Core/FlowValidation.cs
@@ -0,0 +1,66 @@
+namespace CallAtlas.Core;
+
+/// <summary>Validate detached facts once at the JSON boundary, before consumers trust the tagged records.</summary>
+internal static partial class FlowValidation
+{
+    internal static void Validate(FlowInventory inventory)
+    {
+        Require(inventory.Version == 1);
+        Require(inventory.Functions is not null);
+        var symbols = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var function in inventory.Functions!)
+        {
+            Identity(function, symbols);
+            Require(function.Body is not null);
+            Require(function.Diagnostics is not null);
+            Require(function.Diagnostics!.All(d => d is not null));
+            ValidateBody(function);
+        }
+    }
+
+    private static void Identity(FunctionFlow? function, HashSet<string> symbols)
+    {
+        Require(function is not null);
+        Require(!string.IsNullOrWhiteSpace(function!.Symbol));
+        Require(symbols.Add(function.Symbol));
+        Require(function.File is not null);
+        Require(function.Build is not null);
+        Require(function.Project is not null);
+        Require(function.Language == "csharp");
+    }
+
+    internal static void ValidateBody(FunctionFlow function)
+    {
+        CheckSpan(function.Span, function.Span);
+        var pending = new Stack<object>(function.Body.Cast<object>());
+        var count = 0;
+        while (pending.TryPop(out var item))
+        {
+            if (++count > 1500) throw new FlowUnsupported("Flow inventory exceeds 1500 IR nodes", true);
+            switch (item)
+            {
+                case FlowStatement statement: Statement(statement, function.Span, pending); break;
+                case FlowCatch clause: Catch(clause, pending); break;
+                case FlowExpression expression: Expression(expression, function.Span, pending); break;
+                default: throw Invalid("Null or invalid flow node");
+            }
+        }
+    }
+
+    private static void CheckSpan(FlowSpan? span, FlowSpan? owner)
+    {
+        Require(span is not null);
+        Require(owner is not null);
+        if (span is { Start: 0, End: 0 }) return; // Same version-1 unlocated/synthetic sentinel as shared core.
+        Require(span!.Start >= 0);
+        Require(span.End >= span.Start);
+        Require(span.Start >= owner!.Start);
+        Require(span.End <= owner.End);
+    }
+
+    private static void Push(Stack<object> pending, object? node) { Require(node is not null); pending.Push(node!); }
+    private static void PushAll<T>(Stack<object> pending, IReadOnlyList<T>? items)
+    { Require(items is not null); foreach (var item in items!) Push(pending, item); }
+    private static void Require(bool valid) { if (!valid) throw Invalid("Incomplete or invalid flow node"); }
+    private static CallAtlasException Invalid(string message) => new(message + "; regenerate flow facts.");
+}
