@@ -0,0 +1,22 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+/// <summary>One conversion table per tree; offsets refer to the original UTF-8 bytes, including its BOM.</summary>
+internal sealed class FlowSource
+{
+    private readonly int[] offsets;
+    internal string? Problem { get; }
+
+    internal FlowSource(SyntaxTree tree, string root)
+    {
+        var text = tree.GetText().ToString();
+        var file = Path.IsPathRooted(tree.FilePath) ? tree.FilePath : Path.Combine(root, tree.FilePath);
+        var original = FlowOriginalSource.Check(file, text);
+        Problem = original.Problem;
+        offsets = FlowUtf8Offsets.Convert(text, original.Prefix);
+    }
+
+    internal FlowSpan Span(SyntaxNode node) => Problem is null
+        ? new(offsets[node.SpanStart], offsets[node.Span.End]) : new(0, 0);
+}
diff --git a/src/CallAtlas.Core/FlowStatementValidation.cs b/src/CallAtlas.Core/FlowStatementValidation.cs
new file mode 100644
index 0000000..f04bb77
--- /dev/null
+++ b/src/CallAtlas.Core/FlowStatementValidation.cs
@@ -0,0 +1,64 @@
+namespace CallAtlas.Core;
+
+internal static partial class FlowValidation
+{
+    private static void Statement(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        CheckSpan(node.Span, owner);
+        switch (node.Kind)
+        {
+            case "evaluate": case "throw": Push(pending, node.Value); break;
+            case "return": if (node.Value is not null) pending.Push(node.Value); break;
+            case "if": case "loop": case "switch": Control(node, owner, pending); break;
+            case "block": case "region": Region(node, pending); break;
+            default: Leaf(node); break;
+        }
+    }
+
+    private static void Control(FlowStatement node, FlowSpan owner, Stack<object> pending)
+    {
+        switch (node.Kind)
+        {
+            case "if":
+                Push(pending, node.Condition); PushAll(pending, node.ThenBranch); PushAll(pending, node.ElseBranch); break;
+            case "loop":
+                if (node.Condition is not null) pending.Push(node.Condition);
+                PushAll(pending, node.Body); PushAll(pending, node.Update ?? []);
+                Require(node.TestFirst.HasValue); break;
+            case "switch":
+                Push(pending, node.Subject); Require(node.Cases is not null);
+                foreach (var branch in node.Cases!) Case(branch, owner, pending);
+                break;
+        }
+    }
+
+    private static void Case(FlowCase? branch, FlowSpan owner, Stack<object> pending)
+    {
+        Require(branch is not null);
+        Require(branch!.Labels is not null);
+        Require(branch.Labels!.All(l => l is not null));
+        CheckSpan(branch.Span, owner);
+        PushAll(pending, branch.Body);
+    }
+
+    private static void Region(FlowStatement node, Stack<object> pending)
+    {
+        if (node.Kind == "region")
+        {
+            Require(node.Label is not null);
+            Require(node.Deferred.HasValue);
+        }
+        PushAll(pending, node.Body);
+    }
+
+    private static void Leaf(FlowStatement node)
+    {
+        switch (node.Kind)
+        {
+            case "action": Require(node.Text is not null); break;
+            case "break": case "continue": break;
+            case "unsupported": Require(node.Text is not null); Require(!string.IsNullOrWhiteSpace(node.Reason)); break;
+            default: throw Invalid("Unknown statement kind");
+        }
+    }
+}
diff --git a/src/CallAtlas.Core/FlowStatements.cs b/src/CallAtlas.Core/FlowStatements.cs
new file mode 100644
index 0000000..3bc069e
--- /dev/null
+++ b/src/CallAtlas.Core/FlowStatements.cs
@@ -0,0 +1,108 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+internal sealed partial class FlowBody
+{
+    private FlowStatement Statement(StatementSyntax statement, int depth)
+    {
+        Budget(depth);
+        try { return Structured(statement, depth); }
+        catch (FlowUnsupported problem) when (!problem.Limit) { return Opaque(statement, problem.Message); }
+    }
+
+    private FlowStatement Structured(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            BlockSyntax block => new("block", span) { Body = Body(block, depth) },
+            EmptyStatementSyntax => new("action", span) { Text = ";" },
+            ExpressionStatementSyntax expression => new("evaluate", span) { Value = Expression(expression.Expression, depth + 1) },
+            LocalDeclarationStatementSyntax declaration when declaration.UsingKeyword.IsKind(SyntaxKind.None) =>
+                new("evaluate", span) { Value = Declaration(declaration.Declaration, depth + 1) },
+            LocalFunctionStatementSyntax local => new("region", span)
+            { Label = $"Local function {FlowText.Bounded(local.Identifier.ValueText)} (separate callable)", Deferred = true, Body = [] },
+            _ => TransferOrControl(statement, depth),
+        };
+    }
+
+    private FlowStatement TransferOrControl(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            ReturnStatementSyntax ret => new("return", span) { Value = ret.Expression is null ? null : Expression(ret.Expression, depth + 1) },
+            ThrowStatementSyntax thrown => new("throw", span)
+            { Value = thrown.Expression is null ? Value(thrown, "rethrow") : Expression(thrown.Expression, depth + 1) },
+            BreakStatementSyntax => new("break", span),
+            ContinueStatementSyntax => new("continue", span),
+            _ => ControlStatement(statement, depth),
+        };
+    }
+
+    private FlowStatement ControlStatement(StatementSyntax statement, int depth)
+    {
+        var span = source.Span(statement);
+        return statement switch
+        {
+            IfStatementSyntax branch => new("if", span)
+            {
+                Condition = Condition(branch.Condition, depth + 1), ThenBranch = Body(branch.Statement, depth + 1),
+                ElseBranch = branch.Else is null ? [] : Body(branch.Else.Statement, depth + 1),
+            },
+            WhileStatementSyntax loop => new("loop", span)
+            { Condition = Condition(loop.Condition, depth + 1), Body = Body(loop.Statement, depth + 1), TestFirst = true },
+            DoStatementSyntax loop => new("loop", span)
+            { Condition = Condition(loop.Condition, depth + 1), Body = Body(loop.Statement, depth + 1), TestFirst = false },
+            ForStatementSyntax loop => For(loop, depth),
+            SwitchStatementSyntax dispatch => Switch(dispatch, depth),
+            _ => Opaque(statement, $"Unsupported {statement.Kind()} control flow"),
+        };
+    }
+
+    private FlowStatement For(ForStatementSyntax loop, int depth)
+    {
+        Budget(depth); // The lowered loop is an additional node inside the initialization block.
+        var initialization = new List<FlowStatement>();
+        if (loop.Declaration is not null)
+            initialization.Add(new("evaluate", source.Span(loop.Declaration)) { Value = Declaration(loop.Declaration, depth + 1) });
+        initialization.AddRange(loop.Initializers.Select(e => new FlowStatement("evaluate", source.Span(e)) { Value = Expression(e, depth + 1) }));
+        initialization.Add(new("loop", source.Span(loop))
+        {
+            Condition = loop.Condition is null ? null : Condition(loop.Condition, depth + 1),
+            Body = Body(loop.Statement, depth + 1), TestFirst = true,
+            Update = loop.Incrementors.Select(e => new FlowStatement("evaluate", source.Span(e)) { Value = Expression(e, depth + 1) }).ToArray(),
+        });
+        return new("block", source.Span(loop)) { Body = initialization };
+    }
+
+    private FlowStatement Switch(SwitchStatementSyntax dispatch, int depth)
+    {
+        if (dispatch.Sections.SelectMany(s => s.Labels).Any(l => l is not (CaseSwitchLabelSyntax or DefaultSwitchLabelSyntax)))
+            throw new FlowUnsupported("Pattern/guard switch dispatch is opaque");
+        var cases = dispatch.Sections.Select(section => Case(section, depth + 1)).ToArray();
+        return new("switch", source.Span(dispatch)) { Subject = Expression(dispatch.Expression, depth + 1), Cases = cases };
+    }
+
+    private FlowCase Case(SwitchSectionSyntax section, int depth)
+    {
+        Budget(depth);
+        var labels = section.Labels.OfType<CaseSwitchLabelSyntax>().Select(label =>
+        {
+            Budget(depth);
+            return FlowText.Label(label.Value);
+        }).ToArray();
+        return new(labels, source.Span(section), section.Labels.Any(l => l is DefaultSwitchLabelSyntax), false,
+            section.Statements.Select(s => Statement(s, depth + 1)).ToArray());
+    }
+
+    private FlowExpression Declaration(VariableDeclarationSyntax declaration, int depth)
+    {
+        Budget(depth);
+        return Sequence(declaration, declaration.Variables.Select(v => v.Initializer is null
+            ? Value(v, v.Identifier.ValueText) : Expression(v.Initializer.Value, depth + 1)).ToArray());
+    }
+}
