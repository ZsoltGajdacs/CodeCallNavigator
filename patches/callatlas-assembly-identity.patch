new file mode 100644
index 0000000..8a90a00
--- /dev/null
+++ b/src/CallAtlas.Core/FlowSynthetic.cs
@@ -0,0 +1,56 @@
+using Microsoft.CodeAnalysis;
+
+namespace CallAtlas.Core;
+
+internal enum ImplicitFlowOperation { GetEnumerator, MoveNext, Current, Dispose, MonitorEnter, MonitorExit }
+
+internal sealed partial class FlowBody
+{
+    private FlowExpression SyntheticValue(SyntaxNode owner, string label)
+    {
+        Budget(0);
+        return new("value", source.Span(owner)) { Text = "synthetic C#: " + label, Calls = [] };
+    }
+
+    private FlowExpression ImplicitCall(SyntaxNode owner, ImplicitFlowOperation operation, string subject)
+    {
+        var label = operation switch
+        {
+            ImplicitFlowOperation.Dispose => "Dispose captured " + subject,
+            ImplicitFlowOperation.MonitorEnter => "Monitor.Enter(ref lockTaken)",
+            ImplicitFlowOperation.MonitorExit => "Monitor.Exit captured lock object",
+            _ => operation + " captured " + subject,
+        };
+        var value = SyntheticValue(owner, label);
+        return value with { Calls = [new(value.Span, value.Text!, [],
+            $"roslyn:implicit:{operation}; compiler-selected operation, not a native graph edge")] };
+    }
+
+    private FlowStatement EvaluateSynthetic(SyntaxNode owner, FlowExpression value)
+    {
+        Budget(0);
+        return new("evaluate", source.Span(owner)) { Value = value };
+    }
+
+    private FlowStatement Protected(SyntaxNode owner, IReadOnlyList<FlowStatement> body)
+    {
+        Budget(0);
+        return new("try", source.Span(owner)) { Resources = [], Body = body, Catches = [], Finally = [], Cleanup = [] };
+    }
+
+    private FlowStatement OpaqueCompletion(SyntaxNode owner, string reason)
+    {
+        for (var count = 0; count < 5; count++) Budget(0); // Block, choice, condition, throw and thrown value.
+        var outcome = new FlowExpression("value", new(0, 0))
+        { Text = "synthetic C#: opaque completion outcome is exceptional", Calls = [] };
+        return new("block", source.Span(owner))
+        {
+            Body = [Opaque(owner, reason), new("if", new(0, 0))
+            {
+                Condition = outcome, ElseBranch = [],
+                ThenBranch = [new("throw", new(0, 0))
+                { Value = new("value", new(0, 0)) { Text = "synthetic C#: opaque exception propagates", Calls = [] } }],
+            }],
+        };
+    }
+}
