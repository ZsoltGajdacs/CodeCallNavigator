--- /dev/null
+++ b/src/CallAtlas.Core/FlowExecution.cs
@@ -0,0 +1,33 @@
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp.Syntax;
+
+namespace CallAtlas.Core;
+
+/// <summary>Compiler-owned whole-body execution, independent of return-type names or call-site timing.</summary>
+internal static class FlowExecution
+{
+    internal static FlowExecutionTiming Classify(FlowInput input, IReadOnlyList<SyntaxNode> bodies)
+    {
+        var declaration = input.Declaration ?? TopLevelOwner(input, bodies);
+        if (!OrdinaryOwner(declaration, input.Declaration is null)) return FlowExecutionTiming.Unknown;
+        return BodyTiming(bodies);
+    }
+
+    private static FlowExecutionTiming BodyTiming(IReadOnlyList<SyntaxNode> bodies)
+    {
+        if (bodies.Any(FlowSuspension.HasYield)) return FlowExecutionTiming.Deferred;
+        return bodies.Any(FlowSuspension.IsAsyncOrIterator) ? FlowExecutionTiming.Unknown : FlowExecutionTiming.Synchronous;
+    }
+
+    private static bool OrdinaryOwner(IMethodSymbol? declaration, bool topLevel) => declaration is
+        { IsAsync: false, MethodKind: MethodKind.Ordinary or MethodKind.LocalFunction }
+        && (topLevel || !declaration.IsImplicitlyDeclared);
+
+    private static IMethodSymbol? TopLevelOwner(FlowInput input, IReadOnlyList<SyntaxNode> bodies)
+    {
+        if (!bodies.All(body => body.Parent is GlobalStatementSyntax)) return null;
+        var entry = input.Model.Compilation.GetEntryPoint(default);
+        return entry is not null && bodies.All(body => SymbolEqualityComparer.Default.Equals(
+            input.Model.GetEnclosingSymbol(body.SpanStart), entry)) ? entry : null;
+    }
+}
