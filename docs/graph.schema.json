            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "text": {
              "type": "string"
            },
            "calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/callSite"
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              }
            }
          },
          "additionalProperties": true,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "and"
            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": true,
          "required": [
            "kind",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "or"
            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": true,
          "required": [
            "kind",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "conditional"
            },
            "span": {
              "$ref": "#/$defs/span"
            },
            "condition": {
              "$ref": "#/$defs/expression"
            },
            "when_true": {
              "$ref": "#/$defs/expression"
            },
            "when_false": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": true,
          "required": [
            "kind",
            "condition",
            "when_true",
            "when_false"
          ]
        }
      ]
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "identity_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "folder_project_builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "boundaries": {
          "anyOf": [
            {
              "$ref": "#/$defs/boundaries"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_points": {
          "anyOf": [
            {
              "$ref": "#/$defs/entries"
            },
            {
              "type": "null"
            }
          ]
        },
        "flow_inventory": {
          "anyOf": [
            {
              "$ref": "#/$defs/flow"
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/architecture"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/analysis"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "nodes",
        "edges",
        "diagnostics",
        "roots"
      ]
    },
    "analysisInput": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "missing"
          ]
        },
        "hash": {
          "type": "string"
        },
        "excluded_children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "path",
        "kind",
        "hash"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "hash": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "hash": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "analysisLimitation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "code",
        "count"
      ],
      "additionalProperties": true
    },
    "analysisSelection": {
      "description": "Optional exact build selection. Version 1 paths are portable; complete must be true for automatic refresh. Future payloads remain opaque to basic graph consumers.",
      "if": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": ["version"]
      },
      "then": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          },
          "complete": {
            "type": "boolean",
            "default": false
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "#/$defs/path"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "language": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["path", "kind", "language"],
              "additionalProperties": true
            }
          }
        },
        "required": ["version", "targets"],
        "additionalProperties": true
      }
    },
    "analysisRefreshInputs": {
      "description": "Optional compiler-output ownership for automatic scheduling. Automation requires complete ownership and binding_policy direct.v1. Full freshness still verifies every analysis input. Future payloads remain opaque.",
      "if": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": ["version"]
      },
      "then": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          },
          "complete": {
            "type": "boolean"
          },
          "binding_policy": {
            "type": "string",
            "minLength": 1
          },
          "owned_bytecode_directories": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "directories": {
            "type": "array",
            "items": {
              "allOf": [
                {"$ref": "#/$defs/analysisInput"},
                {"properties": {"kind": {"const": "directory"}}}
              ]
            }
          }
        },
        "required": ["version", "complete", "owned_bytecode_directories", "directories"],
        "additionalProperties": true
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "selection": {
          "$ref": "#/$defs/analysisSelection"
        },
        "refresh_inputs": {
          "$ref": "#/$defs/analysisRefreshInputs"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "engine_versions": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisInput"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisLimitation"
          }
        }
      },
      "required": [
        "version",
        "targets",
        "roots",
        "engine_versions",
        "inputs",
        "limitations"
      ],
      "additionalProperties": true
    }
  }
}
