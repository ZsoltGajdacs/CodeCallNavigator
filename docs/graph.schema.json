{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeCallNavigator portable graph v1",
  "description": "Wire shape only. CodeCallNavigator semantic validation additionally checks identity uniqueness, references, spans and portable paths.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "codecallnavigator.graph.v1"
    },
    "graph": {
      "$ref": "#/$defs/graph"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema",
    "graph"
  ],
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?:|@[A-Za-z0-9_-]+/(?!/)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).*)$",
      "description": "Logical root path, or empty when unavailable. Filesystem/path safety is also checked semantically."
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identity. Never parse it or use array positions as identity."
    },
    "span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "start",
        "end"
      ]
    },
    "site": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "file",
        "line"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private",
        "protected",
        "package",
        "internal",
        "protected_internal",
        "private_protected"
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/symbol"
        },
        "build": {
          "$ref": "#/$defs/path"
